@page "/users"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Developer")]
@using Microsoft.AspNetCore.Authorization
@using Tharga.Team.Sample.Framework.Team
@inject AppUserAdminService UserAdmin
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject NavigationManager Navigation

<PageTitle>Users</PageTitle>

@* ShowAuditLogButton is on because the sample configures MongoDB audit storage; without it the log
   would be empty and the button misleading. *@
@*
    "Edit email" rather than "Edit": the built-in Rename item already edits the root name, and offering
    both made two menu entries that half-overlapped. This keeps the ActionItems hook demonstrated while
    covering the one field the toolkit has no built-in editor for.
*@
<UsersView TMember="TeamMember" ActionInvoked="OnUserActionAsync" ShowAuditLogButton="true">
    <ActionItems>
        <RadzenSplitButtonItem Text="Edit email" Value="@EditAction" Icon="alternate_email" />
        <RadzenSplitButtonItem Text="Mail sent" Value="@MailAction" Icon="outgoing_mail" />
    </ActionItems>
</UsersView>

@code {
    private const string EditAction = "edit-email";
    private const string MailAction = "mail-sent";

    private async Task OnUserActionAsync(UserRowAction action)
    {
        if (action.Action == EditAction) await EditUser(action.User);
        if (action.Action == MailAction) await ShowMailAsync(action.User);
    }

    private Task ShowMailAsync(UserViewModel u)
        => DialogService.OpenAsync(u.Name, _ => @<UserMailHistoryView UserKey="@u.Key" />, new DialogOptions { Width = "640px", Resizable = true });

    private async Task EditUser(UserViewModel u)
    {
        var name = u.StoredName;
        var email = u.EMail ?? "";

        var result = await DialogService.OpenAsync("Edit email", ds =>
            @<RadzenStack Gap="0.75rem">
                <RadzenStack Gap="0.25rem">
                    <RadzenLabel Text="Email" />
                    <RadzenTextBox Value="@email" ValueChanged="@(v => email = v)" Style="width: 100%;" />
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton Text="Save" ButtonStyle="ButtonStyle.Primary" Click="@(_ => ds.Close(true))" />
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(_ => ds.Close(false))" />
                </RadzenStack>
            </RadzenStack>,
            new DialogOptions { Width = "420px" });

        if (result is not true) return;

        // StoredName, not Name — passing the resolved display fallback would silently promote it into a
        // real stored name, which is exactly what UserViewModel.StoredName exists to prevent.
        await UserAdmin.UpdateAsync(u.Key, name, email);
        NotificationService.Notify(NotificationSeverity.Success, "Email updated");
        Navigation.Refresh();
    }
}
