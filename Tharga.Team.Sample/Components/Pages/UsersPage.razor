@page "/users"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Developer")]
@using Microsoft.AspNetCore.Authorization
@using Tharga.Team.Sample.Framework.Team
@inject DialogService DialogService

<PageTitle>Users</PageTitle>

@* ShowAuditLogButton is on because the sample configures MongoDB audit storage; without it the log
   would be empty and the button misleading. *@
@*
    "Mail sent" demonstrates the ActionItems hook with something the toolkit has no menu item for. The
    sample used to add "Edit email" here too; the built-in "Change email" replaced it.
*@
<UsersView TMember="TeamMember" ActionInvoked="OnUserActionAsync" ShowAuditLogButton="true">
    <ActionItems>
        <RadzenSplitButtonItem Text="Mail sent" Value="@MailAction" Icon="outgoing_mail" />
    </ActionItems>
</UsersView>

@code {
    private const string MailAction = "mail-sent";

    private async Task OnUserActionAsync(UserRowAction action)
    {
        if (action.Action == MailAction) await ShowMailAsync(action.User);
    }

    private Task ShowMailAsync(UserViewModel u)
        => DialogService.OpenAsync(u.Name, _ => @<UserMailHistoryView UserKey="@u.Key" />, new DialogOptions { Width = "640px", Resizable = true });
}
