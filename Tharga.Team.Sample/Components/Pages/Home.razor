@page "/"
@using Tharga.Team.Sample.Components.Layout

<PageTitle>Home</PageTitle>

<RadzenStack Gap="1rem">
    <RadzenStack Gap="0.25rem">
        <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Tharga Team sample</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1" class="rz-m-0">
            Each card is one area of the toolkit, with the pages that show it. The menu on the left has the same sections.
        </RadzenText>
    </RadzenStack>

    @* Every area is shown, the Developer ones too, because this page is the map of what exists: a page the reader
       cannot open says so when opened, which teaches more than its being missing. *@
    <RadzenRow Gap="1rem">
        @foreach (var group in SampleNavigation.Groups)
        {
            <RadzenColumn Size="12" SizeMD="6" SizeXL="4">
                <RadzenCard Style="height: 100%;">
                    <RadzenStack Gap="0.75rem">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenIcon Icon="@group.Icon" IconStyle="IconStyle.Primary" />
                            <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">@group.Text</RadzenText>
                            @if (group.Audience == SampleAudience.Developer)
                            {
                                <RadzenBadge Text="Developer role" BadgeStyle="BadgeStyle.Secondary" Variant="Variant.Flat" />
                            }
                        </RadzenStack>
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0" Style="color: var(--rz-text-secondary-color);">@group.Description</RadzenText>

                        <RadzenStack Gap="0.5rem">
                            @foreach (var item in group.Items)
                            {
                                <RadzenStack Gap="0">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                        <RadzenLink Path="@item.Path" Icon="@item.Icon" Text="@item.Text" />
                                        @if (item.RequiresTeam)
                                        {
                                            <RadzenBadge Text="Needs a team" BadgeStyle="BadgeStyle.Info" Variant="Variant.Outlined" />
                                        }
                                    </RadzenStack>
                                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">@item.Description</RadzenText>
                                </RadzenStack>
                            }
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        }
    </RadzenRow>
</RadzenStack>
