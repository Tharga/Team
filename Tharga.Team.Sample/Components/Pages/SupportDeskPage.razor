@page "/support-desk"
@attribute [Authorize(Roles = Tharga.Team.Blazor.Framework.Roles.Developer)]
@using Microsoft.AspNetCore.Authorization
@using Tharga.Team.Blazor.Features.Support

<PageTitle>Support desk</PageTitle>

@* The back office of support, for the people who run it: every team's cases and the ones with no team, answered in
   place. Paired with the side panel it is both ends of one conversation -- a member writes in the panel, support
   answers here, and each side reads as a chat. The Developer role holds the system grants it needs
   (support:all:manage, support:unassigned:read and :manage), mapped in Program.cs. *@

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
    <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">
        Open this page in a second window and write in the side panel's Support tab as a member: the conversation
        appears here, and what you answer here appears in the panel. A conversation the assistant is answering
        reaches the desk once the member asks for a person.
    </RadzenText>

    @* What members see in the panel: "Support is online" while you are Online and active here, "Support will reply
       later" while you are Away or idle, and nothing while you are Hidden. A member nobody answers within a minute is
       told we will get back to them. *@
    <RadzenCard>
        <SupportDeskStatus />
    </RadzenCard>

    <RadzenCard>
        <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-3">Every team</RadzenText>
        <SupportAcrossTeamsView CaseId="@CaseId" CaseExtras="HostSlot" />
    </RadzenCard>

    <RadzenCard>
        <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-3">Without a team</RadzenText>
        <SupportUnassignedView CaseId="@CaseId" CaseExtras="HostSlot" />
    </RadzenCard>

    @* The two components a host places outside the boards, for instance on a sales prospect's card: the form that
       starts a case by mail, prefilled and handing the new case back, and the conversation of a case by its id. *@
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-3">Write first, and show a case by its id</RadzenText>
        <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
            <SupportComposeMail To="prospect@acme.example" ToName="A Prospect" Subject="Our offer" Started="OnStarted" />

            @if (_startedId != null)
            {
                <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">Started case <code>@_startedId</code>; its conversation:</RadzenText>
            }

            <RadzenTextBox @bind-Value="_caseId" Placeholder="A case id" Style="max-width: 32rem;" />
            @if (!string.IsNullOrWhiteSpace(_caseId))
            {
                <SupportCaseById CaseId="@_caseId" />
            }
        </RadzenStack>
    </RadzenCard>

    @* What members asked the assistant for that it had no tool to do, and how they rated its answers: the list to
       build the next tools from. *@
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-3">How the assistant is doing</RadzenText>
        <SupportAssistantFeedbackView />
    </RadzenCard>

    @* How much the assistant was used, per team, provider and model: what a host lending its own AI account to teams
       would bill from. Needs support:usage:read, which the Developer role holds here. *@
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-3">What the assistant used</RadzenText>
        <SupportAssistantUsageView />
    </RadzenCard>
</RadzenStack>

@code {
    /// <summary>Opens that case on the boards: <c>/support-desk?case=ID</c>, as a host links to one from elsewhere in its app.</summary>
    [SupplyParameterFromQuery(Name = "case")] public string CaseId { get; set; }

    // The host's own content in each opened case, below the contact: where a real host links the message to its own record.
    private static RenderFragment HostSlotFor(SupportCase supportCase) => builder =>
    {
        builder.OpenElement(0, "small");
        builder.AddContent(1, $"Host slot: your own content for case {supportCase.Id} goes here.");
        builder.CloseElement();
    };

    private readonly RenderFragment<SupportCase> HostSlot = HostSlotFor;

    private string _caseId;
    private string _startedId;

    // What a host does with the new case: connect it to its own records. Here it only shows the conversation.
    private void OnStarted(SupportCase started)
    {
        _startedId = started.Id;
        _caseId = started.Id;
    }
}
