@page "/support"
@page "/support/{CaseId?}"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Tharga.Team.Blazor.Features.Support
@using Tharga.Team.Blazor.Framework
@using Tharga.Team.Support.Cases
@inject ITeamStateService TeamState
@inject AuthenticationStateProvider AuthState

<PageTitle>Support</PageTitle>

@* Both shipped components, side by side: the customer's view of their own cases and the back-office view of
   the team's. This page used to hand-roll all of it, which made it a second implementation to keep in step
   rather than a demonstration of the surface.

   The components are optional and always will be. A host wanting its own UI calls the same
   ISupportCaseService these do — and SupportComponentSurfaceTests asserts they reach for nothing a consumer
   could not. *@

<RadzenText TextStyle="TextStyle.Body2" class="rz-mb-3">
    Raise a case, read the conversation and reply. A case with no subject takes one from the first words of
    the message. Support answers from the back office below, and a case support answered closes itself after
    a week of silence — reopening it keeps the history.
</RadzenText>

<RadzenStack Orientation="Orientation.Vertical" Gap="2rem">

    <RadzenCard>
        <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-3">As a team member</RadzenText>

        @* ShowSubject mirrors SupportCaseOptions.UseSubject, which the sample leaves off. It is a parameter
           rather than a read of the options so one page can ask for a subject while another does not. *@
        @* CaseId comes from the route, so a link in a Slack notification opens the conversation it is
           about rather than the list. That is what Slack:CaseUrl points at. *@
        <SupportCasesView ShowSubject="false" CaseId="@CaseId" />
    </RadzenCard>

    @if (_canSeeQueue)
    {
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-3">As support</RadzenText>

            @* Rendered only for a caller holding support:read. The service refuses without it either way —
               this gate keeps a member from meeting a refusal they can do nothing about, which is what
               gating rendering is for. *@
            <SupportQueueView />
        </RadzenCard>
    }
    else
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter">
            The support queue needs <strong>support:read</strong> on the selected team. Grant it on the Scopes
            page to see the back-office view.
        </RadzenAlert>
    }

    @if (_canSeeUnassigned)
    {
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-3">Without a team</RadzenText>

            @* Mail arrives from senders whose team cannot be determined, so a case can belong to no team at
               all. Governed by a *system* scope rather than a team one: an unassigned case may concern any
               tenant or none, so support:read on one team must confer nothing here. *@
            <SupportUnassignedView />
        </RadzenCard>
    }
    else
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter">
            Cases that belong to no team need the system grant
            <strong>support:unassigned:read</strong>, and assigning one needs
            <strong>support:unassigned:manage</strong> plus <strong>teams:read</strong> to list the teams.
        </RadzenAlert>
    }
</RadzenStack>

@code {
    /// <summary>From the route, so /support/{caseId} deep-links to one case.</summary>
    [Parameter] public string CaseId { get; set; }

    private bool _canSeeQueue;
    private bool _canSeeUnassigned;

    protected override async Task OnInitializedAsync()
    {
        var teamKey = (await TeamState.GetSelectedTeamAsync())?.Key;
        var principal = (await AuthState.GetAuthenticationStateAsync()).User;

        _canSeeQueue = teamKey != null && TeamScopeGate.HasTeamScope(principal, SupportScopes.Read, teamKey);

        // No team in the check, because there is no team in the question. This is the whole reason the
        // unassigned queue needed its own scope: support:read is held against a team.
        _canSeeUnassigned = TeamScopeGate.HasSystemScope(principal, SystemSupportScopes.Read);
    }
}
