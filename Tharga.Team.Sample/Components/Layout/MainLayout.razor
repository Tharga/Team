@inherits LayoutComponentBase
@using Tharga.Team.Blazor.Features.Support
@inject CookieThemeService CookieThemeService

<CustomErrorBoundary>
    <RadzenComponents @rendermode="InteractiveAuto" />
</CustomErrorBoundary>

<HeadContent>
    <Title />
</HeadContent>

<RadzenLayout>
    <CustomErrorBoundary>
        <NavMenu/>
    </CustomErrorBoundary>
    <RadzenBody>
        <CustomErrorBoundary>
            @Body
        </CustomErrorBoundary>
    </RadzenBody>
    @* Help beside every page: the assistant where the team has one, and support. *@
    <AuthorizeView>
        <Authorized>
            <CustomErrorBoundary>
                <SupportPanel />
            </CustomErrorBoundary>
        </Authorized>
    </AuthorizeView>
    @* <RadzenFooter>
        Plutus Wave by Thargelion
    </RadzenFooter> *@
</RadzenLayout>