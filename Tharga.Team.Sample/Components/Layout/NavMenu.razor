@inject ITeamStateService TeamStateService
@implements IDisposable

<RadzenHeader>
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
            <RadzenSidebarToggle Click="@(() => _menuExpanded = !_menuExpanded)" />
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
                <BreadCrumbs ShowRoot="true" />
            </RadzenStack>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
            @* Both halves off, so this draws nothing: the access card on /account is the entry point *and*
               the way out. Kept rather than deleted so the two switches are visible — set either to true
               to get that half back in the top bar while testing.

               ShowBanner="false" is what keeps a demo clean; the warning banner spans every page and
               announces that access is reduced, which is the opposite of what a demonstration wants. The
               trade is real: nothing on screen now says the session is reduced, so the only way back is
               the profile page. That works here because /account carries [Authorize] and nothing more —
               a host gating it on a scope a simulation can remove would strand the caller. *@
            <AccessSimulationBar ShowEntryPoint="false" ShowBanner="false" />
            @* The quiet way to see that access is reduced, and to return, without the banner. Shows nothing during
               demo mode, so a demonstration stays clean; the profile page is then the way out. *@
            <AccessSimulationIndicator />
            @* Access requests waiting for this user's decision, and their own waiting requests. *@
            <TeamNotificationMenu />
            <TeamSelector />
            <LoginDisplay />
        </RadzenStack>
    </RadzenStack>
</RadzenHeader>

<RadzenSidebar Responsive="false" Style="width: max-content">
    @* One section per area, from SampleNavigation, which the dashboard reads too. The section holding the
       current page opens by itself; the others stay as the reader left them. *@
    <RadzenPanelMenu DisplayStyle="@(_menuExpanded ? MenuItemDisplayStyle.IconAndText : MenuItemDisplayStyle.Icon)" ShowArrow="true" Multiple="true">
        <RadzenPanelMenuItem Text="Home" Path="" Icon="home" />
        <CascadingAuthenticationState>

            <AuthorizeView>
                <Authorized>
                    @foreach (var group in SampleNavigation.Groups.Where(x => x.Audience == SampleAudience.SignedIn))
                    {
                        @Section(group)
                    }
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="@Tharga.Team.Blazor.Framework.Roles.Developer">
                <Authorized>
                    @foreach (var group in SampleNavigation.Groups.Where(x => x.Audience == SampleAudience.Developer))
                    {
                        @Section(group)
                    }
                </Authorized>
            </AuthorizeView>

        </CascadingAuthenticationState>
    </RadzenPanelMenu>
</RadzenSidebar>

@code {
    bool _menuExpanded = true;
    bool _hasTeam;
    readonly HashSet<string> _openSections = [];

    [Inject] private NavigationManager Navigation { get; set; }

    private RenderFragment Section(SampleNavigationGroup group) => @<RadzenPanelMenuItem Text="@group.Text" Icon="@group.Icon"
                                                                        Expanded="@_openSections.Contains(group.Text)"
                                                                        ExpandedChanged="@(open => SetOpen(group.Text, open))">
        @foreach (var item in group.Items.Where(x => _hasTeam || !x.RequiresTeam))
        {
            <RadzenPanelMenuItem Text="@item.Text" Path="@item.Path" Icon="@item.Icon" />
        }
    </RadzenPanelMenuItem>;

    private void SetOpen(string section, bool open)
    {
        if (open) _openSections.Add(section);
        else _openSections.Remove(section);
    }

    private void OpenCurrentSection()
    {
        var group = SampleNavigation.GroupOf(Navigation.ToBaseRelativePath(Navigation.Uri));
        if (group != null) _openSections.Add(group.Text);
    }

    private void OnLocationChanged(object sender, LocationChangedEventArgs e)
    {
        OpenCurrentSection();
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        OpenCurrentSection();
        Navigation.LocationChanged += OnLocationChanged;

        // The handler reads the team from the args -- GetSelectedTeamAsync resolves as well as reads, so
        // calling it from a handler asks for the work the handler is reacting to being done again.
        TeamStateService.SelectedTeamChangedEvent += async (_, e) =>
        {
            _hasTeam = e.SelectedTeam != null;
            await InvokeAsync(StateHasChanged);
        };

        await LoadAsync();
        await base.OnInitializedAsync();
    }

    private async Task LoadAsync()
    {
        var team = await TeamStateService.GetSelectedTeamAsync();
        _hasTeam = team != null;
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
