@inject ITeamStateService TeamStateService

<RadzenHeader>
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
            <RadzenSidebarToggle Click="@(() => _menuExpanded = !_menuExpanded)" />
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
                <BreadCrumbs ShowRoot="true" />
            </RadzenStack>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
            @* Both halves off, so this draws nothing: the access card on /account is the entry point *and*
               the way out. Kept rather than deleted so the two switches are visible — set either to true
               to get that half back in the top bar while testing.

               ShowBanner="false" is what keeps a demo clean; the warning banner spans every page and
               announces that access is reduced, which is the opposite of what a demonstration wants. The
               trade is real: nothing on screen now says the session is reduced, so the only way back is
               the profile page. That works here because /account carries [Authorize] and nothing more —
               a host gating it on a scope a simulation can remove would strand the caller. *@
            <AccessSimulationBar ShowEntryPoint="false" ShowBanner="false" />
            <TeamSelector />
            <LoginDisplay />
        </RadzenStack>
    </RadzenStack>
</RadzenHeader>

<RadzenSidebar Responsive="false" Style="width: max-content">
    <RadzenPanelMenu DisplayStyle="@(_menuExpanded ? MenuItemDisplayStyle.IconAndText : MenuItemDisplayStyle.Icon)" ShowArrow="true">
        <RadzenPanelMenuItem Text="Home" Path="" Icon="home" />
        <CascadingAuthenticationState>

            <AuthorizeView>
                <Authorized>
                    <RadzenPanelMenuItem Text="Profile" Path="account" Icon="person"/>
                    <RadzenPanelMenuItem Text="Team" Path="team" Icon="groups"/>
                    <RadzenPanelMenuItem Text="Scopes" Path="scopes" Icon="shield"/>
                    <RadzenPanelMenuItem Text="Support" Path="support" Icon="support_agent"/>
                    @* <RadzenPanelMenuItem Text="Invites" Path="invites" Icon="mail"/> *@
                    <RadzenPanelMenuItem Text="Custom roles" Path="roles" Icon="admin_panel_settings"/>
                    <RadzenPanelMenuItem Text="Access" Path="access" Icon="verified_user"/>
                    @if (_hasTeam)
                    {
                        <RadzenPanelMenuItem Text="Team audit" Path="team-audit" Icon="receipt_long"/>
                        <RadzenPanelMenuItem Text="API Keys" Path="api-keys" Icon="key"/>
                    }
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="@Tharga.Team.Blazor.Framework.Roles.Developer">
                <Authorized>
                    <RadzenPanelMenuItem Text="System audit" Path="audit" Icon="receipt_long"/>
                    <RadzenPanelMenuItem Text="System API Keys" Path="system-api-keys" Icon="vpn_key"/>
                    <RadzenPanelMenuItem Text="Users" Path="users" Icon="people" />
                    <RadzenPanelMenuItem Text="Icon settings" Path="icon-settings" Icon="image" />
                </Authorized>
            </AuthorizeView>

        </CascadingAuthenticationState>
    </RadzenPanelMenu>
</RadzenSidebar>

@code {
    bool _menuExpanded = true;
    bool _hasTeam;

    protected override async Task OnInitializedAsync()
    {
        // The handler reads the team from the args -- GetSelectedTeamAsync resolves as well as reads, so
        // calling it from a handler asks for the work the handler is reacting to being done again.
        TeamStateService.SelectedTeamChangedEvent += async (_, e) =>
        {
            _hasTeam = e.SelectedTeam != null;
            await InvokeAsync(StateHasChanged);
        };

        await LoadAsync();
        await base.OnInitializedAsync();
    }

    private async Task LoadAsync()
    {
        var team = await TeamStateService.GetSelectedTeamAsync();
        _hasTeam = team != null;
    }
}
