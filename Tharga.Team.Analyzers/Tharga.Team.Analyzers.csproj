<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- An analyzer is loaded by the compiler, which hosts it on netstandard2.0 whatever the consumer targets. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Not a package of its own: Tharga.Team packs the built dll under analyzers/dotnet/cs. -->
    <IsPackable>false</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <DevelopmentDependency>true</DevelopmentDependency>
    <!--
      RS1036: this is not a standalone analyzer package. RS2008: release tracking files are for analyzer packages
      that version their rules on their own; this one ships inside Tharga.Team and follows its release notes.
      RS1032: the message deliberately carries the advice sentence for the consumer after the statement.
    -->
    <NoWarn>$(NoWarn);RS1036;RS2008;RS1032</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- 4.8 is the oldest compiler the supported SDKs ship; a newer one would stop loading on them. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
