<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- An analyzer is loaded by the compiler, which hosts it on netstandard2.0 whatever the consumer targets. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Not a package of its own: Tharga.Team packs the built dll under analyzers/dotnet/cs. -->
    <IsPackable>false</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoWarn>$(NoWarn);RS1036</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- 4.8 is the oldest compiler the supported SDKs ship; a newer one would stop loading on them. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
