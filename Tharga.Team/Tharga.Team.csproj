<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>Daniel Bohlin</Authors>
    <Company>Thargelion AB</Company>
    <Product>Tharga Team</Product>
    <Description>Team features for Tharga Blazor.</Description>
    <PackageIconUrl>https://thargelion.net/assets/component-team.png</PackageIconUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <DebugType>portable</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSource>true</IncludeSource>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <PropertyGroup>
    <!--
      NU5048: PackageIconUrl is deprecated in favour of an embedded PackageIcon.
      Suppressed deliberately. Tharga packages reference their icon from
      https://thargelion.net/assets/ so all package icons are maintained in one
      place and can be updated without republishing a package.
    -->
    <NoWarn>1701;1702;CS1591;NU5048</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!--
      The analyzer that flags a component, controller or MCP provider injecting an internal-path service
      (Tharga/Team#398). It is referenced for build order only (ReferenceOutputAssembly is off, so this assembly
      does not load it), and its dll is packed under analyzers/dotnet/cs, which is where a consumer's compiler
      picks it up. It lives in this package because the contracts it keys on live here; it reaches every project
      that references the package, transitively.
    -->
    <ProjectReference Include="..\Tharga.Team.Analyzers\Tharga.Team.Analyzers.csproj" ReferenceOutputAssembly="false" />
    <None Include="..\Tharga.Team.Analyzers\bin\$(Configuration)\netstandard2.0\Tharga.Team.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <!--
      TeamGrantResolver is internal and lives here because this package gates team reads and has to
      reach it. Its existing callers sit above: the claims builder and access simulation in .Blazor,
      the team-context resolver in .Service.
    -->
    <InternalsVisibleTo Include="Tharga.Team.Service" />
    <InternalsVisibleTo Include="Tharga.Team.Blazor" />
    <InternalsVisibleTo Include="Tharga.Team.Service.Tests" />
    <InternalsVisibleTo Include="Tharga.Team.Blazor.Tests" />
    <InternalsVisibleTo Include="Tharga.Team.MongoDB.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageReference Include="Tharga.Toolkit" Version="1.17.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="9.0.18" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.15" />
  </ItemGroup>
</Project>