@namespace Tharga.Team.Blazor.Framework
@using Microsoft.Extensions.DependencyInjection
@using Tharga.Team
@using Tharga.Team.Blazor.Features.Scopes
@inject IThargaTextProvider TextProvider
@inject IServiceProvider ServiceProvider

@*
    Scope-override picker (option b): shows the grantable scopes; the ones inherited from the principal's
    access level and roles are pre-checked and disabled, so the operator sees the full effective set and can
    only toggle the additional override scopes. Persists only the non-inherited selections via OverridesChanged.

    AllScopes carries what may be *granted* here, which excludes grant-only scopes. Inherited scopes and
    existing overrides are added to the option list regardless, so a principal already holding a grant-only
    scope still renders truthfully -- inherited ones disabled, an existing override removable. Removal is
    de-escalation and stays allowed; it is adding one that this picker does not offer.
*@
<RadzenDropDown TValue="IEnumerable<string>"
                Multiple="true"
                AllowClear="true"
                AllowFiltering="true"
                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                Data="@_options"
                TextProperty="Name"
                ValueProperty="Name"
                DisabledProperty="Inherited"
                Value="@_value"
                ValueChanged="@OnValueChanged"
                Placeholder="@_text[ScopeOverrideEditorText.Placeholder]"
                Style="@Style">
    <Template>
        <span title="@(((ScopeOption)context).Description)">@(((ScopeOption)context).Name)</span>
        @if (((ScopeOption)context).Group is { } group)
        {
            <small class="rz-color-secondary"> · @group</small>
        }
    </Template>
</RadzenDropDown>

@code {
    /// <summary>
    /// The scope names that may be granted here. Excludes grant-only scopes, which are held solely through
    /// a code-registered role. Inherited scopes and existing overrides are shown even when absent from this
    /// list, so the effective set on screen stays truthful.
    /// </summary>
    [Parameter] public IReadOnlyCollection<string> AllScopes { get; set; } = Array.Empty<string>();

    /// <summary>Scopes the principal already gets from its access level and roles — shown checked + disabled.</summary>
    [Parameter] public IReadOnlyCollection<string> InheritedScopes { get; set; } = Array.Empty<string>();

    /// <summary>Current per-principal override scopes (the editable additions).</summary>
    [Parameter] public IReadOnlyCollection<string> Overrides { get; set; } = Array.Empty<string>();

    /// <summary>Optional scope-name → description map; shown as a tooltip on each option.</summary>
    [Parameter] public IReadOnlyDictionary<string, string> Descriptions { get; set; }

    /// <summary>Invoked with the non-inherited selection (the overrides to persist).</summary>
    [Parameter] public EventCallback<string[]> OverridesChanged { get; set; }

    [Parameter] public string Style { get; set; } = "min-width: 220px;";

    /// <summary>
    /// Scopes hidden for this team by <see cref="Tharga.Team.ITeamScopeVisibilityProvider"/>: not offered,
    /// and not shown as inherited or held. A hidden override the principal already has is kept when the
    /// picker saves, so hiding a scope never removes it.
    /// </summary>
    [Parameter] public IReadOnlySet<string> HiddenScopes { get; set; }

    private TextSet _text = TextSet.Empty;
    private List<ScopeOption> _options = new();
    private IEnumerable<string> _value = Array.Empty<string>();
    private IReadOnlyList<ScopeGroup> _groups = [];
    private IReadOnlyDictionary<string, string> _groupKeyOf = new Dictionary<string, string>();
    private Func<string, string> _groupHeading = key => key;

    protected override async Task OnInitializedAsync()
    {
        _text = await TextProvider.ResolveAsync(ScopeOverrideEditorText.All);
        var registry = ServiceProvider.GetService<IScopeRegistry>();
        _groups = registry?.Groups ?? [];
        _groupKeyOf = registry?.All.ToDictionary(s => s.Name, s => s.Group) ?? new Dictionary<string, string>();
        _groupHeading = await ScopeGroupHeadings.ResolveAsync(TextProvider, _groups);
        await base.OnInitializedAsync();
    }

    protected override void OnParametersSet()
    {
        var inherited = new HashSet<string>(InheritedScopes ?? Array.Empty<string>());
        _options = ScopeGrouping.OrderByGroup(ScopeVisibility.Options(AllScopes, inherited, Overrides, HiddenScopes), GroupKey, _groups)
            .Select(s => new ScopeOption(s, inherited.Contains(s), GetDescription(s), GroupKey(s) is { Length: > 0 } key ? _groupHeading(key) : null))
            .ToList();
        // Inherited scopes appear checked (and disabled); current overrides are also checked.
        _value = ScopeVisibility.Checked(inherited, Overrides, HiddenScopes);
    }

    private async Task OnValueChanged(IEnumerable<string> value)
    {
        var selected = (value ?? Enumerable.Empty<string>()).ToList();
        _value = selected;
        var overrides = ScopeVisibility.Persist(selected, InheritedScopes, Overrides, HiddenScopes);
        await OverridesChanged.InvokeAsync(overrides);
    }

    private string GroupKey(string scope) => _groupKeyOf.TryGetValue(scope, out var key) ? key : null;

    private string GetDescription(string scope)
        => Descriptions != null && Descriptions.TryGetValue(scope, out var d) ? d : null;

    public sealed record ScopeOption(string Name, bool Inherited, string Description, string Group = null);
}
