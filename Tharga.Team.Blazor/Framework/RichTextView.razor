@using Tharga.Team.Service.Html
@namespace Tharga.Team.Blazor.Framework

@* The one place in the library that renders HTML, only as the sanitizer returns it, in the theme's own colours. *@

<style>
    .tharga-rich-text { overflow-wrap: anywhere; color: inherit; }
    .tharga-rich-text > :first-child { margin-top: 0; }
    .tharga-rich-text > :last-child { margin-bottom: 0; }
    .tharga-rich-text p, .tharga-rich-text ul, .tharga-rich-text ol, .tharga-rich-text pre, .tharga-rich-text blockquote, .tharga-rich-text table { margin: 0 0 0.5rem 0; }
    .tharga-rich-text h1, .tharga-rich-text h2, .tharga-rich-text h3, .tharga-rich-text h4 { margin: 0.5rem 0 0.25rem 0; color: inherit; line-height: 1.3; }
    .tharga-rich-text h1 { font-size: 1.4em; }
    .tharga-rich-text h2 { font-size: 1.25em; }
    .tharga-rich-text h3 { font-size: 1.1em; }
    .tharga-rich-text h4 { font-size: 1em; }
    .tharga-rich-text ul, .tharga-rich-text ol { padding-left: 1.5rem; }
    .tharga-rich-text a { color: inherit; text-decoration: underline; }
    .tharga-rich-text blockquote { margin-left: 0; padding-left: 0.75rem; border-left: 3px solid currentColor; opacity: 0.8; }
    .tharga-rich-text pre, .tharga-rich-text code { font-family: monospace; white-space: pre-wrap; background: color-mix(in srgb, currentColor 10%, transparent); border-radius: 0.25rem; }
    .tharga-rich-text pre { padding: 0.5rem; }
    .tharga-rich-text table { border-collapse: collapse; }
    .tharga-rich-text th, .tharga-rich-text td { border: 1px solid color-mix(in srgb, currentColor 30%, transparent); padding: 0.25rem 0.5rem; text-align: left; vertical-align: top; }
    .tharga-rich-text img { max-width: 100%; height: auto; }
</style>
<div class="tharga-rich-text @Class" @attributes="AdditionalAttributes">@_markup</div>

@code {
    /// <summary>Further CSS classes for the element holding the content, such as a typography class.</summary>
    [Parameter] public string Class { get; set; }

    /// <summary>The HTML to show; it is sanitized here whatever its source, so a stored value is never shown as stored.</summary>
    [Parameter] public string Html { get; set; }

    /// <summary>Decides each <c>cid:</c> image, typically showing it from content the caller read; without it every image shows as its alt text.</summary>
    [Parameter] public Func<string, HtmlImage> Images { get; set; }

    /// <summary>Attributes passed through to the element holding the content.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object> AdditionalAttributes { get; set; }

    private MarkupString _markup;
    private string _renderedHtml;
    private Func<string, HtmlImage> _renderedImages;
    private bool _rendered;

    /// <remarks>Sanitized again only when the HTML or the images change, so a transcript re-rendering does not parse every entry each time.</remarks>
    protected override void OnParametersSet()
    {
        if (_rendered && ReferenceEquals(_renderedHtml, Html) && ReferenceEquals(_renderedImages, Images)) return;

        _renderedHtml = Html;
        _renderedImages = Images;
        _rendered = true;
        _markup = new MarkupString(SafeHtml.Sanitize(Html, Images ?? (_ => null)) ?? string.Empty);
    }
}
