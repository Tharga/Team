@using Tharga.Team.Service.Audit

@* Branch order is a tested decision, not markup convention — see AccessGuardState. This view had the
   same defect as ApiKeyView: _hasAccess defaults to false and is only assigned after an await, so
   testing it first rendered "Access denied." on the first frame of every open, including inside the
   per-row audit dialogs where it is the whole content. *@
@{
    var guard = AccessGuardState.Resolve(_auditLoggerMissing, _accessResolved, _hasAccess);
}
@if (guard == AccessGuard.NotConfigured)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat">
        @_text.Format(AuditLogViewText.NotConfigured, "AddThargaAuditLogging()")
    </RadzenAlert>
}
else if (guard == AccessGuard.Loading)
{
    <Loading />
}
else if (guard == AccessGuard.Denied)
{
    <RadzenText>@_text[AuditLogViewText.AccessDenied]</RadzenText>
}
else if (_mongoAvailable == null)
{
    <Loading />
}
else if (_mongoAvailable == false)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat">
        @_text[AuditLogViewText.MongoRequired]
    </RadzenAlert>
}
else
{
    <RadzenTabs Change="@OnTabChange">
        <Tabs>
            <RadzenTabsItem Text="@_text[AuditLogViewText.TabLog]">
                @* Pinned dimensions are hidden rather than announced: the host chose the scope and says so
                   in its own words, and a banner naming raw keys is noise on a page built for one team. *@
                @* Top-bar filters *@
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.End" class="rz-mb-4 rz-mt-2" Wrap="FlexWrap.Wrap">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="@_text[AuditLogViewText.Period]" />
                        <RadzenSelectBar @bind-Value="_datePeriod" TValue="string" Change="@OnFilterChanged" Size="ButtonSize.Small">
                            <Items>
                                <RadzenSelectBarItem Text="@_text[AuditLogViewText.PeriodToday]" Value="@AuditPeriod.Today" />
                                <RadzenSelectBarItem Text="@_text[AuditLogViewText.PeriodSevenDays]" Value="@AuditPeriod.SevenDays" />
                                <RadzenSelectBarItem Text="@_text[AuditLogViewText.PeriodThirtyDays]" Value="@AuditPeriod.ThirtyDays" />
                                <RadzenSelectBarItem Text="@_text[AuditLogViewText.PeriodNinetyDays]" Value="@AuditPeriod.NinetyDays" />
                                <RadzenSelectBarItem Text="@_text[AuditLogViewText.FilterAll]" Value="@AuditPeriod.All" />
                            </Items>
                        </RadzenSelectBar>
                    </RadzenStack>
                    @* One option is not a filter — the same rule as Source below. With the options now
                       drawn from inside the pinned scope, a dimension the pin already fixes collapses to
                       one value and hides itself: a system API key has no team, a team key has exactly
                       one, and neither is something the reader can act on. *@
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0" Visible="@(AuditFilterVisibility.ShouldShow(_teams.Count, PinnedFilter?.TeamKey != null))">
                        <RadzenLabel Text="@_text[AuditLogViewText.Team]" />
                        <RadzenDropDown @bind-Value="_filterTeams" TValue="IEnumerable<string>" Data="@_teams"
                                        TextProperty="@nameof(TeamInfo.Name)" ValueProperty="@nameof(TeamInfo.Key)"
                                        Multiple="true" AllowClear="true" AllowFiltering="true"
                                        Placeholder="@_text[AuditLogViewText.FilterAll]" Change="@(_ => OnFilterChanged())"
                                        Style="width: 200px;" />
                    </RadzenStack>
                    @* A single source tells the reader nothing they can act on — one option is not a filter. *@
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0" Visible="@(AuditFilterVisibility.ShouldShow(_sources.Count, false))">
                        <RadzenLabel Text="@_text[AuditLogViewText.Source]" />
                        <RadzenSelectBar @bind-Value="_filterSources" TValue="IEnumerable<string>" Multiple="true"
                                         Change="@OnFilterChanged" Size="ButtonSize.Small">
                            <Items>
                                @foreach (var s in _sources)
                                {
                                    <RadzenSelectBarItem Text="@s" Value="@s" />
                                }
                            </Items>
                        </RadzenSelectBar>
                    </RadzenStack>
                    @* Feature and Action are the required scope split on its colon — apikey:manage is
                       feature "apikey", action "manage". Labelled as such so the connection to the Scope
                       column is visible, and kept as two filters so "everything that changed anything"
                       (action: manage, across features) stays one click. *@
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0" Visible="@(AuditFilterVisibility.ShouldShow(_features.Count, PinnedFilter?.Feature != null))">
                        <RadzenLabel Text="@_text[AuditLogViewText.ScopeFeature]" />
                        <RadzenSelectBar @bind-Value="_filterFeatures" TValue="IEnumerable<string>" Multiple="true"
                                         Change="@OnFilterChanged" Size="ButtonSize.Small">
                            <Items>
                                @foreach (var f in _features)
                                {
                                    <RadzenSelectBarItem Text="@f" Value="@f" />
                                }
                            </Items>
                        </RadzenSelectBar>
                    </RadzenStack>
                    @* Action and Event carry many values and grow with the app, so they are drop-downs
                       rather than select bars — a bar of every action wraps to several rows and pushes
                       the grid off screen. *@
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0" Visible="@(AuditFilterVisibility.ShouldShow(_actions.Count, PinnedFilter?.Action != null))">
                        <RadzenLabel Text="@_text[AuditLogViewText.ScopeAction]" />
                        <RadzenDropDown @bind-Value="_filterActions" TValue="IEnumerable<string>" Data="@_actions"
                                        Multiple="true" AllowClear="true" AllowFiltering="true"
                                        Placeholder="@_text[AuditLogViewText.FilterAll]" Change="@(_ => OnFilterChanged())"
                                        Style="width: 200px;" />
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="@_text[AuditLogViewText.Event]" />
                        <RadzenDropDown @bind-Value="_filterEventTypes" TValue="IEnumerable<AuditEventType>" Data="@EventTypeOptions"
                                        Multiple="true" AllowClear="true"
                                        Placeholder="@_text[AuditLogViewText.FilterAll]" Change="@(_ => OnFilterChanged())"
                                        Style="width: 200px;" />
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenLabel Text="@_text[AuditLogViewText.Result]" />
                        <RadzenSelectBar @bind-Value="_filterSuccess" TValue="IEnumerable<bool>" Multiple="true"
                                         Change="@OnFilterChanged" Size="ButtonSize.Small">
                            <Items>
                                <RadzenSelectBarItem Text="@_text[AuditLogViewText.Success]" Value="@true" />
                                <RadzenSelectBarItem Text="@_text[AuditLogViewText.Failure]" Value="@false" />
                            </Items>
                        </RadzenSelectBar>
                    </RadzenStack>
                    <RadzenSplitButton Text="@_text[AuditLogViewText.Export]" Icon="download" Click="@(_ => ExportAsync("csv"))" Size="ButtonSize.Small">
                        <ChildContent>
                            <RadzenSplitButtonItem Text="@_text[AuditLogViewText.ExportCsv]" Value="csv" Icon="table_view" />
                            <RadzenSplitButtonItem Text="@_text[AuditLogViewText.ExportJson]" Value="json" Icon="data_object" />
                        </ChildContent>
                    </RadzenSplitButton>
                </RadzenStack>

                @* Data grid with server-side paging *@
                <RadzenDataGrid @ref="_grid" TItem="AuditEntry"
                                Data="@_entries" Count="@_totalCount"
                                LoadData="@OnLoadData"
                                AllowSorting="true" AllowPaging="true" AllowFiltering="true"
                                FilterMode="FilterMode.Simple" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                PageSize="@_pageSize" PageSizeOptions="@PageSizeOptionsValues"
                                ShowPagingSummary="true" PagingSummaryFormat="@_text[AuditLogViewText.PagingSummary]"
                                Style="max-height:600px">
                    <Columns>
                        <RadzenDataGridColumn Title="@_text[AuditLogViewText.ColumnTime]" Width="160px" Filterable="false" Sortable="true"
                                              Property="@nameof(AuditEntry.Timestamp)">
                            <Template><DateTimeView Date="context.Timestamp" /></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="@_text[AuditLogViewText.Team]" Width="120px"
                                              Filterable="false" Sortable="false"
                                              Visible="@(string.IsNullOrEmpty(TeamKey))">
                            <Template>@GetTeamName(context.TeamKey)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="@_text[AuditLogViewText.ColumnCaller]" Property="@nameof(AuditEntry.CallerIdentity)" Width="180px"
                                              Sortable="true">
                            <Template>
                                <span title="@context.CallerIdentity">@GetCallerDisplayName(context)</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="@_text[AuditLogViewText.Source]" Width="70px" Filterable="false" Sortable="false">
                            <Template>@context.CallerSource</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="@_text[AuditLogViewText.ColumnScope]" Property="@nameof(AuditEntry.ScopeChecked)" Width="140px"
                                              Filterable="false" Sortable="false" />
                        <RadzenDataGridColumn Title="@_text[AuditLogViewText.ColumnMethod]" Property="@nameof(AuditEntry.MethodName)" Width="140px"
                                              Sortable="true" />
                        <RadzenDataGridColumn Title="@_text[AuditLogViewText.ColumnDuration]" Property="@nameof(AuditEntry.DurationMs)" Width="80px"
                                              Filterable="false" Sortable="true" TextAlign="TextAlign.Right"
                                              HeaderCssClass="rz-text-align-end">
                            <Template>@(context.DurationMs) ms</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="@_text[AuditLogViewText.Event]" Width="110px" Filterable="false" Sortable="false">
                            <Template>@context.EventType</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="@_text[AuditLogViewText.Result]" Width="160px" Filterable="false" Sortable="false">
                            <Template>
                                @if (context.Success)
                                {
                                    <RadzenIcon Icon="check_circle" Style="color: green" />
                                }
                                else
                                {
                                    <span title="@BuildFailureDetail(context, _text)" style="display:inline-flex;align-items:center;gap:0.25rem;">
                                        <RadzenIcon Icon="error" Style="color: red" />
                                        <span style="color:#dc3545;font-size:0.8rem;white-space:nowrap;">@BuildFailureCode(context)</span>
                                    </span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                    <Template Context="entry">
                        @if (entry.Metadata is { Count: > 0 })
                        {
                            <RadzenTable Class="rz-m-2" Style="max-width:600px;">
                                <RadzenTableHeader>
                                    <RadzenTableHeaderRow>
                                        <RadzenTableHeaderCell>@_text[AuditLogViewText.DetailName]</RadzenTableHeaderCell>
                                        <RadzenTableHeaderCell>@_text[AuditLogViewText.DetailValue]</RadzenTableHeaderCell>
                                    </RadzenTableHeaderRow>
                                </RadzenTableHeader>
                                <RadzenTableBody>
                                    @foreach (var pair in entry.Metadata.OrderBy(x => x.Key, StringComparer.Ordinal))
                                    {
                                        <RadzenTableRow>
                                            <RadzenTableCell><code>@pair.Key</code></RadzenTableCell>
                                            <RadzenTableCell>@(string.IsNullOrEmpty(pair.Value) ? _text[AuditLogViewText.DetailEmpty] : pair.Value)</RadzenTableCell>
                                        </RadzenTableRow>
                                    }
                                </RadzenTableBody>
                            </RadzenTable>
                        }
                        else
                        {
                            <span class="rz-text-muted rz-m-2" style="display:inline-block;">@_text[AuditLogViewText.NoAdditionalDetails]</span>
                        }
                    </Template>
                </RadzenDataGrid>

                @* Sits with the count, so an unexpectedly short history reads as retention rather than as
                   nothing having happened. *@
                <RadzenText TextStyle="TextStyle.Caption" class="rz-mt-1">@_text.Format(AuditLogViewText.TotalEntries, _totalCount, RetentionText)</RadzenText>
            </RadzenTabsItem>

            <RadzenTabsItem Text="@_text[AuditLogViewText.TabUsage]">
                @if (_chartEntries.Any())
                {
                    <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" class="rz-mt-2">
                        <RadzenCard>
                            <RadzenText TextStyle="TextStyle.Subtitle1">@_text[AuditLogViewText.ChartCallsOverTime]</RadzenText>
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mb-2">
                                <RadzenRadioButtonList @bind-Value="_timeGrouping" TValue="string" Orientation="Orientation.Horizontal">
                                    <Items>
                                        <RadzenRadioButtonListItem Text="@_text[AuditLogViewText.GroupingHourly]" Value="@("hourly")" />
                                        <RadzenRadioButtonListItem Text="@_text[AuditLogViewText.GroupingDaily]" Value="@("daily")" />
                                    </Items>
                                </RadzenRadioButtonList>
                            </RadzenStack>
                            <RadzenChart Style="height:300px">
                                <RadzenLineSeries Data="@GetCallsOverTime()" CategoryProperty="Period" ValueProperty="Count" Title="@_text[AuditLogViewText.SeriesCalls]" />
                                <RadzenCategoryAxis><RadzenAxisTitle Text="@_text[AuditLogViewText.ColumnTime]" /></RadzenCategoryAxis>
                                <RadzenValueAxis><RadzenAxisTitle Text="@_text[AuditLogViewText.AxisCount]" /></RadzenValueAxis>
                            </RadzenChart>
                        </RadzenCard>

                        <RadzenCard>
                            <RadzenText TextStyle="TextStyle.Subtitle1">@_text[AuditLogViewText.ChartSuccessVsFailure]</RadzenText>
                            <RadzenChart Style="height:300px">
                                <RadzenPieSeries Data="@GetSuccessFailure()" CategoryProperty="Label" ValueProperty="Count" Title="@_text[AuditLogViewText.SeriesStatus]" />
                            </RadzenChart>
                        </RadzenCard>

                        <RadzenCard>
                            <RadzenText TextStyle="TextStyle.Subtitle1">@_text[AuditLogViewText.ChartByFeature]</RadzenText>
                            <RadzenChart Style="height:300px">
                                <RadzenBarSeries Data="@GetByFeature()" CategoryProperty="Label" ValueProperty="Count" Title="@_text[AuditLogViewText.SeriesCalls]" />
                                <RadzenCategoryAxis />
                                <RadzenValueAxis><RadzenAxisTitle Text="@_text[AuditLogViewText.AxisCount]" /></RadzenValueAxis>
                            </RadzenChart>
                        </RadzenCard>

                        <RadzenCard>
                            <RadzenText TextStyle="TextStyle.Subtitle1">@_text[AuditLogViewText.ChartTopCallers]</RadzenText>
                            <RadzenChart Style="height:300px">
                                <RadzenBarSeries Data="@GetTopCallers()" CategoryProperty="Label" ValueProperty="Count" Title="@_text[AuditLogViewText.SeriesCalls]" />
                                <RadzenCategoryAxis />
                                <RadzenValueAxis><RadzenAxisTitle Text="@_text[AuditLogViewText.AxisCount]" /></RadzenValueAxis>
                            </RadzenChart>
                        </RadzenCard>
                    </RadzenStack>
                }
                else
                {
                    <RadzenText class="rz-mt-2">@_text[AuditLogViewText.NoDataForFilters]</RadzenText>
                }
            </RadzenTabsItem>

            <RadzenTabsItem Text="@_text[AuditLogViewText.TabPerformance]">
                @if (_chartEntries.Any())
                {
                    <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" class="rz-mt-2">
                        <RadzenCard>
                            <RadzenText TextStyle="TextStyle.Subtitle1">@_text[AuditLogViewText.ChartAverageResponseTime]</RadzenText>
                            <RadzenChart Style="height:300px">
                                <RadzenLineSeries Data="@GetResponseTimeOverTime()" CategoryProperty="Period" ValueProperty="Value" Title="@_text[AuditLogViewText.SeriesAverageMs]" />
                                <RadzenCategoryAxis />
                                <RadzenValueAxis><RadzenAxisTitle Text="ms" /></RadzenValueAxis>
                            </RadzenChart>
                        </RadzenCard>

                        <RadzenCard>
                            <RadzenText TextStyle="TextStyle.Subtitle1">@_text[AuditLogViewText.ChartResponseTimeByFeature]</RadzenText>
                            <RadzenChart Style="height:300px">
                                <RadzenBarSeries Data="@GetResponseTimeByFeature()" CategoryProperty="Period" ValueProperty="Value" Title="@_text[AuditLogViewText.SeriesAverageMs]" />
                                <RadzenCategoryAxis />
                                <RadzenValueAxis><RadzenAxisTitle Text="ms" /></RadzenValueAxis>
                            </RadzenChart>
                        </RadzenCard>

                        <RadzenCard>
                            <RadzenText TextStyle="TextStyle.Subtitle1">@_text[AuditLogViewText.ChartSlowestOperations]</RadzenText>
                            <RadzenDataGrid Data="@GetSlowest()" TItem="AuditEntry" AllowSorting="false" PageSize="10" Style="max-height:400px">
                                <Columns>
                                    <RadzenDataGridColumn Title="@_text[AuditLogViewText.ColumnTime]" Width="160px">
                                        <Template><DateTimeView Date="context.Timestamp" /></Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn Title="@_text[AuditLogViewText.ColumnFeature]" Property="@nameof(AuditEntry.Feature)" Width="100px" />
                                    <RadzenDataGridColumn Title="@_text[AuditLogViewText.ColumnAction]" Property="@nameof(AuditEntry.Action)" Width="80px" />
                                    <RadzenDataGridColumn Title="@_text[AuditLogViewText.ColumnMethod]" Property="@nameof(AuditEntry.MethodName)" Width="120px" />
                                    <RadzenDataGridColumn Title="@_text[AuditLogViewText.ColumnDurationMs]" Property="@nameof(AuditEntry.DurationMs)" Width="100px" TextAlign="TextAlign.End" />
                                    <RadzenDataGridColumn Title="@_text[AuditLogViewText.ColumnCaller]" Width="160px">
                                        <Template>
                                            <span title="@context.CallerIdentity">@GetCallerDisplayName(context)</span>
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                        </RadzenCard>
                    </RadzenStack>
                }
                else
                {
                    <RadzenText class="rz-mt-2">@_text[AuditLogViewText.NoDataForFilters]</RadzenText>
                }
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
}
