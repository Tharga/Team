@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@using Microsoft.JSInterop
@using Tharga.Team
@using Tharga.Team.Blazor.Framework
@inject IOptions<ApiKeyOptions> ApiKeyOptionsAccessor
@inject IServiceProvider ServiceProvider
@inject IJSRuntime Js
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject ContextMenuService ContextMenuService
@inject IThargaTextProvider TextProvider

<AuthorizeView Roles="@Roles.Developer" Context="authState">
    <Authorized>
        @if (_apiKeyServiceMissing)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat">
                @_text.Format(ApiKeyViewText.NotConfigured, nameof(ISystemApiKeyManagementService))
            </RadzenAlert>
        }
        else if (_keys == null)
        {
            <Loading />
        }
        else
        {
            <RadzenDataGrid Data="@_keys" TItem="SystemApiKeyModel"
                            AllowSorting="@AllowGridSorting"
                            AllowFiltering="@AllowGridFiltering"
                            FilterMode="FilterMode.Simple"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
                <Columns>
                    <RadzenDataGridColumn Title="@_text[ApiKeyViewText.Name]" Property="@nameof(SystemApiKeyModel.Name)" Width="180px" SortOrder="SortOrder.Ascending">
                        <Template>
                            @context.Name
                            @if (context.IsPrivate)
                            {
                                <RadzenBadge Text="@_text[ApiKeyViewText.Personal]" BadgeStyle="BadgeStyle.Info" class="rz-ml-2"
                                             title="@_text[ApiKeyViewText.PersonalBadgeHelp]" />
                            }
                            @* A badge, not the red text used for expiry — disabled is a decision somebody
                               made and can undo, expiry is a date passing. *@
                            @if (context.IsDisabled)
                            {
                                <RadzenBadge Text="@_text[ApiKeyViewText.Disabled]" BadgeStyle="BadgeStyle.Danger" class="rz-ml-2"
                                             title="@GetDisabledText(context)" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Title="@_text[ApiKeyViewText.Key]" Property="@nameof(SystemApiKeyModel.VisibleKey)" Sortable="false" Filterable="false" />
                    <RadzenDataGridColumn Title="@_text[ApiKeyViewText.Scopes]" Width="80px" Visible="@ShowScopeTooltip">
                        <Template>
                            <span title="@GetKeyScopesText(context)">
                                <RadzenIcon Icon="info" Style="cursor: help;" />
                            </span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Title="@_text[ApiKeyViewText.LastUsed]" Width="150px" Visible="@ShowLastUsed" SortProperty="@nameof(SystemApiKeyModel.LastUsedAt)" Filterable="false">
                        <Template>
                            <span title="@GetKeyDatesText(context)">
                                @if (context.LastUsedAt.HasValue)
                                {
                                    <DateTimeView Date="@context.LastUsedAt" />
                                }
                                else
                                {
                                    <RadzenText>@_text[ApiKeyViewText.Never]</RadzenText>
                                }
                            </span>
                            @if (IsExpiringSoon(context))
                            {
                                <RadzenIcon Icon="warning" Style="color: var(--rz-warning); margin-left: .25rem; cursor: help;"
                                            title="@_text.Format(ApiKeyViewText.ExpiresSoon, context.ExpiryDate?.ToString("yyyy-MM-dd"))" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Width="56px" TextAlign="TextAlign.Right">
                        <Template>
                            <RadzenButton Icon="more_vert" Variant="Variant.Flat" ButtonStyle="ButtonStyle.Base"
                                          Click="@(args => OpenRowMenu(args, context))" title="@_text[ApiKeyViewText.Actions]" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>

            <RadzenCard class="rz-mt-4">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="1rem" Wrap="FlexWrap.Wrap">
                    <RadzenStack Gap="0.25rem">
                        <RadzenLabel Text="@_text[ApiKeyViewText.Name]" />
                        <RadzenTextBox Value="@_newName" @oninput="@(e => _newName = e.Value?.ToString() ?? "")" Placeholder="@_text[ApiKeyViewText.KeyNamePlaceholder]" />
                    </RadzenStack>
                    @if (ShowScopeOverrides)
                    {
                        <RadzenStack Gap="0.25rem" Style="min-width: 260px">
                            <RadzenLabel Text="@_text[ApiKeyViewText.Scopes]" />
                            <RadzenDropDown TValue="IEnumerable<string>"
                                            @bind-Value="_newScopes"
                                            Data="@_allScopes"
                                            Multiple="true"
                                            AllowClear="true"
                                            AllowFiltering="true"
                                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            Placeholder="@_text[SystemApiKeyViewText.SelectScopes]">
                                <Template>
                                    <span title="@(_scopeDescriptions.TryGetValue((string)context, out var d) ? d : null)">@context</span>
                                </Template>
                            </RadzenDropDown>
                        </RadzenStack>
                    }
                    @if (ShowExpiryDatePicker)
                    {
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="@_text[ApiKeyViewText.ExpiryDate]" />
                            <RadzenDatePicker @bind-Value="_newExpiryDate" DateFormat="yyyy-MM-dd"
                                              AllowClear="true"
                                              Min="@DateTime.UtcNow.Date" />
                        </RadzenStack>
                    }
                    @if (ShowPersonalCheckbox)
                    {
                        @* No heading above it, as on the team view: the checkbox's own label says everything. *@
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"
                                     Style="height: var(--rz-input-height, 2.5rem);" title="@_text[ApiKeyViewText.PersonalHelp]">
                            <RadzenCheckBox TValue="bool" @bind-Value="_newPersonal" Name="newPersonalSystemKey" />
                            <RadzenLabel Text="@_text[ApiKeyViewText.Personal]" Component="newPersonalSystemKey" />
                        </RadzenStack>
                    }
                    <RadzenButton Text="@_text[ApiKeyViewText.Create]" Icon="add" Click="@CreateAsync"
                                  Disabled="@string.IsNullOrWhiteSpace(_newName)" />
                </RadzenStack>
            </RadzenCard>
        }
    </Authorized>
    <NotAuthorized>
        <RadzenText>@_text[SystemApiKeyViewText.AccessDenied]</RadzenText>
    </NotAuthorized>
</AuthorizeView>

@code {
    /// <summary>
    /// When true, each row gets a "View audit log" button that opens a dialog scoped to that key
    /// (CallerKeyId pinned). Default false — opt in on Developer pages where the audit log is configured.
    /// </summary>
    [Parameter] public bool ShowAuditLogButton { get; set; }

    /// <summary>When true, shows the per-key scope (i) tooltip (lists the key's <c>SystemScopes</c>). Default true.</summary>
    [Parameter] public bool ShowScopeTooltip { get; set; } = true;

    /// <summary>When true, the create card offers a scope picker. Set false to create scopeless system keys. Default true.</summary>
    [Parameter] public bool ShowScopeOverrides { get; set; } = true;

    /// <summary>Shows the "Last used" column (tooltip lists Created + Expiry + Created By; a warning icon appears within 60 days of expiry). Default true.</summary>
    [Parameter] public bool ShowLastUsed { get; set; } = true;

    /// <summary>Enables column sorting on the grid (Name + Last used), defaulting to Name ascending. Default true.</summary>
    [Parameter] public bool AllowGridSorting { get; set; } = true;

    /// <summary>Enables the simple, case-insensitive text filter on the Name column. Adds filter controls to the header, so it's opt-in. Default false.</summary>
    [Parameter] public bool AllowGridFiltering { get; set; }

    /// <summary>Shows the expiry-date picker on the create card. When hidden, new keys use the default expiry (capped by <c>ApiKeyOptions.MaxExpiryDays</c>). Default false.</summary>
    [Parameter] public bool ShowExpiryDatePicker { get; set; }

    /// <summary>
    /// Which personal system keys to include alongside shared ones. <c>Mine</c> (default) shows the caller's
    /// own; <c>All</c> also shows everyone else's to a caller holding the <c>apikeys:oversee</c> system scope;
    /// <c>None</c> shows none. Any value but <c>None</c> also puts a Personal checkbox on the create card, when
    /// <see cref="ApiKeyOptions.SystemKeys"/> allows both kinds. The same parameter as on <c>ApiKeyView</c>.
    /// </summary>
    [Parameter] public PrivateKeyScope ShowPrivateKeys { get; set; } = PrivateKeyScope.Mine;

    private string GetKeyScopesText(SystemApiKeyModel context)
        => string.Join("\n", (context.SystemScopes ?? Array.Empty<string>()).OrderBy(s => s, StringComparer.Ordinal));

    private string GetKeyDatesText(SystemApiKeyModel context)
    {
        var created = context.CreatedAt.HasValue ? context.CreatedAt.Value.ToString("yyyy-MM-dd") : "—";
        var expires = context.ExpiryDate.HasValue ? context.ExpiryDate.Value.ToString("yyyy-MM-dd") : _text[ApiKeyViewText.NoExpiry];
        var by = string.IsNullOrWhiteSpace(context.CreatedBy) ? _text[ApiKeyViewText.CreatedBySystem] : context.CreatedBy;
        return _text.Format(ApiKeyViewText.Dates, created, expires, by);
    }

    private static bool IsExpiringSoon(SystemApiKeyModel context)
        => context.ExpiryDate.HasValue && context.ExpiryDate.Value <= DateTime.UtcNow.AddDays(60);

    private TextSet _text = TextSet.Empty;
    private bool _apiKeyServiceMissing;
    private ISystemApiKeyManagementService _apiKeyManagementService;
    private ISystemScopeRegistry _systemScopeRegistry;
    private SystemApiKeyModel[] _keys;
    private string[] _allScopes = [];
    private IReadOnlyDictionary<string, string> _scopeDescriptions = new Dictionary<string, string>();
    private readonly string _apiKeyMask = "**********";

    private string _newName = "";
    private IEnumerable<string> _newScopes = Array.Empty<string>();
    private DateTime? _newExpiryDate;
    private bool _newPersonal;

    private ApiKeyOwnership Ownership => ApiKeyOptionsAccessor.Value?.SystemKeys ?? ApiKeyOwnership.Both;
    private bool ShowPersonalCheckbox => PersonalKeyChoice.ShowCheckbox(Ownership, ShowPrivateKeys);

    protected override async Task OnInitializedAsync()
    {
        _text = await TextProvider.ResolveAsync([.. ApiKeyViewText.All, .. SystemApiKeyViewText.All]);

        _apiKeyManagementService = ServiceProvider.GetService<ISystemApiKeyManagementService>();
        _apiKeyServiceMissing = _apiKeyManagementService == null;
        if (_apiKeyServiceMissing) { await base.OnInitializedAsync(); return; }

        _systemScopeRegistry = ServiceProvider.GetService<ISystemScopeRegistry>();
        _allScopes = _systemScopeRegistry?.All.Select(s => s.Name).ToArray() ?? [];
        _scopeDescriptions = _systemScopeRegistry?.All.ToDictionary(s => s.Name, s => s.Description) ?? new Dictionary<string, string>();

        await ReloadData();
        await base.OnInitializedAsync();
    }

    private async Task ReloadData()
    {
        var keys = await _apiKeyManagementService.GetSystemKeysAsync(PersonalKeyChoice.Listed(Ownership, ShowPrivateKeys)).ToArrayAsync();
        _keys = keys
            .Select(x => new SystemApiKeyModel
            {
                Key = x.Key,
                Name = x.Name,
                ApiKey = x.ApiKey,
                VisibleKey = _apiKeyMask,
                SystemScopes = x.SystemScopes ?? [],
                ExpiryDate = x.ExpiryDate,
                CreatedAt = x.CreatedAt,
                LastUsedAt = x.LastUsedAt,
                CreatedBy = x.CreatedBy,
                OwnerMemberKey = x.OwnerMemberKey,
                DisabledAt = x.DisabledAt,
                DisabledBy = x.DisabledBy,
            }).ToArray();

        StateHasChanged();
    }

    private async Task CreateAsync()
    {
        try
        {
            var personal = PersonalKeyChoice.IsPersonal(Ownership, ShowPersonalCheckbox && _newPersonal);
            var created = await _apiKeyManagementService.CreateSystemKeyAsync(_newName, _newScopes?.ToArray() ?? [], _newExpiryDate, personal);
            _newName = "";
            _newScopes = Array.Empty<string>();
            _newExpiryDate = null;
            _newPersonal = false;
            await ReloadData();
            await ShowKeyDialogAsync(created);
            NotificationService.Notify(NotificationSeverity.Success, _text[SystemApiKeyViewText.Created]);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, _text[ApiKeyViewText.CreateFailed], ex.Message);
        }
    }

    private async Task RefreshAsync(SystemApiKeyModel context)
    {
        var result = await DialogService.Confirm(_text.Format(ApiKeyViewText.ConfirmRegenerate, context.Name), _text[ApiKeyViewText.ConfirmRegenerateTitle]);
        if (result != true) return;

        var refreshed = await _apiKeyManagementService.RefreshSystemKeyAsync(context.Key);
        await ReloadData();
        await ShowKeyDialogAsync(refreshed);
    }

    // Reveal the raw key once via a dialog — required because with AutoLockKeys the key is locked on
    // creation, so the reloaded row carries no value, and this is the only moment the secret exists.
    private async Task ShowKeyDialogAsync(IApiKey key)
    {
        if (key == null || string.IsNullOrEmpty(key.ApiKey)) return;
        await DialogService.OpenAsync<ApiKeyRevealDialog>(
            _text.Format(SystemApiKeyViewText.RevealTitle, key.Name),
            new Dictionary<string, object>
            {
                [nameof(ApiKeyRevealDialog.ApiKey)] = key.ApiKey,
                [nameof(ApiKeyRevealDialog.RemainsRetrievable)] = !ApiKeyOptionsAccessor.Value.AutoLockKeys
            },
            new DialogOptions { Width = "640px", CloseDialogOnOverlayClick = false });
    }

    private void OpenRowMenu(MouseEventArgs args, SystemApiKeyModel context)
    {
        var hasValue = !string.IsNullOrEmpty(context.ApiKey);

        var items = new List<ContextMenuItem>();
        if (hasValue) items.Add(new ContextMenuItem { Text = _text[ApiKeyViewText.Copy], Icon = "content_copy", Value = "copy" });
        if (hasValue && context.VisibleKey == _apiKeyMask) items.Add(new ContextMenuItem { Text = _text[ApiKeyViewText.ShowValue], Icon = "visibility", Value = "show" });
        if (hasValue && context.VisibleKey != _apiKeyMask) items.Add(new ContextMenuItem { Text = _text[ApiKeyViewText.HideValue], Icon = "visibility_off", Value = "hide" });
        if (ShowAuditLogButton) items.Add(new ContextMenuItem { Text = _text[ApiKeyViewText.AuditLog], Icon = "manage_search", Value = "audit" });
        if (hasValue) items.Add(new ContextMenuItem { Text = _text[ApiKeyViewText.Lock], Icon = "lock", Value = "lock" });
        items.Add(new ContextMenuItem { Text = _text[ApiKeyViewText.Refresh], Icon = "refresh", Value = "refresh" });
        items.Add(context.IsDisabled
            ? new ContextMenuItem { Text = _text[ApiKeyViewText.Enable], Icon = "play_circle", Value = "enable" }
            : new ContextMenuItem { Text = _text[ApiKeyViewText.Disable], Icon = "block", IconColor = "var(--rz-danger)", Value = "disable" });
        items.Add(new ContextMenuItem { Text = _text[ApiKeyViewText.Delete], Icon = "delete", IconColor = "var(--rz-danger)", Value = "delete" });

        ContextMenuService.Open(args, items, async e =>
        {
            ContextMenuService.Close();
            await OnRowActionAsync(context, e.Value as string);
        });
    }

    private async Task OnRowActionAsync(SystemApiKeyModel context, string action)
    {
        switch (action)
        {
            case "show": context.VisibleKey = context.ApiKey; break;
            case "hide": context.VisibleKey = _apiKeyMask; break;
            case "copy": await CopyToClipboard(context); break;
            case "audit": await OpenAuditLogAsync(context); break;
            case "lock": await LockKeyAsync(context); break;
            case "refresh": await RefreshAsync(context); break;
            case "disable": await SetDisabledAsync(context, true); break;
            case "enable": await SetDisabledAsync(context, false); break;
            case "delete": await DeleteAsync(context); break;
        }
        StateHasChanged();
    }

    private async Task CopyToClipboard(SystemApiKeyModel context)
    {
        var keyToCopy = context.VisibleKey != _apiKeyMask ? context.VisibleKey : context.ApiKey;
        await Js.InvokeVoidAsync("clipboard.copyText", keyToCopy);
        NotificationService.Notify(new NotificationMessage
        {
            Summary = _text.Format(ApiKeyViewText.Copied, context.Name)
        });
    }

    /// <inheritdoc cref="ApiKeyView.SetDisabledAsync"/>
    private async Task SetDisabledAsync(SystemApiKeyModel context, bool disabled)
    {
        if (disabled)
        {
            var result = await DialogService.Confirm(
                _text.Format(SystemApiKeyViewText.ConfirmDisable, context.Name),
                _text[ApiKeyViewText.ConfirmDisableTitle]);
            if (result != true) return;
        }

        await _apiKeyManagementService.SetSystemKeyDisabledAsync(context.Key, disabled);
        await ReloadData();
    }

    private string GetDisabledText(SystemApiKeyModel context)
    {
        var when = context.DisabledAt?.ToString("yyyy-MM-dd HH:mm");
        return string.IsNullOrEmpty(context.DisabledBy)
            ? _text.Format(ApiKeyViewText.DisabledAt, when)
            : _text.Format(ApiKeyViewText.DisabledAtBy, when, context.DisabledBy);
    }

    private async Task LockKeyAsync(SystemApiKeyModel context)
    {
        var result = await DialogService.Confirm(_text.Format(ApiKeyViewText.ConfirmLock, context.Name), _text[ApiKeyViewText.ConfirmLockTitle]);
        if (result != true) return;

        await _apiKeyManagementService.LockSystemKeyAsync(context.Key);
        await ReloadData();
    }

    private async Task DeleteAsync(SystemApiKeyModel context)
    {
        var result = await DialogService.Confirm(_text.Format(SystemApiKeyViewText.ConfirmDelete, context.Name), _text[ApiKeyViewText.ConfirmDeleteTitle]);
        if (result != true) return;

        try
        {
            await _apiKeyManagementService.DeleteSystemKeyAsync(context.Key);
            await ReloadData();
            NotificationService.Notify(NotificationSeverity.Success, _text[SystemApiKeyViewText.Deleted]);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, _text[ApiKeyViewText.DeleteFailed], ex.Message);
        }
    }

    private async Task OpenAuditLogAsync(SystemApiKeyModel context)
    {
        var pinned = new Tharga.Team.Blazor.Features.Audit.AuditPinnedFilter
        {
            CallerKeyId = context.Key,
            CallerType = Tharga.Team.Service.Audit.AuditCallerType.ApiKey,
        };

        await DialogService.OpenAsync(_text.Format(ApiKeyViewText.AuditLogTitle, context.Name), _ =>
            @<Tharga.Team.Blazor.Features.Audit.AuditLogView PinnedFilter="@pinned" />,
            new DialogOptions { Width = "90vw", Height = "85vh", Resizable = true, Draggable = true });
    }
}
