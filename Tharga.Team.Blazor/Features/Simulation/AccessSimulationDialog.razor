@using Microsoft.AspNetCore.Authorization
@using Tharga.Team
@using Tharga.Team.Blazor.Features.Simulation
@attribute [Authorize]
@inject DialogService DialogService
@inject AccessSimulationState SimulationState
@inject IThargaTextProvider TextProvider

<RadzenStack Orientation="Orientation.Vertical" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Style="height: 100%;">
    <RadzenStack Gap="1rem">
        <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@_text[AccessSimulationDialogText.Intro]</RadzenText>

        @* The limitation, stated where the choice is made rather than discovered afterwards. *@
        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat" AllowClose="false" class="rz-m-0">
            @_text[AccessSimulationDialogText.Limitation]
        </RadzenAlert>

        @if (_members.Count > 0)
        {
            <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                <RadzenLabel Text="@_text[AccessSimulationDialogText.Member]" />
                <RadzenDropDown TValue="string" Value="@_memberKey" Data="@_members"
                                TextProperty="@nameof(AccessSimulationCandidate.Name)"
                                ValueProperty="@nameof(AccessSimulationCandidate.Key)"
                                AllowClear="true" AllowFiltering="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Placeholder="@_text[AccessSimulationDialogText.MemberPlaceholder]"
                                Change="@OnMemberChanged" Style="width: 100%;" />
            </RadzenStack>
        }

        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap">
            <RadzenStack Orientation="Orientation.Vertical" Gap="0" Style="flex: 1 1 12rem;">
                <RadzenLabel Text="@_text[AccessSimulationDialogText.AccessLevel]" />
                <RadzenDropDown TValue="AccessLevel?" Value="@_level" Data="@_levels"
                                TextProperty="@nameof(AccessSimulationCandidate.Name)"
                                ValueProperty="@nameof(AccessSimulationCandidate.AccessLevel)"
                                AllowClear="true"
                                Placeholder="@_text[AccessSimulationDialogText.AccessLevelPlaceholder]"
                                ValueChanged="@OnLevelChanged" Style="width: 100%;" />
            </RadzenStack>

            @if (_roles.Count > 0)
            {
                <RadzenStack Orientation="Orientation.Vertical" Gap="0" Style="flex: 1 1 12rem;">
                    <RadzenLabel Text="@_text[AccessSimulationDialogText.Roles]" />
                    <RadzenDropDown TValue="IEnumerable<string>" Value="@_selectedRoles" Data="@_roles"
                                    TextProperty="@nameof(AccessSimulationCandidate.Name)"
                                    ValueProperty="@nameof(AccessSimulationCandidate.Name)"
                                    Multiple="true" AllowClear="true" AllowFiltering="true"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    Placeholder="@_text[AccessSimulationDialogText.RolesPlaceholder]"
                                    ValueChanged="@OnRolesChanged" Style="width: 100%;" />
                </RadzenStack>
            }
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
            <RadzenLabel Text="@_text[AccessSimulationDialogText.Scopes]" />
            <RadzenTextBox Value="@_search" @oninput="@(e => _search = e.Value?.ToString() ?? string.Empty)"
                           Placeholder="@_text[AccessSimulationDialogText.ScopeSearch]" Style="width: 100%;" />

            @* Every scope, so what cannot be kept is visible rather than silently absent. Inherited scopes are
               checked and fixed: unticking one would be simulating a different level or role, not that one. *@
            <div class="rz-border-base-300 rz-border-radius-2 rz-p-2" style="max-height: 18rem; overflow-y: auto; border-style: solid; border-width: 1px;">
                @foreach (var choice in VisibleChoices)
                {
                    var inherited = _inherited.Contains(choice.Name);
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" title="@choice.Description">
                        <RadzenCheckBox TValue="bool" Value="@(inherited || _ticked.Contains(choice.Name))"
                                        Disabled="@(inherited || !choice.Held)"
                                        Change="@(value => OnScopeToggled(choice.Name, value))" />
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@choice.Name</RadzenText>
                        @if (inherited)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-color-secondary">@_text[AccessSimulationDialogText.Inherited]</RadzenText>
                        }
                        @if (!choice.Held)
                        {
                            <RadzenIcon Icon="lock" Style="font-size: 1rem;" />
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-color-warning">@_text[AccessSimulationDialogText.NotHeld]</RadzenText>
                        }
                    </RadzenStack>
                }
            </div>

            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">
                @_text.Format(AccessSimulationDialogText.Summary, KeptCount, _simulation?.Scopes.Count ?? 0)
            </RadzenText>
        </RadzenStack>

        @* The warning, shown before applying rather than after. The failure it prevents is an administrator
           concluding "they cannot do X" from a simulation that was never able to show X — an error that leads to
           granting more access than necessary, which is the opposite of what this screen is for. *@
        @if (_simulation != null && !_gap.IsFaithful)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat" AllowClose="false" class="rz-m-0">
                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">@_text[AccessSimulationDialogText.GapTitle]</RadzenText>
                @if (_gap.UnreachableScopes.Count > 0)
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-1">
                        @_text.Format(AccessSimulationDialogText.GapUnreachable, string.Join(", ", _gap.UnreachableScopes))
                    </RadzenText>
                }
                @if (_gap.SystemAccessNotReproduced)
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@_text[AccessSimulationDialogText.GapSystem]</RadzenText>
                }
            </RadzenAlert>
        }
        else if (_simulation != null)
        {
            <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0 rz-color-success">@_text[AccessSimulationDialogText.Faithful]</RadzenText>
        }
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
        <RadzenButton Text="@_text[AccessSimulationDialogText.Start]" Icon="visibility" Disabled="@(_simulation == null)" Click="@Start" />
        <CancelButton Click="@Cancel" />
    </RadzenStack>
</RadzenStack>

@code {
    private TextSet _text = TextSet.Empty;

    private IReadOnlyList<AccessSimulationCandidate> _members = [];
    private IReadOnlyList<AccessSimulationCandidate> _roles = [];
    private IReadOnlyList<AccessSimulationCandidate> _levels = [];
    private IReadOnlyList<AccessSimulationScopeChoice> _choices = [];
    private IReadOnlyDictionary<AccessLevel, IReadOnlyList<string>> _levelScopes = new Dictionary<AccessLevel, IReadOnlyList<string>>();
    private IReadOnlyDictionary<string, IReadOnlyList<string>> _roleScopes = new Dictionary<string, IReadOnlyList<string>>();
    private HashSet<string> _held = new(StringComparer.OrdinalIgnoreCase);

    private string _memberKey;
    private string _memberName;
    private AccessLevel? _level;
    private IEnumerable<string> _selectedRoles = [];
    private HashSet<string> _ticked = new(StringComparer.Ordinal);
    private string _search = string.Empty;

    private IReadOnlyCollection<string> _inherited = [];
    private AccessSimulation _simulation;
    private AccessSimulationGap _gap;

    private IEnumerable<AccessSimulationScopeChoice> VisibleChoices => string.IsNullOrWhiteSpace(_search)
        ? _choices
        : _choices.Where(c => c.Name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));

    private int KeptCount => _simulation?.Scopes.Count(_held.Contains) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        _text = await TextProvider.ResolveAsync(AccessSimulationDialogText.All);

        _members = await SimulationState.GetMemberTargetsAsync();
        _roles = await SimulationState.GetRoleTargetsAsync();
        _levels = SimulationState.GetAccessLevelTargets();
        _choices = await SimulationState.GetScopeChoicesAsync();

        _levelScopes = _levels.Where(l => l.AccessLevel != null).ToDictionary(l => l.AccessLevel.Value, l => l.Scopes);
        _roleScopes = _roles.GroupBy(r => r.Name, StringComparer.Ordinal).ToDictionary(g => g.Key, g => g.First().Scopes, StringComparer.Ordinal);
        _held = _choices.Where(c => c.Held).Select(c => c.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);

        await RecomputeAsync();
    }

    /// <summary>
    /// Picking a member fills level, roles and scopes from their real grant. Their effective scopes are ticked
    /// in full, so the target is exactly what they hold even where a role's scopes are not listed here.
    /// </summary>
    private async Task OnMemberChanged(object value)
    {
        var member = _members.FirstOrDefault(m => m.Key == value as string);
        _memberKey = member?.Key;
        _memberName = member?.Name;

        if (member != null)
        {
            _level = member.AccessLevel is { } level && _levelScopes.ContainsKey(level) ? level : null;
            _selectedRoles = [.. member.Roles.Where(_roleScopes.ContainsKey)];
            _ticked = member.Scopes.ToHashSet(StringComparer.Ordinal);
        }

        await RecomputeAsync();
    }

    private async Task OnLevelChanged(AccessLevel? level)
    {
        _level = level;
        await EditedAsync();
    }

    private async Task OnRolesChanged(IEnumerable<string> roles)
    {
        _selectedRoles = [.. roles ?? []];
        await EditedAsync();
    }

    private async Task OnScopeToggled(string scope, bool selected)
    {
        if (selected) _ticked.Add(scope);
        else _ticked.Remove(scope);

        await EditedAsync();
    }

    /// <summary>A change by hand makes it a composed target rather than a view of that member.</summary>
    private async Task EditedAsync()
    {
        _memberKey = null;
        _memberName = null;
        await RecomputeAsync();
    }

    private async Task RecomputeAsync()
    {
        var roles = _selectedRoles?.ToArray() ?? [];
        _inherited = AccessSimulationComposer.Inherited(_level, roles, _levelScopes, _roleScopes);
        _simulation = AccessSimulationComposer.Build(new SimulationSelection(_level, roles, [.. _ticked], _memberName), _levelScopes, _roleScopes);
        _gap = await SimulationState.DescribeGapAsync(_simulation);
    }

    private Task Cancel()
    {
        DialogService.Close(false);
        return Task.CompletedTask;
    }

    private async Task Start()
    {
        if (_simulation == null) return;

        DialogService.Close(true);
        await SimulationState.StartAsync(_simulation);
    }
}
