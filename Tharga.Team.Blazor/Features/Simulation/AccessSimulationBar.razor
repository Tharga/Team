@using Tharga.Team.Blazor.Features.Simulation
@inject AccessSimulationState SimulationState
@inject DialogService DialogService

@* One component for a host to place, not two: the entry point when nothing is simulated, the indicator
   and the way out when something is. Placing it therefore wires up both halves by default.

   Both halves can now be switched off individually — ShowEntryPoint and ShowBanner — because the access
   card on the profile page offers the same two things in a place a demo does not have to look at. That
   makes "the way in cannot be wired without the way out" a default rather than a guarantee, so read those
   two parameters before assuming this component is the exit. *@

@if (_active != null && ShowBanner)
{
    @* Deliberately loud, and on every page while active. A caller who forgets they are simulating reads
       missing controls as bugs and files them against their own session. *@
    <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat" AllowClose="false" class="rz-m-0 rz-p-2">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="1rem">
            <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">
                Viewing as <strong>@Describe(_active)</strong> — your own access is reduced.
            </RadzenText>
            <RadzenButton Text="Return to my access" Icon="undo" ButtonStyle="ButtonStyle.Warning"
                          Size="ButtonSize.Small" Variant="Variant.Flat" Click="@Stop" />
        </RadzenStack>
    </RadzenAlert>
}
else if (_canSimulate && ShowEntryPoint)
{
    <RadzenButton Text="@Text" Icon="visibility" ButtonStyle="ButtonStyle.Light"
                  Size="ButtonSize.Small" Variant="Variant.Flat" Click="@Open" />
}

@code {
    /// <summary>Label for the entry-point button. Defaults to "View as…".</summary>
    [Parameter] public string Text { get; set; } = "View as…";

    /// <summary>
    /// Whether the <b>way in</b> — the "View as…" button — is offered here. Default true. Set it false
    /// where the entry point lives somewhere else, such as the access card on the profile page.
    /// </summary>
    /// <remarks>
    /// Suppresses only the way <i>in</i>; <see cref="ShowBanner"/> governs the way out.
    /// <para>
    /// Setting it false everywhere leaves no way to start a simulation at all — which is a legitimate way
    /// to turn the feature off in the UI, but <c>o.Blazor.Simulation.Enabled = false</c> is the honest one:
    /// it also stops the cookie being read and the filter being reached.
    /// </para>
    /// </remarks>
    [Parameter] public bool ShowEntryPoint { get; set; } = true;

    /// <summary>
    /// Whether the active-simulation banner — and with it the "Return to my access" button — is rendered
    /// here. Default true.
    /// </summary>
    /// <remarks>
    /// <b>Set this false only when the way out exists somewhere the caller can still reach.</b> The banner
    /// is the exit that does not depend on remembering where anything lives, so switching it off makes the
    /// access card on the profile page the only one. That is a supported arrangement — it is why the card
    /// exists — but it is the host's job to keep the profile route reachable under a reduced session:
    /// gate that page on a scope a simulation can remove and there is no way back but signing out.
    /// <para>
    /// The point of hiding it is a <b>demonstration</b>. Demo mode exists so an audience sees the product
    /// rather than the administrative surface, and a full-width warning across every page is exactly the
    /// thing it was turned on to avoid. Outside that case, leave it alone: for the access-checking job the
    /// feature was built for, being loud is the feature — someone who forgets they are simulating reads
    /// missing controls as bugs and files them against their own session.
    /// </para>
    /// </remarks>
    [Parameter] public bool ShowBanner { get; set; } = true;

    private AccessSimulation _active;
    private bool _canSimulate;

    protected override async Task OnInitializedAsync()
    {
        if (!SimulationState.Enabled) return;

        _active = await SimulationState.GetActiveAsync();

        // Only asked when nothing is active. While simulating, the exit must show regardless of whether
        // the simulation removed the scope that authorizes starting one.
        if (_active == null) _canSimulate = await SimulationState.CanSimulateAsync();
    }

    private static string Describe(AccessSimulation simulation) => simulation.Kind switch
    {
        AccessSimulationKind.User => simulation.Label,
        AccessSimulationKind.Role => $"the {simulation.Label} role",
        AccessSimulationKind.AccessLevel => $"access level {simulation.Label}",
        _ => simulation.Label
    };

    private async Task Open()
    {
        await DialogService.OpenAsync<AccessSimulationDialog>("View as another user",
            options: new DialogOptions { Width = "560px", CloseDialogOnOverlayClick = true });
    }

    private Task Stop() => SimulationState.StopAsync();
}
