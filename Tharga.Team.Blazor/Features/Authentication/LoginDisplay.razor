@using Microsoft.Extensions.Options
@using Tharga.Team
@using Tharga.Team.Blazor.Features.User
@using Tharga.Toolkit
@implements IDisposable
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IOptions<ThargaBlazorOptions> ThargaBlazorOptions;
@inject IThargaTextProvider TextProvider
@inject IUserService UserService
@inject AvatarChangeNotifier AvatarChangeNotifier

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized>
            <RadzenProfileMenu Click="@(ClickAction)" title="@_email">
                <Template>
                    <UserAvatar User="_user" EMail="@_email" Size="32px" />
                </Template>
                <ChildContent>
                    <RadzenProfileMenuItem Text="@_userText" Icon="account_circle" />
                    <RadzenProfileMenuItem Text="@_teamText" Icon="group" Visible="@GetShowTeam()" />
                    @* Host-supplied items, between the built-ins and Logout. Value carries the href, because
                       ClickAction keys the built-ins off Icon and a host is free to reuse one of those icons. *@
                    @foreach (var item in _menuItems)
                    {
                        <RadzenProfileMenuItem Text="@item.Text" Icon="@item.Icon" Value="@item.Href" />
                    }
                    <hr style="margin: 0;" />
                    <RadzenProfileMenuItem Text="@_logoutText" Icon="logout" />
                </ChildContent>
            </RadzenProfileMenu>
        </Authorized>
        <NotAuthorized>
            <RadzenButton Text="@_loginText" Icon="login" Click="Login" />
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>
<div>&nbsp;</div>

@code {
    private string _email;
    private IUser _user;
    private bool _showTeamDefault;
    private bool _hasTeamMenuRoleRestriction;
    private bool _userInTeamMenuRole;
    private string _userText = TeamMenuText.User.Default;
    private string _teamText = TeamMenuText.Team.Default;
    private string _logoutText = TeamMenuText.Logout.Default;
    private string _loginText = TeamMenuText.Login.Default;
    private string _profilePath = TeamMenuNavigation.DefaultProfilePath;
    private string _teamPath = TeamMenuNavigation.DefaultTeamPath;

    [Parameter]
    public bool? ShowTeam { get; set; }

    /// <summary>
    /// Restricts the Team profile-menu item to users in at least one of the given roles. When null or
    /// empty (the default) the item is shown to every authenticated user, exactly as before.
    /// </summary>
    [Parameter]
    public string[] TeamMenuRoles { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _showTeamDefault = ThargaBlazorOptions.Value._teamService != null;

        _profilePath = TeamMenuNavigation.Resolve(ThargaBlazorOptions.Value.ProfilePath, TeamMenuNavigation.DefaultProfilePath);
        _teamPath = TeamMenuNavigation.Resolve(ThargaBlazorOptions.Value.TeamPath, TeamMenuNavigation.DefaultTeamPath);

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated ?? false)
        {
            _email = authState.User.GetEmail();
            _user = await UserService.GetCurrentUserAsync();
            AvatarChangeNotifier.Changed += OnAvatarChanged;
        }

        var teamMenuRoles = TeamMenuRoles?.Where(x => !string.IsNullOrWhiteSpace(x)).ToArray() ?? [];
        _hasTeamMenuRoleRestriction = teamMenuRoles.Length > 0;
        _userInTeamMenuRole = teamMenuRoles.Any(authState.User.IsInRole);

        // Resolved once here rather than per render: the provider is async and may reach an external content
        // source, and a host's items are fixed for the life of the circuit.
        foreach (var item in ThargaBlazorOptions.Value._menuItems)
        {
            if (!TeamMenuItemVisibility.IsVisible(authState.User, item)) continue;
            _menuItems.Add((await TextProvider.GetAsync(item.Text), item.Icon, item.Href));
        }

        _userText = await TextProvider.GetAsync(TeamMenuText.User);
        _teamText = await TextProvider.GetAsync(TeamMenuText.Team);
        _logoutText = await TextProvider.GetAsync(TeamMenuText.Logout);
        _loginText = await TextProvider.GetAsync(TeamMenuText.Login);

        await base.OnInitializedAsync();
    }

    private readonly List<(string Text, string Icon, string Href)> _menuItems = [];

    private async Task ClickAction(RadzenProfileMenuItem args)
    {
        // Host items first, and matched on Value rather than Icon: the built-in cases below key off Icon, so a
        // host reusing "group" or "logout" would otherwise trigger the wrong action instead of its own link.
        if (args.Value is string href && _menuItems.Any(x => x.Href == href))
        {
            NavigationManager.NavigateTo(href);
            return;
        }

        switch (args.Icon)
        {
            case "account_circle":
                NavigationManager.NavigateTo(_profilePath);
                break;
            case "group":
                NavigationManager.NavigateTo(_teamPath);
                break;
            case "logout":
                await Logout();
                break;
            default:
                throw new ArgumentOutOfRangeException($"Unknown action '{args.Icon}'.");
        }
    }

    private void OnAvatarChanged()
    {
        _ = InvokeAsync(async () =>
        {
            _user = await UserService.GetCurrentUserAsync();
            StateHasChanged();
        });
    }

    public void Dispose() => AvatarChangeNotifier.Changed -= OnAvatarChanged;

    private Task Login()
    {
        NavigationManager.NavigateTo("/login", forceLoad: true);
        return Task.CompletedTask;
    }

    private Task Logout()
    {
        NavigationManager.NavigateTo("/logout", forceLoad: true);
        return Task.CompletedTask;
    }

    private bool GetShowTeam() => ShouldShowTeamMenuItem(ShowTeam, _showTeamDefault, _hasTeamMenuRoleRestriction, _userInTeamMenuRole);

    internal static bool ShouldShowTeamMenuItem(bool? showTeam, bool showTeamDefault, bool hasRoleRestriction, bool userInAnyRole)
    {
        var visible = showTeam ?? showTeamDefault;
        if (!visible) return false;
        if (!hasRoleRestriction) return true;
        return userInAnyRole;
    }
}
