@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@using Microsoft.JSInterop
@using Tharga.Team.Blazor.Framework
@implements IAsyncDisposable
@inject IServiceProvider Services
@inject IThargaTextProvider TextProvider
@inject IOptions<ThargaBlazorOptions> ThargaBlazorOptions
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime

@*
    The page's half of the server-side session (Tharga/Team#471): it reports use of the page, asks "Still here?" before an idle sign-out, and sends the
    browser to the ended page when the session ends. It decides nothing: the circuit reads the store and says what to show, the countdown only displays what
    the server said was left, and other tabs are only told to look again.

    "Sign out" goes through the library's /logout with ?reason=signedout when the library signs people in, so the identity provider is signed out too and
    the browser still lands on the ended page; the session is already ended by then, so /logout writes nothing more. Without the library's sign-in it goes
    straight to the ended page.

    LoginDisplay renders it. A host without LoginDisplay places it once in its layout; it renders nothing and loads nothing while sessions are not active.
*@

@if (_open)
{
    var (before, after) = CountdownParts();
    <div class="session-watch-overlay" data-session-watch-overlay></div>
    <div class="session-watch-dialog" role="alertdialog" aria-modal="true" aria-labelledby="@TitleId" aria-describedby="@BodyId" data-session-watch-dialog>
        <h2 class="rz-text-h6 rz-mb-2" id="@TitleId" data-session-watch-title>@_text[SessionText.Title]</h2>
        <p class="rz-text-body1 rz-mb-2" id="@BodyId" data-session-watch-body>@_text[SessionText.Body]</p>
        <p class="rz-text-body2 rz-mb-4" aria-live="polite" data-session-watch-countdown>@before<strong data-session-watch-time>@_time</strong>@after</p>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton Text="@_text[SessionText.SignOut]" ButtonStyle="ButtonStyle.Light" Click="SignOutAsync" data-session-watch-signout />
            <RadzenButton Text="@_text[SessionText.Stay]" ButtonStyle="ButtonStyle.Primary" Click="StayAsync" data-session-watch-stay />
        </RadzenStack>
    </div>
}

@code {
    private const string ModulePath = "./_content/Tharga.Team.Blazor/session-activity.js";
    private const string TimeSelector = "[data-session-watch-time]";
    private const string Placeholder = "{0}";
    private const string ActivityKind = "activity";
    private const string EndedKind = "ended";

    private readonly string _id = Guid.NewGuid().ToString("N");
    private ISessionCircuit _circuit;
    private IDisposable _attachment;
    private IJSObjectReference _module;
    private DotNetObjectReference<SessionWatch> _self;
    private TextSet _text = TextSet.Empty;
    private bool _open;
    private bool _left;
    private bool _signingOut;
    private string _time;

    private string TitleId => $"{_id}-title";

    private string BodyId => $"{_id}-body";

    protected override async Task OnInitializedAsync()
    {
        // Resolved optionally: this renders in hosts that registered no session watch at all.
        var circuit = Services.GetService<ISessionCircuit>();
        if (circuit?.Active != true) return;

        _circuit = circuit;
        _text = await TextProvider.ResolveAsync(SessionText.All);
        _circuit.Changed += OnChanged;
        _attachment = _circuit.Attach();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _circuit == null) return;

        try
        {
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", ModulePath);
            _self = DotNetObjectReference.Create(this);
            var interval = (int)(ThargaBlazorOptions.Value.Sessions ?? new SessionOptions()).ActivityInterval.TotalMilliseconds;
            await _module.InvokeVoidAsync("watchActivity", _id, interval, NavigationManager.ToAbsoluteUri(SessionActivityEndpoint.Route.TrimStart('/')).ToString(), _self);
        }
        catch (Exception exception) when (exception is JSException or InvalidOperationException or JSDisconnectedException)
        {
            // Without it only requests count as activity and other tabs are not told; the session still ends on time.
        }

        await ApplyAsync();
    }

    /// <summary>Another tab of this browser says somebody was active or the session ended. A hint: the circuit looks at the store, which decides.</summary>
    [JSInvokable]
    public async Task OnPeerSignal(string kind)
    {
        if (_circuit == null || kind is not (ActivityKind or EndedKind)) return;

        await _circuit.CheckAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_circuit != null) _circuit.Changed -= OnChanged;
        _attachment?.Dispose();
        _attachment = null;

        if (_module != null)
        {
            if (_open) await CallAsync("stopCountdown", _id);
            await CallAsync("stopWatching", _id);

            try
            {
                await _module.DisposeAsync();
            }
            catch (Exception exception) when (exception is JSException or JSDisconnectedException)
            {
            }

            _module = null;
        }

        _self?.Dispose();
    }

    private void OnChanged() => _ = InvokeAsync(ApplyAsync);

    private async Task ApplyAsync()
    {
        if (_circuit == null || _left) return;

        switch (_circuit.State)
        {
            case SessionCircuitState.Ended:
                await LeaveAsync();
                break;
            case SessionCircuitState.Warning when !_open:
                await OpenAsync(_circuit.Remaining ?? TimeSpan.Zero);
                break;
            case SessionCircuitState.Watching when _open:
                await CloseAsync();
                break;
        }
    }

    private async Task OpenAsync(TimeSpan remaining)
    {
        _open = true;
        _time = Format(remaining);
        StateHasChanged();

        await CallAsync("holdActivity", _id, true);
        await CallAsync("startCountdown", _id, (int)Math.Max(0, remaining.TotalMilliseconds), TimeSelector);
    }

    private async Task CloseAsync()
    {
        _open = false;
        StateHasChanged();

        await CallAsync("stopCountdown", _id);
        await CallAsync("holdActivity", _id, false);
    }

    private async Task LeaveAsync()
    {
        _left = true;
        if (_open)
        {
            _open = false;
            StateHasChanged();
            await CallAsync("stopCountdown", _id);
        }

        await CallAsync("announce", _id, EndedKind);
        NavigationManager.NavigateTo(LeavingTo(), forceLoad: true);
    }

    /// <summary>Where the browser goes once the session ended: through the library's sign-out when the person chose to sign out here, otherwise the ended page.</summary>
    private string LeavingTo()
    {
        var auth = _signingOut ? Services.GetService<ThargaAuthOptions>() : null;
        if (auth != null && !string.IsNullOrEmpty(auth.LogoutPath))
        {
            return QueryHelpers.AddQueryString(auth.LogoutPath, SessionCookieEvents.ReasonParameterName, SessionCookieEvents.Code(SessionEndReason.SignedOut));
        }

        return _circuit.EndedLocation ?? NavigationManager.BaseUri;
    }

    private async Task StayAsync()
    {
        await _circuit.StayAsync();
        await CallAsync("announce", _id, ActivityKind);
        await ApplyAsync();
    }

    private async Task SignOutAsync()
    {
        _signingOut = true;
        await _circuit.SignOutAsync();

        // Not ended (the store could not be reached): a later end is not one the person chose here.
        if (_circuit.State != SessionCircuitState.Ended) _signingOut = false;
        await ApplyAsync();
    }

    private async Task CallAsync(string identifier, params object[] args)
    {
        if (_module == null) return;

        try
        {
            await _module.InvokeVoidAsync(identifier, args);
        }
        catch (Exception exception) when (exception is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            // The dialog still works without the browser half; the server decides regardless.
        }
    }

    private (string Before, string After) CountdownParts()
    {
        var template = _text[SessionText.Countdown];
        var at = template.IndexOf(Placeholder, StringComparison.Ordinal);

        return at < 0 ? ($"{template} ", string.Empty) : (template[..at], template[(at + Placeholder.Length)..]);
    }

    private static string Format(TimeSpan remaining)
    {
        var seconds = (int)Math.Ceiling(Math.Max(0, remaining.TotalSeconds));
        return $"{seconds / 60}:{seconds % 60:00}";
    }
}
