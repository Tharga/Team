@using Microsoft.Extensions.DependencyInjection
@using Tharga.Team
@typeparam TMember where TMember : class, Tharga.Team.ITeamMember
@inject IServiceProvider ServiceProvider
@inject AuthenticationStateProvider AuthStateProvider
@inject IThargaTextProvider TextProvider

@*
    No [Authorize] attribute here: it is inert on a non-page component and invited false confidence.
    Access is enforced where it holds — the service layer requires users:manage for every read/write
    these tabs perform, and the child views render a friendly notice without it. Hosts should still
    [Authorize] the page that embeds this component.
*@

<RadzenTabs @bind-SelectedIndex="_selectedTab">
    <Tabs>
        <RadzenTabsItem Text="@_text[UsersViewText.UsersTab]">
            <UsersListView TMember="TMember" ActionsTemplate="ActionsTemplate" ActionItems="ActionItems" ActionInvoked="ActionInvoked"
                           ShowAuditLogButton="ShowAuditLogButton" FocusUserKey="@_focusUserKey" TeamSelected="ShowTeamAsync" />
        </RadzenTabsItem>
        <RadzenTabsItem Text="@_text[UsersViewText.TeamsTab]">
            <TeamsListView TMember="TMember" TeamActionsTemplate="TeamActionsTemplate" MemberActionsTemplate="MemberActionsTemplate"
                           TeamActionItems="TeamActionItems" TeamActionInvoked="TeamActionInvoked"
                           ShowAuditLogButton="ShowAuditLogButton" FocusTeamKey="@_focusTeamKey" MemberSelected="ShowUserAsync" />
        </RadzenTabsItem>
        @if (_showDirectoryTab)
        {
            <RadzenTabsItem Text="@_text[UsersViewText.DirectoryOnlyTab]">
                <DirectoryOnlyUsersView />
            </RadzenTabsItem>
        }
    </Tabs>
</RadzenTabs>

@code {
    /// <summary>
    /// Optional template for extra row-level actions in the Users tab, passed through to
    /// <see cref="UsersListView{TMember}"/>. Lets a host keep this packaged tabbed view (including the
    /// directory-only tab) while injecting its own actions.
    /// </summary>
    [Parameter] public RenderFragment<UserViewModel> ActionsTemplate { get; set; }

    /// <summary>
    /// Optional extra items for each user row's split-button dropdown (supply
    /// <c>RadzenSplitButtonItem</c> components), passed through to <see cref="UsersListView{TMember}"/>.
    /// Clicks arrive via <see cref="ActionInvoked"/>.
    /// </summary>
    [Parameter] public RenderFragment ActionItems { get; set; }

    /// <summary>Raised when a consumer-supplied split-button item (<see cref="ActionItems"/>) is clicked.</summary>
    [Parameter] public EventCallback<UserRowAction> ActionInvoked { get; set; }

    /// <summary>
    /// Optional template rendered after the built-in View button in each team row's action column, passed
    /// through to <see cref="TeamsListView{TMember}"/>. The Teams-tab counterpart of
    /// <see cref="ActionsTemplate"/>: without it a host wanting a team row action had to abandon this
    /// wrapper and compose the two list views itself, re-implementing the tab shell.
    /// </summary>
    [Parameter] public RenderFragment<TeamViewModel> TeamActionsTemplate { get; set; }

    /// <summary>
    /// Optional template rendered as an extra column at the right of each member row in a team's
    /// drill-down grid, passed through to <see cref="TeamsListView{TMember}"/>.
    /// </summary>
    [Parameter] public RenderFragment<TeamMemberInfo> MemberActionsTemplate { get; set; }

    /// <summary>
    /// Optional extra items for each team row's split-button dropdown (supply
    /// <c>RadzenSplitButtonItem</c> components), passed through to <see cref="TeamsListView{TMember}"/>.
    /// Clicks arrive via <see cref="TeamActionInvoked"/>. The Teams-tab counterpart of
    /// <see cref="ActionItems"/>.
    /// </summary>
    [Parameter] public RenderFragment TeamActionItems { get; set; }

    /// <summary>Raised when a consumer-supplied team split-button item (<see cref="TeamActionItems"/>) is clicked.</summary>
    [Parameter] public EventCallback<TeamRowAction> TeamActionInvoked { get; set; }

    /// <summary>
    /// Show a per-row action on both tabs opening the audit log scoped to that user or team. Off by
    /// default — the audit log is only queryable when audit storage is configured.
    /// </summary>
    [Parameter] public bool ShowAuditLogButton { get; set; }

    private const int UsersTab = 0;
    private const int TeamsTab = 1;

    // Resolved once in OnInitializedAsync; read synchronously in markup. See TextSet.
    private TextSet _text = TextSet.Empty;
    private bool _showDirectoryTab;
    private int _selectedTab;
    private string _focusUserKey;
    private string _focusTeamKey;

    /// <summary>
    /// Follows a team link from a user's membership list. The tab switch and the row to expand are owned
    /// here because neither child can see the other.
    /// </summary>
    private Task ShowTeamAsync(string teamKey)
    {
        _focusTeamKey = teamKey;
        _selectedTab = TeamsTab;
        return Task.CompletedTask;
    }

    /// <summary>Follows a member link from a team's member list, in the opposite direction.</summary>
    private Task ShowUserAsync(string userKey)
    {
        _focusUserKey = userKey;
        _selectedTab = UsersTab;
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var hasUsersManage = TeamScopeGate.HasSystemScope(authState.User, SystemUserScopes.Manage);
        var directoryRegistered = ServiceProvider.GetService<IUserDirectoryService>() is { IsConfigured: true };
        _showDirectoryTab = UserAdminGate.ShowDirectoryFeatures(hasUsersManage, directoryRegistered);

        _text = await TextProvider.ResolveAsync(UsersViewText.All);

        await base.OnInitializedAsync();
    }
}
