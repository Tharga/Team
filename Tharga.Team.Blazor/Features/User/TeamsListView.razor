@using Tharga.Team
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using Tharga.Team.Blazor.Features.Team
@typeparam TMember where TMember : class, Tharga.Team.ITeamMember
@inject ITeamManagementService TeamManagementService
@inject ITeamDirectoryService TeamDirectoryService
@inject ITeamOversightService TeamOversightService
@inject IUserService UserService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IJSRuntime Js
@inject Microsoft.Extensions.Options.IOptions<Tharga.Team.Blazor.Framework.ThargaBlazorOptions> BlazorOptions
@inject IThargaTextProvider TextProvider

@if (!_canAdminister)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat" AllowClose="false" class="rz-mt-2">
        @_text.Format(TeamsListViewText.RequiresScope, SystemUserScopes.Manage)
    </RadzenAlert>
}
else if (_loaded)
{
    <RadzenDataGrid Data="@_teamViewModels" TItem="TeamViewModel" AllowSorting="true" AllowPaging="true" PageSize="10"
                    AllowFiltering="true" FilterMode="FilterMode.Simple" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
        <Columns>
            <RadzenDataGridColumn Title="" Width="66px" Sortable="false" Filterable="false">
                <Template>
                    <TeamAvatar IconReference="@context.Icon" Name="@context.Name" TeamKey="@context.Key" Size="32px" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="@_text[TeamsListViewText.ColumnName]" Property="Name">
                <Template>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <span>@context.Name</span>
                        @if (context.MemberCount == 0)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Warning" Variant="Variant.Flat" Text="@_text[TeamsListViewText.BadgeEmpty]" />
                        }
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="@_text[TeamsListViewText.ColumnOwner]" Property="OwnerName">
                <Template>
                    @if (string.IsNullOrEmpty(context.OwnerName))
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Danger" Variant="Variant.Flat" Text="@_text[TeamsListViewText.BadgeNoOwner]" />
                    }
                    else
                    {
                        @context.OwnerName
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="@_text[TeamsListViewText.ColumnMembers]" Property="ActiveMemberCount" Width="130px" Filterable="false">
                <Template>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <span>@context.ActiveMemberCount</span>
                        @if (context.InvitedCount > 0)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Light" Variant="Variant.Flat"
                                         Text="@_text.Format(TeamsListViewText.InvitedCount, context.InvitedCount)" />
                        }
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="@_text[TeamsListViewText.ColumnLastUsed]" Property="@nameof(TeamViewModel.LastUsed)" Width="150px" Filterable="false">
                <Template>
                    @if (LastSeenText.IsNever(context.LastUsed))
                    {
                        <RadzenText TextStyle="TextStyle.Caption">@LastSeenText.Never</RadzenText>
                    }
                    else
                    {
                        <DateTimeView Date="@context.LastUsed" />
                    }
                </Template>
            </RadzenDataGridColumn>
            @if (_canSeeAllTeams)
            {
                <RadzenDataGridColumn Title="@_text[TeamsListViewText.ColumnConsent]" Property="Consent" Width="140px" Filterable="false">
                    <Template Context="team">
                        <RadzenBadge BadgeStyle="@(Enum.Parse<BadgeStyle>(TeamVisibility.BadgeStyle(team.Consent)))"
                                     Variant="Variant.Flat"
                                     Text="@TeamVisibility.Label(team.Consent)" />
                    </Template>
                </RadzenDataGridColumn>
            }
            <RadzenDataGridColumn Title="" Width="140px" Sortable="false" Filterable="false">
                <Template>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                        <RadzenSplitButton Text="@_text[TeamsListViewText.ActionView]" Icon="visibility" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                           Click="@(item => OnTeamActionAsync(item, context))">
                            <ChildContent>
                                @if (ShowAuditLogButton)
                                {
                                    <RadzenSplitButtonItem Text="@_text[TeamsListViewText.ActionAuditLog]" Value="@AuditAction" Icon="manage_search" />
                                }
                                @TeamActionItems
                                @if (_canManageTeams)
                                {
                                    <RadzenSplitButtonItem Text="@_text[TeamsListViewText.ActionRename]" Value="@RenameAction" Icon="edit" />
                                    <RadzenSplitButtonItem Text="@_text[TeamsListViewText.ActionSetIcon]" Value="@SetIconAction" Icon="image" />
                                }
                                @if (UserAdminGate.CanSetOwner(_canSetOwner))
                                {
                                    <RadzenSplitButtonItem Text="@_text[SetOwnerActionLabel(context.OwnerCount)]" Value="@SetOwnerAction" Icon="manage_accounts" />
                                }
                                @if (_canDeleteTeams)
                                {
                                    <RadzenSplitButtonItem Text="@_text[TeamsListViewText.ActionDelete]" Value="@DeleteAction" Icon="delete" />
                                }
                            </ChildContent>
                        </RadzenSplitButton>
                        @if (TeamActionsTemplate != null)
                        {
                            @TeamActionsTemplate(context)
                        }
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

    @if (_selectedTeam != null)
    {
        <RadzenCard class="rz-mt-3">
            <RadzenText TextStyle="TextStyle.Subtitle1"><strong>@_selectedTeam.Name</strong></RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-2">
                <RadzenText TextStyle="TextStyle.Caption">@_text[TeamsListViewText.TeamKey]</RadzenText>
                <code>@_selectedTeam.Key</code>
                <RadzenButton Icon="content_copy" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                              title="@_text[TeamsListViewText.CopyTeamKey]" Click="@(() => CopyAsync(_selectedTeam.Key))" />
            </RadzenStack>
            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">@_text[TeamsListViewText.MembersHeading]</RadzenText>
            <RadzenDataGrid Data="@_selectedTeam.Members" TItem="TeamMemberInfo" AllowSorting="true"
                            AllowFiltering="true" FilterMode="FilterMode.Simple" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
                <Columns>
                    <RadzenDataGridColumn Title="" Width="66px" Sortable="false" Filterable="false">
                        <Template>
                            <UserAvatar EMail="@context.EMail" IconReference="@context.Icon" Name="@context.Name" UserKey="@context.Key" Size="32px" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Title="@_text[TeamsListViewText.ColumnName]" Property="Name">
                        <Template>
                            @if (MemberSelected.HasDelegate && !string.IsNullOrEmpty(context.Key))
                            {
                                <RadzenButton Text="@context.Name" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text"
                                              Size="ButtonSize.Small" title="@_text[TeamsListViewText.ShowThisUser]"
                                              Click="@(() => MemberSelected.InvokeAsync(context.Key))" />
                            }
                            else
                            {
                                @context.Name
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Title="@_text[TeamsListViewText.ColumnEmail]" Property="EMail" />
                    <RadzenDataGridColumn Title="@_text[TeamsListViewText.ColumnRole]" Property="AccessLevel" Width="120px" Filterable="false" />
                    <RadzenDataGridColumn Title="@_text[TeamsListViewText.ColumnState]" Property="State" Width="100px" Filterable="false" />
                    <RadzenDataGridColumn Title="@_text[TeamsListViewText.ColumnLastSeen]" Property="@nameof(TeamMemberInfo.LastSeen)" Width="150px" Filterable="false">
                        <Template>
                            @if (LastSeenText.IsNever(context.LastSeen))
                            {
                                <RadzenText TextStyle="TextStyle.Caption">@LastSeenText.Never</RadzenText>
                            }
                            else
                            {
                                <DateTimeView Date="@context.LastSeen" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    @if (MemberActionsTemplate != null)
                    {
                        <RadzenDataGridColumn Title="" Sortable="false" Filterable="false">
                            <Template>
                                @MemberActionsTemplate(context)
                            </Template>
                        </RadzenDataGridColumn>
                    }
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    }
}
else
{
    <Loading />
}

@code {
    /// <summary>
    /// Optional template rendered after the built-in View button in each team row's action column.
    /// </summary>
    [Parameter] public RenderFragment<TeamViewModel> TeamActionsTemplate { get; set; }

    /// <summary>
    /// Optional template rendered as an extra column at the right of each member row in the drill-down grid.
    /// </summary>
    [Parameter] public RenderFragment<TeamMemberInfo> MemberActionsTemplate { get; set; }

    /// <summary>
    /// Optional extra items for each team row's split-button dropdown (supply
    /// <c>RadzenSplitButtonItem</c> components). Clicks arrive via <see cref="TeamActionInvoked"/>.
    /// The Teams-tab counterpart of <c>UsersListView.ActionItems</c>: use this to put an action
    /// <i>inside</i> the menu, and <see cref="TeamActionsTemplate"/> to place a control beside it.
    /// </summary>
    [Parameter] public RenderFragment TeamActionItems { get; set; }

    /// <summary>Raised when a consumer-supplied split-button item (<see cref="TeamActionItems"/>) is clicked.</summary>
    [Parameter] public EventCallback<TeamRowAction> TeamActionInvoked { get; set; }

    /// <summary>
    /// Show a per-row button opening the audit log scoped to that team. Off by default — the audit log is
    /// only queryable when audit storage is configured, so a host opts in once it is.
    /// </summary>
    [Parameter] public bool ShowAuditLogButton { get; set; }

    /// <summary>
    /// Key of the team to expand when the view first renders. Lets a host (or the sibling users tab)
    /// arrive with one team already open.
    /// </summary>
    [Parameter] public string FocusTeamKey { get; set; }

    /// <summary>Raised when a member row is clicked, carrying that member's user key.</summary>
    [Parameter] public EventCallback<string> MemberSelected { get; set; }

    private bool _loaded;
    private bool _canAdminister = true;
    private bool _canDeleteTeams;
    private bool _canSetOwner;
    private bool _canManageTeams;
    private IUser[] _users;
    private ITeam<TMember>[] _teams;
    private bool _canSeeAllTeams;
    private TextSet _text = TextSet.Empty;

    private List<TeamViewModel> _teamViewModels = new();
    private TeamViewModel _selectedTeam;

    protected override async Task OnInitializedAsync()
    {
        _text = await TextProvider.ResolveAsync(TeamsListViewText.All);

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _canSeeAllTeams = TeamVisibility.CanSeeAllTeams(authState.User);
        _canAdminister = UserAdminGate.CanAdministerUsers(
            TeamScopeGate.HasSystemScope(authState.User, SystemUserScopes.Manage));
        _canDeleteTeams = UserAdminGate.CanDeleteTeams(
            TeamScopeGate.HasSystemScope(authState.User, SystemTeamScopes.Delete));
        // System grant only — an in-team scope of the same name must not satisfy it.
        _canSetOwner = TeamScopeGate.HasSystemScope(authState.User, SystemTeamScopes.SetOwner);
        _canManageTeams = UserAdminGate.CanManageTeams(
            TeamScopeGate.HasSystemScope(authState.User, SystemTeamScopes.Manage));

        if (_canAdminister)
        {
            await LoadDataAsync();
            _selectedTeam = _teamViewModels.FirstOrDefault(t => t.Key == FocusTeamKey);
            _loaded = true;
        }

        await base.OnInitializedAsync();
    }

    /// <summary>
    /// Opens the team that a sibling surface asked to focus. Runs on parameter changes rather than only at
    /// initialization, because the tab is already rendered when the users tab hands a team key across.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(FocusTeamKey) || _selectedTeam?.Key == FocusTeamKey) return;

        var focused = _teamViewModels.FirstOrDefault(t => t.Key == FocusTeamKey);
        if (focused != null) _selectedTeam = focused;
    }

    private async Task LoadDataAsync()
    {
        _users = await UserService.GetAsync().ToArrayAsync();
        _teams = _canSeeAllTeams
            ? await TeamOversightService.GetAllTeamsAsync<TMember>().ToArrayAsync()
            : await TeamDirectoryService.GetTeamsAsync<TMember>().ToArrayAsync();

        BuildViewModels();
    }

    private void BuildViewModels()
    {
        _teamViewModels = _teams.Select(t =>
        {
            var members = (t.Members ?? []).Select(m =>
            {
                var user = _users.FirstOrDefault(u => u.Key == m.Key);
                return new TeamMemberInfo
                {
                    Key = m.Key,
                    Name = m.Name ?? user?.Name ?? TeamServiceBase.ResolveDisplayName(user),
                    EMail = user?.EMail ?? m.Invitation?.EMail,
                    Icon = user?.Icon,
                    AccessLevel = m.AccessLevel,
                    State = m.State,
                    LastSeen = m.LastSeen
                };
            }).ToArray();

            var (active, invited) = TeamActivity.CountByState(members);

            return new TeamViewModel
            {
                Key = t.Key,
                Name = t.Name,
                Icon = t.Icon,
                MemberCount = members.Length,
                ActiveMemberCount = active,
                InvitedCount = invited,
                OwnerName = TeamActivity.Owner(members)?.Name,
                IsOwnerless = TeamActivity.Owner(members) == null,
                OwnerCount = members.Count(m => m.AccessLevel == AccessLevel.Owner),
                LastUsed = TeamActivity.LastUsed(members),
                Consent = TeamVisibility.Resolve(t.ConsentedRoles, t.ConsentAccessLevel, BlazorOptions.Value.Consent.AccessLevel),
                Members = members
            };
        }).OrderBy(t => t.Name).ToList();
    }

    private const string AuditAction = "audit";
    private const string DeleteAction = "delete";
    private const string SetOwnerAction = "set-owner";
    private const string RenameAction = "rename";
    private const string SetIconAction = "set-icon";

    /// <summary>
    /// Dispatches the team row's split button. A null item is the primary button — expand the row —
    /// matching the Users tab, where the same gesture means "view".
    /// </summary>
    private async Task OnTeamActionAsync(RadzenSplitButtonItem item, TeamViewModel team)
    {
        switch (item?.Value)
        {
            case null:
                ToggleDetails(team);
                break;
            case AuditAction:
                await OpenAuditLogAsync(team);
                break;
            case DeleteAction:
                await DeleteTeamAsync(team);
                break;
            case SetOwnerAction:
                await SetOwnerAsync(team);
                break;
            case RenameAction:
                await RenameTeamAsync(team);
                break;
            case SetIconAction:
                await SetTeamIconAsync(team);
                break;
            default:
                await TeamActionInvoked.InvokeAsync(new TeamRowAction(item.Value, team));
                break;
        }
    }

    private void ToggleDetails(TeamViewModel team)
    {
        _selectedTeam = _selectedTeam?.Key == team.Key ? null : team;
    }

    private async Task CopyAsync(string value)
    {
        await Js.InvokeVoidAsync("clipboard.copyText", value);
    }

    private async Task OpenAuditLogAsync(TeamViewModel team)
    {
        var pinned = new Audit.AuditPinnedFilter { TeamKey = team.Key };

        await DialogService.OpenAsync(_text.Format(TeamsListViewText.AuditLogTitle, team.Name), _ =>
            @<Tharga.Team.Blazor.Features.Audit.AuditLogView PinnedFilter="@pinned" />,
            new DialogOptions { Width = "90vw", Height = "85vh", Resizable = true, Draggable = true });
    }

    /// <summary>
    /// Cross-team rename, authorized by <see cref="SystemTeamScopes.Manage"/> rather than by membership.
    /// Reuses the same dialog the per-team surface opens — it already takes a team key, so nothing about
    /// it assumed the caller's own team.
    /// </summary>
    private async Task RenameTeamAsync(TeamViewModel team)
    {
        var result = await DialogService.OpenAsync<TeamDialog<TMember>>(
            _text.Format(TeamsListViewText.RenameTitle, team.Name),
            new Dictionary<string, object> { { "TeamKey", team.Key }, { "Name", team.Name } },
            new DialogOptions { Resizable = true, Draggable = true });

        if (result == true) await LoadDataAsync();
    }

    /// <inheritdoc cref="RenameTeamAsync" />
    private async Task SetTeamIconAsync(TeamViewModel team)
    {
        var result = await DialogService.OpenAsync<TeamIconDialog>(
            _text.Format(TeamsListViewText.IconTitle, team.Name),
            new Dictionary<string, object>
            {
                { nameof(TeamIconDialog.TeamKey), team.Key },
                { nameof(TeamIconDialog.HasIcon), !string.IsNullOrEmpty(team.Icon) }
            },
            new DialogOptions { Width = "480px" });

        if (result is true) await LoadDataAsync();
    }

    /// <summary>
    /// Repairs a team that has lost its owner, authorized by the
    /// <see cref="SystemTeamScopes.SetOwner"/> system scope. Offered whenever the caller holds it; the
    /// ownerless — the service refuses otherwise, and a control that throws when clicked is worse than
    /// no control.
    /// </summary>
    private async Task SetOwnerAsync(TeamViewModel team)
    {
        var newOwnerKey = await DialogService.OpenAsync<AssignOwnerDialog>(_text.Format(SetOwnerDialogTitle(team.OwnerCount), team.Name),
            new Dictionary<string, object>
            {
                { nameof(AssignOwnerDialog.TeamName), team.Name },
                { nameof(AssignOwnerDialog.Members), team.Members }
            });

        if (newOwnerKey is not string ownerKey || string.IsNullOrEmpty(ownerKey)) return;

        try
        {
            var result = await TeamManagementService.SetOwnerAsync(team.Key, ownerKey);

            // The roster drives the Owner column and the action's wording, so the list has to be rebuilt
            // rather than patched -- otherwise a repaired team keeps offering the label for its old state.
            await LoadDataAsync();
            _selectedTeam = _teamViewModels.FirstOrDefault(t => t.Key == team.Key);

            // Reporting "owner set" for a call that wrote nothing trains an operator to distrust the
            // message. The service is deliberately idempotent, so this is a normal outcome, not an error.
            if (!result.Changed)
            {
                NotificationService.Notify(NotificationSeverity.Info, _text[TeamsListViewText.OwnerUnchanged],
                    _text.Format(TeamsListViewText.OwnerUnchangedDetail, team.Name));
                return;
            }

            var detail = result.DemotedOwnerKeys.Length > 0
                ? _text.Format(TeamsListViewText.OwnerSetDetail, team.Name, result.DemotedOwnerKeys.Length)
                : _text.Format(TeamsListViewText.OwnerAssignedDetail, team.Name);

            NotificationService.Notify(NotificationSeverity.Success, _text[TeamsListViewText.OwnerAssigned], detail);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, _text[TeamsListViewText.CouldNotAssignOwner], ex.Message);
        }
    }

    /// <summary>
    /// Cross-team delete, authorized by the <see cref="SystemTeamScopes.Delete"/> system scope rather than
    /// by membership or consent. The service layer enforces the same rule, so this only avoids offering an
    /// action the server would refuse.
    /// </summary>
    private async Task DeleteTeamAsync(TeamViewModel team)
    {
        // One whole sentence per plural form. The member count used to be composed into the middle of
        // this sentence at runtime, which no translator can reorder.
        var confirmed = await DialogService.Confirm(
            _text.Format(team.MemberCount == 1 ? TeamsListViewText.DeleteConfirmOne : TeamsListViewText.DeleteConfirmMany, team.Name, team.MemberCount),
            _text[TeamsListViewText.DeleteTitle],
            new ConfirmOptions { OkButtonText = _text[TeamsListViewText.DeleteOk], CancelButtonText = _text[TeamsListViewText.DeleteCancel] });

        if (confirmed is not true) return;

        try
        {
            await TeamManagementService.DeleteTeamAsync(team.Key);

            if (_selectedTeam?.Key == team.Key) _selectedTeam = null;
            await LoadDataAsync();
            NotificationService.Notify(NotificationSeverity.Success, _text[TeamsListViewText.TeamDeleted], team.Name);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, _text[TeamsListViewText.DeleteFailed], ex.Message);
        }
    }

    /// <summary>
    /// Which of the three labels the one operation wears, by how many owners the team currently has.
    /// </summary>
    /// <remarks>
    /// <b>Wording only — never authorization.</b> The gate is the scope alone
    /// (<c>UserAdminGate.CanSetOwner</c>); deciding visibility from the owner count is what the previous
    /// assign-owner gate did, and it hid the action from the two states this feature was built for.
    /// </remarks>
    private static TextKey SetOwnerActionLabel(int ownerCount) => ownerCount switch
    {
        0 => TeamsListViewText.ActionAssignOwner,
        1 => TeamsListViewText.ActionChangeOwner,
        _ => TeamsListViewText.ActionReduceOwners
    };

    /// <inheritdoc cref="SetOwnerActionLabel"/>
    private static TextKey SetOwnerDialogTitle(int ownerCount) => ownerCount switch
    {
        0 => TeamsListViewText.AssignOwnerTitle,
        1 => TeamsListViewText.ChangeOwnerTitle,
        _ => TeamsListViewText.ReduceOwnersTitle
    };
}
