@using System.Text.Json
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@using Tharga.Team
@using Tharga.Team.Blazor.Framework
@using Tharga.Toolkit
@inject IJSRuntime JS
@inject IUserService UserService
@inject IServiceProvider ServiceProvider
@inject IconSettings IconSettings
@inject DialogService DialogService
@inject IThargaTextProvider TextProvider

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized>
            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                <RadzenCard>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                        <UserAvatar User="_user" Size="64px" />
                        <RadzenStack Gap="0.25rem">
                            @if (_editingName)
                            {
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenTextBox Value="@_editedName" ValueChanged="@(v => _editedName = v)" Placeholder="@_text[UserProfileViewText.YourName]" />
                                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Small"
                                                  Click="SaveName" title="@_text[UserProfileViewText.Save]" />
                                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                                                  Click="@(() => _editingName = false)" title="@_text[UserProfileViewText.Cancel]" />
                                </RadzenStack>
                            }
                            else
                            {
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0"><strong>@(_user?.Name ?? context.User.GetEmail())</strong></RadzenText>
                                    <RadzenButton Icon="edit" Variant="Variant.Text" Size="ButtonSize.Small"
                                                  Click="StartNameEdit" title="@_text[UserProfileViewText.EditName]" />
                                </RadzenStack>
                            }
                            <RadzenText TextStyle="TextStyle.Caption">@(_user?.EMail ?? context.User.GetEmail())</RadzenText>
                            @{
                                var roles = ProfileRoles.Read(context.User);
                            }
                            @if (roles.Any)
                            {
                                @* Roles are what people open this page to check, so they are visible here rather
                                   than behind the collapsed Claims card, keyed by a schema URI. That card stays
                                   exactly as it was -- this is an addition. *@
                                <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    @foreach (var role in roles.App)
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Variant="Variant.Flat" Text="@role" class="rz-mr-1 rz-mb-1" />
                                    }
                                    @foreach (var role in roles.Team)
                                    {
                                        @* A different style, because these follow the team selector rather than
                                           the person -- see ProfileRoles. *@
                                        <RadzenBadge BadgeStyle="BadgeStyle.Info" Variant="Variant.Flat" Text="@role" class="rz-mr-1 rz-mb-1"
                                                     title="@_text[UserProfileViewText.TeamRoleTooltip]" />
                                    }
                                </RadzenStack>
                                @if (roles.Team.Length > 0)
                                {
                                    <RadzenText TextStyle="TextStyle.Caption">@_text[UserProfileViewText.TeamRolesCaption]</RadzenText>
                                }
                            }
                            @if (_canUpload)
                            {
                                <RadzenButton Text="@_text[UserProfileViewText.ChangePicture]" Icon="photo_camera" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="ChangePicture" />
                            }
                            @if (!string.IsNullOrEmpty(_user?.Icon))
                            {
                                <RadzenText TextStyle="TextStyle.Caption">@_text[UserProfileViewText.UsingUploadedPicture]</RadzenText>
                            }
                            else if (IconSettings.GravatarEnabled)
                            {
                                <RadzenText TextStyle="TextStyle.Caption">
                                    @_text[_canUpload ? UserProfileViewText.GravatarCanUpload : UserProfileViewText.GravatarNoUpload]
                                    <RadzenLink Path="https://gravatar.com/" Target="gravatar" Text="@_text[UserProfileViewText.GravatarLink]" />
                                </RadzenText>
                            }
                        </RadzenStack>
                    </RadzenStack>
                </RadzenCard>
                @if (ShowAccessCard)
                {
                    <AccessSimulationCard />
                }
                <ExpandableCard Icon="work" Text="@_text[UserProfileViewText.Claims]">
                    <ChildContent>
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" class="rz-mb-2">
                            <RadzenButton Icon="content_copy" Text="@_text[UserProfileViewText.CopyAsJson]" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                          Click="@(() => CopyClaimsAsync(context.User))" />
                        </RadzenStack>
                        <ul style="word-break: break-all; overflow-wrap: break-word;">
                            @foreach (var claim in context.User.Claims)
                            {
                                <li><strong>@claim.Type:</strong> @claim.Value</li>
                            }
                        </ul>
                    </ChildContent>
                </ExpandableCard>
            </RadzenStack>
        </Authorized>
        <NotAuthorized>
            <RadzenText>@_text[UserProfileViewText.NotAuthorized]</RadzenText>
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

@code {
    /// <summary>
    /// Whether the built-in access card — demo mode and "view as another user" — is rendered between the
    /// profile details and Claims. Default true.
    /// </summary>
    /// <remarks>
    /// <b>Presentation only, and it draws nothing unless access simulation is switched on.</b> The card
    /// suppresses itself when <c>o.Blazor.Simulation.Enabled</c> is false or the caller cannot simulate, so
    /// a host that does not use the feature is unaffected without setting this.
    /// <para>
    /// Set it false only to place <c>&lt;AccessSimulationCard /&gt;</c> somewhere else yourself — two
    /// copies on one page would each carry their own way out, which reads as a bug rather than as
    /// redundancy.
    /// </para>
    /// </remarks>
    [Parameter] public bool ShowAccessCard { get; set; } = true;

    private IUser _user;
    private bool _canUpload;
    private bool _editingName;
    private string _editedName;
    private TextSet _text = TextSet.Empty;

    protected override async Task OnInitializedAsync()
    {
        _text = await TextProvider.ResolveAsync(UserProfileViewText.All);
        _user = await UserService.GetCurrentUserAsync();
        _canUpload = IconSettings.AllowUserUpload && ServiceProvider.GetService<IIconStore>() != null;
    }

    private void StartNameEdit()
    {
        _editedName = _user?.Name;
        _editingName = true;
    }

    /// <summary>
    /// Writes the caller's own <see cref="IUser.Name"/> — the root name, shared across every team.
    /// Per-team display names are overrides set by a team administrator and are untouched here.
    /// </summary>
    private async Task SaveName()
    {
        var trimmed = string.IsNullOrWhiteSpace(_editedName) ? null : _editedName.Trim();
        if (trimmed == _user?.Name)
        {
            _editingName = false;
            return;
        }

        await UserService.SetUserNameAsync(_user.Key, trimmed);
        _user = await UserService.GetCurrentUserAsync();
        _editingName = false;
    }

    private async Task ChangePicture()
    {
        var result = await DialogService.OpenAsync<UserIconDialog>(_text[UserProfileViewText.ProfilePictureTitle],
            new Dictionary<string, object> { { nameof(UserIconDialog.HasIcon), !string.IsNullOrEmpty(_user?.Icon) } },
            new DialogOptions { Width = "480px" });

        if (result is true)
        {
            _user = await UserService.GetCurrentUserAsync();
            StateHasChanged();
        }
    }

    private async Task CopyClaimsAsync(System.Security.Claims.ClaimsPrincipal principal)
    {
        var data = new
        {
            IdentityName = principal.Identity?.Name,
            AuthenticationType = principal.Identity?.AuthenticationType,
            Claims = principal.Claims.Select(c => new { c.Type, c.Value }).ToArray()
        };
        var json = JsonSerializer.Serialize(data, new JsonSerializerOptions { WriteIndented = true });
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", json);
    }
}
