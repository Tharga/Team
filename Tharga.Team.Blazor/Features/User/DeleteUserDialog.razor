@inject DialogService DialogService
@inject IUserManagementService UserManagementService
@inject IThargaTextProvider TextProvider

@*
    Confirmation for the user-delete flow. The local delete (all team memberships + the user record)
    always happens; deleting from the external directory is an explicit opt-in, off by default, because
    it removes the account org-wide — not just from this application. When a directory is registered,
    the dialog verifies the user against it on open, so the text states whether the account still
    exists there — and the opt-in is not offered when there is nothing to delete (already gone) or no
    directory match.
*@
<RadzenStack Gap="1rem">
    <RadzenText TextStyle="TextStyle.Body1">@_text.Format(DeleteUserDialogText.Intro, UserName)</RadzenText>

    @if (_ownedTeams is { Count: > 0 })
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat" AllowClose="false">
            @* One key per plural form, each a whole sentence. The three interleaved ternaries this
               replaces could not be translated: the clauses reorder, and the count changes agreement
               elsewhere in the sentence. Both variants take the same arguments in the same order. *@
            <RadzenText TextStyle="TextStyle.Body2">
                @_text.Format(_ownedTeams.Count == 1 ? DeleteUserDialogText.OwnsOneTeam : DeleteUserDialogText.OwnsManyTeams,
                              UserName, _ownedTeams.Count, SystemTeamScopes.AssignOwner)
            </RadzenText>
            <ul>
                @foreach (var team in _ownedTeams)
                {
                    <li>@(team.Name ?? team.Key)</li>
                }
            </ul>
            <RadzenText TextStyle="TextStyle.Body2">
                @_text[_ownedTeams.Count == 1 ? DeleteUserDialogText.TransferOneFirst : DeleteUserDialogText.TransferManyFirst]
            </RadzenText>
        </RadzenAlert>
    }

    @if (ShowDirectoryOption)
    {
        @if (_checking)
        {
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" Style="width: 20px; height: 20px;" ShowValue="false" />
                <RadzenText TextStyle="TextStyle.Caption">@_text[DeleteUserDialogText.CheckingDirectory]</RadzenText>
            </RadzenStack>
        }
        else if (_directoryStatus == DirectoryUserStatus.NotFound)
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat" AllowClose="false">
                @_text[DeleteUserDialogText.DirectoryNotFound]
            </RadzenAlert>
        }
        else if (_directoryStatus == DirectoryUserStatus.NotLinked)
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat" AllowClose="false">
                @_text[DeleteUserDialogText.DirectoryNotLinked]
            </RadzenAlert>
        }
        else
        {
            @if (_directoryStatus == DirectoryUserStatus.Disabled)
            {
                <RadzenText TextStyle="TextStyle.Caption">@_text[DeleteUserDialogText.DirectoryDisabled]</RadzenText>
            }
            else if (_directoryStatus == DirectoryUserStatus.Found)
            {
                <RadzenText TextStyle="TextStyle.Caption">@_text[DeleteUserDialogText.DirectoryFound]</RadzenText>
            }
            else if (_checkError != null)
            {
                <RadzenText TextStyle="TextStyle.Caption">@_text.Format(DeleteUserDialogText.DirectoryCheckFailed, _checkError)</RadzenText>
            }

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenCheckBox @bind-Value="_alsoDeleteFromDirectory" Name="alsoDeleteFromDirectory" TValue="bool" />
                <RadzenLabel Text="@_text[DeleteUserDialogText.AlsoDeleteFromDirectory]" Component="alsoDeleteFromDirectory" />
            </RadzenStack>

            @if (_alsoDeleteFromDirectory)
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat" AllowClose="false">
                    @_text[DeleteUserDialogText.DirectoryWarning]
                </RadzenAlert>
            }
        }
    }

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
        <RadzenButton Text="@_text[DeleteUserDialogText.Delete]" ButtonStyle="ButtonStyle.Danger" Click="@(() => DialogService.Close(_alsoDeleteFromDirectory))" />
        <RadzenButton Text="@_text[DeleteUserDialogText.Cancel]" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Click="@(() => DialogService.Close(null))" />
    </RadzenStack>
</RadzenStack>

@code {
    /// <summary>Display name of the user about to be deleted.</summary>
    [Parameter] public string UserName { get; set; }

    /// <summary>Key of the user about to be deleted — used to verify against the directory on open.</summary>
    [Parameter] public string UserKey { get; set; }

    /// <summary>Whether directory features apply (a directory service is registered).</summary>
    [Parameter] public bool ShowDirectoryOption { get; set; }

    private bool _alsoDeleteFromDirectory;
    private bool _checking;
    private DirectoryUserStatus? _directoryStatus;
    private string _checkError;
    private IReadOnlyList<ITeam> _ownedTeams;
    private TextSet _text = TextSet.Empty;

    protected override async Task OnInitializedAsync()
    {
        _text = await TextProvider.ResolveAsync(DeleteUserDialogText.All);

        // Best-effort, and deliberately silent on failure. This warning improves a confirmation that
        // already works; a store that cannot answer it must not block the delete behind an error.
        if (!string.IsNullOrEmpty(UserKey))
        {
            try
            {
                _ownedTeams = await UserManagementService.GetOwnedTeamsAsync(UserKey);
            }
            catch
            {
                _ownedTeams = null;
            }
        }

        if (ShowDirectoryOption && !string.IsNullOrEmpty(UserKey))
        {
            _checking = true;
            try
            {
                var result = await UserManagementService.VerifyUserAsync(UserKey);
                _directoryStatus = result?.Status;
            }
            catch (Exception ex)
            {
                _checkError = ex.Message;
            }
            finally
            {
                _checking = false;
            }
        }

        await base.OnInitializedAsync();
    }
}
