@using Tharga.Team.Blazor.Framework
@inject IUserMailPreferenceService Preferences
@inject IUserService UserService
@inject NotificationService NotificationService

@* Which categories of mail a user receives. A required category shows as always on with why; an optional one is a
   switch that saves at once. The service checks that the reader is this user or holds users:manage. *@

<RadzenCard>
    @if (!_ready)
    {
        <Loading />
    }
    else if (_userKey == null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter">
            @_text[UserMailPreferencesViewText.NoUser]
        </RadzenAlert>
    }
    else if (!_permitted)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter">
            @_text[UserMailPreferencesViewText.NotPermitted]
        </RadzenAlert>
    }
    else
    {
        <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">@_text[UserMailPreferencesViewText.Title]</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@_text[UserMailPreferencesViewText.Explanation]</RadzenText>

            @foreach (var choice in _choices)
            {
                var category = choice.Category;
                var description = Description(category);

                <RadzenStack @key="@($"{category.Key}:{_revision}")" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.75rem" data-category="@category.Key">
                    <RadzenSwitch Value="@choice.Receives" Disabled="@(category.Required || _busy)" Change="@(value => SetAsync(category, value))"
                                  aria-label="@Name(category)" />
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenText TextStyle="TextStyle.Body1" class="rz-m-0"><strong>@Name(category)</strong></RadzenText>
                        @if (description != null)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">@description</RadzenText>
                        }
                        @if (category.Required)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0" data-required="@category.Key">
                                @if (_termsUrl != null)
                                {
                                    <a href="@_termsUrl">@_text[UserMailText.AlwaysSent]</a>
                                }
                                else
                                {
                                    @_text[UserMailText.AlwaysSent]
                                }
                            </RadzenText>
                        }
                    </RadzenStack>
                </RadzenStack>
            }
        </RadzenStack>
    }
</RadzenCard>

@code {
    [Inject] private IThargaTextProvider TextProvider { get; set; }

    /// <summary>Whose choices are shown and changed; the signed-in user's when not set, and another user's only with <c>users:manage</c>.</summary>
    [Parameter] public string UserKey { get; set; }

    private TextSet _text = TextSet.Empty;
    private IReadOnlyList<UserMailChoice> _choices = [];
    private string _loadedFor;
    private string _userKey;
    private bool _ready;
    private bool _permitted = true;
    private bool _busy;
    private int _revision;
    private string _termsUrl;

    protected override async Task OnParametersSetAsync()
    {
        if (_ready && _loadedFor == UserKey) return;

        _loadedFor = UserKey;
        _ready = false;
        _permitted = true;
        _choices = [];
        _termsUrl = Preferences.GetTermsUrl();

        _userKey = string.IsNullOrWhiteSpace(UserKey) ? (await UserService.GetCurrentUserAsync())?.Key : UserKey;

        if (_userKey != null)
        {
            try
            {
                _choices = await Preferences.GetChoicesAsync(_userKey);
            }
            catch (UnauthorizedAccessException)
            {
                _permitted = false;
            }
        }

        _text = await TextProvider.ResolveAsync([.. UserMailPreferencesViewText.All, UserMailText.AlwaysSent, .. _choices.SelectMany(x => CategoryKeys(x.Category))]);
        _ready = true;
    }

    private async Task SetAsync(UserMailCategory category, bool receives)
    {
        _busy = true;
        try
        {
            var changed = await Preferences.SetChoiceAsync(_userKey, category.Key, receives);
            _choices = [.. _choices.Select(x => x.Category.Key == category.Key ? changed : x)];
        }
        catch (UnauthorizedAccessException)
        {
            _revision++;
            NotificationService.Notify(NotificationSeverity.Warning, _text[UserMailPreferencesViewText.NotPermitted]);
        }
        catch (Exception)
        {
            _revision++;
            NotificationService.Notify(NotificationSeverity.Error, _text[UserMailPreferencesViewText.SaveFailed]);
        }
        finally
        {
            _busy = false;
        }
    }

    private string Name(UserMailCategory category) => _text[new TextKey(category.NameKey, category.Name)];

    private string Description(UserMailCategory category)
        => string.IsNullOrWhiteSpace(category.Description) ? null : _text[new TextKey(category.DescriptionKey, category.Description)];

    private static IEnumerable<TextKey> CategoryKeys(UserMailCategory category)
    {
        yield return new TextKey(category.NameKey, category.Name);
        if (!string.IsNullOrWhiteSpace(category.Description)) yield return new TextKey(category.DescriptionKey, category.Description);
    }
}
