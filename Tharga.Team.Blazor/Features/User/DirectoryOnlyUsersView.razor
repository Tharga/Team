@implements IDisposable
@inject IUserManagementService UserManagementService
@inject NotificationService NotificationService
@inject IThargaTextProvider TextProvider

@*
    Users that exist in the external directory but have no local user record. Loaded on demand only —
    a tenant's directory can be large, so nothing is fetched until asked, and results stream in as
    directory pages arrive.
*@
<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" class="rz-mb-3 rz-mt-2">
    <RadzenButton Text="@_text[_loadedOnce ? DirectoryOnlyUsersViewText.Refresh : DirectoryOnlyUsersViewText.Load]" Icon="refresh" Click="@LoadAsync" Disabled="@_loading" />
    @if (_loading)
    {
        <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" Style="width: 24px; height: 24px;" ShowValue="false" />
    }
    @if (_loadedOnce && !_loading)
    {
        <RadzenText TextStyle="TextStyle.Caption">@_text.Format(DirectoryOnlyUsersViewText.FoundCount, _users.Count)</RadzenText>
    }
</RadzenStack>

@if (_loadedOnce || _loading)
{
    <RadzenDataGrid Data="@_users" TItem="DirectoryUser" AllowSorting="true" AllowPaging="true" PageSize="10">
        <Columns>
            <RadzenDataGridColumn Title="" Width="66px" Sortable="false" Filterable="false">
                <Template>
                    <UserAvatar EMail="@context.EMail" Name="@context.Name" Size="32px" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="@_text[DirectoryOnlyUsersViewText.ColumnName]" Property="@nameof(DirectoryUser.Name)" />
            <RadzenDataGridColumn Title="@_text[DirectoryOnlyUsersViewText.ColumnEmail]" Property="@nameof(DirectoryUser.EMail)" />
            <RadzenDataGridColumn Title="@_text[DirectoryOnlyUsersViewText.ColumnStatus]" Sortable="false" Filterable="false" Width="120px">
                <Template>
                    @if (context.Enabled == false)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Warning" Variant="Variant.Flat" Text="@_text[DirectoryOnlyUsersViewText.StatusDisabled]" />
                    }
                    else
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Variant="Variant.Flat" Text="@_text[DirectoryOnlyUsersViewText.StatusEnabled]" />
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
else
{
    <RadzenText TextStyle="TextStyle.Body2">@_text[DirectoryOnlyUsersViewText.EmptyPrompt]</RadzenText>
}

@code {
    // Reassigned, never mutated in place: RadzenDataGrid keys its view off the Data reference.
    private List<DirectoryUser> _users = [];
    private bool _loading;
    private bool _loadedOnce;
    private CancellationTokenSource _cancellation;
    private TextSet _text = TextSet.Empty;

    protected override async Task OnInitializedAsync()
    {
        _text = await TextProvider.ResolveAsync(DirectoryOnlyUsersViewText.All);
        await base.OnInitializedAsync();
    }

    private async Task LoadAsync()
    {
        _cancellation?.Cancel();
        _cancellation = new CancellationTokenSource();
        var token = _cancellation.Token;

        var loaded = new List<DirectoryUser>();
        _users = [];
        _loading = true;
        try
        {
            await foreach (var user in UserManagementService.GetDirectoryOnlyUsersAsync(token))
            {
                loaded.Add(user);
                if (loaded.Count % 25 == 0)
                {
                    _users = [.. loaded];
                    StateHasChanged();
                }
            }

            _users = [.. loaded];
            _loadedOnce = true;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, _text[DirectoryOnlyUsersViewText.NotifyFailed], ex.Message);
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _loading = false;
                StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        _cancellation?.Cancel();
        _cancellation?.Dispose();
    }
}
