@using System.Net.Http
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Options
@using Tharga.Team
@using Tharga.Team.Blazor.Framework
@inject IUserService UserService
@inject IHttpClientFactory HttpClientFactory
@inject IOptions<IconOptions> IconOptions
@inject IIconProcessor IconProcessor
@inject AvatarChangeNotifier AvatarChangeNotifier
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IThargaTextProvider TextProvider

@*
    Sets the current user's own icon (self-service) from a file upload or an image URL, or removes it —
    an alternative to the Gravatar fallback. Goes through IUserService.SetOwnIconAsync / ClearOwnIconAsync
    and the pluggable IIconStore.
*@
<RadzenStack Gap="1rem">
    <RadzenText TextStyle="TextStyle.Body2">@_text.Format(_canDownscale ? UserIconDialogText.IntroDownscale : UserIconDialogText.IntroNoDownscale, _maxUploadMb)</RadzenText>

    <RadzenStack Gap="0.25rem">
        <RadzenLabel Text="@_text[UserIconDialogText.UploadFile]" />
        <InputFile OnChange="OnFileSelected" accept="image/*" disabled="@_busy" />
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.5rem">
        <RadzenStack Gap="0.25rem" Style="flex:1;">
            <RadzenLabel Text="@_text[UserIconDialogText.OrImageUrl]" />
            <RadzenTextBox @bind-Value="_url" Placeholder="https://…/photo.png" Style="width:100%;" Disabled="@_busy" />
        </RadzenStack>
        <RadzenButton Text="@_text[UserIconDialogText.Download]" Icon="download" Click="OnFetchUrl" Disabled="@(_busy || string.IsNullOrWhiteSpace(_url))" />
    </RadzenStack>

    @if (_busy)
    {
        <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" Style="width:24px;height:24px;" ShowValue="false" />
    }

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <div>
            <RadzenButton Text="@_text[UserIconDialogText.UseGravatar]" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Click="OnRemove" Visible="@HasIcon" Disabled="@_busy" title="@_text[UserIconDialogText.UseGravatarTooltip]" />
        </div>
        <RadzenButton Text="@_text[UserIconDialogText.Close]" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Click="@(() => DialogService.Close(_changed))" />
    </RadzenStack>
</RadzenStack>

@code {
    /// <summary>Whether the user currently has an uploaded icon (controls the Use-Gravatar button).</summary>
    [Parameter] public bool HasIcon { get; set; }

    /// <summary>When set, an administrator is setting this user's icon (requires users:manage); otherwise self-service.</summary>
    [Parameter] public string AdminUserKey { get; set; }

    private string _url;
    private bool _busy;
    private bool _changed;
    private int _maxUploadMb;

    // The default NoOpIconProcessor does not resize, so promising automatic downscaling
    // without a real one tells the user something false — oversized uploads are rejected.
    private bool _canDownscale;
    private TextSet _text = TextSet.Empty;

    protected override async Task OnInitializedAsync()
    {
        _text = await TextProvider.ResolveAsync(UserIconDialogText.All);
        _maxUploadMb = Math.Max(1, IconOptions.Value.MaxUploadBytes / (1024 * 1024));
        _canDownscale = IconCapability.CanProcessImages(IconProcessor);

        await base.OnInitializedAsync();
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        _busy = true;
        try
        {
            using var stream = new MemoryStream();
            await file.OpenReadStream(IconOptions.Value.MaxUploadBytes).CopyToAsync(stream);
            await SaveAsync(stream.ToArray(), file.ContentType);
        }
        catch (Exception ex) { NotifyError(ex); }
        finally { _busy = false; }
    }

    private async Task OnFetchUrl()
    {
        if (string.IsNullOrWhiteSpace(_url)) return;

        _busy = true;
        try
        {
            var client = HttpClientFactory.CreateClient(Tharga.Team.Blazor.Framework.ThargaTeamRegistration.IconHttpClientName);
            using var response = await client.GetAsync(_url);
            response.EnsureSuccessStatusCode();
            var contentType = response.Content.Headers.ContentType?.MediaType ?? "application/octet-stream";
            var bytes = await response.Content.ReadAsByteArrayAsync();
            await SaveAsync(bytes, contentType);
        }
        catch (Exception ex) { NotifyError(ex); }
        finally { _busy = false; }
    }

    private async Task SaveAsync(byte[] data, string contentType)
    {
        if (string.IsNullOrEmpty(AdminUserKey))
        {
            await UserService.SetOwnIconAsync(data, contentType);
            AvatarChangeNotifier.Notify();
        }
        else
        {
            await UserService.SetUserIconAsync(AdminUserKey, data, contentType);
        }

        _changed = true;
        NotificationService.Notify(NotificationSeverity.Success, _text[UserIconDialogText.NotifyUpdated]);
        DialogService.Close(true);
    }

    private async Task OnRemove()
    {
        _busy = true;
        try
        {
            if (string.IsNullOrEmpty(AdminUserKey))
            {
                await UserService.ClearOwnIconAsync();
                AvatarChangeNotifier.Notify();
            }
            else
            {
                await UserService.ClearUserIconAsync(AdminUserKey);
            }

            _changed = true;
            NotificationService.Notify(NotificationSeverity.Success, _text[UserIconDialogText.NotifyReverted]);
            DialogService.Close(true);
        }
        catch (Exception ex) { NotifyError(ex); }
        finally { _busy = false; }
    }

    private void NotifyError(Exception ex) => NotificationService.Notify(NotificationSeverity.Error, _text[UserIconDialogText.NotifyFailed], ex.Message);
}
