@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@using Tharga.Team.Blazor.Features.Team
@typeparam TMember where TMember : class, Tharga.Team.ITeamMember
@inject ITeamDirectoryService TeamDirectoryService
@inject ITeamOversightService TeamOversightService
@inject IUserService UserService
@inject IUserManagementService UserManagementService
@inject IServiceProvider ServiceProvider
@inject AuthenticationStateProvider AuthStateProvider
@inject IconSettings IconSettings
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IJSRuntime Js
@inject IThargaTextProvider TextProvider

@* Current-user row highlight. Applied to the cells (not the <tr>) so Radzen's own cell backgrounds
   don't paint over it — the same mechanism TeamComponent uses for its member grid. *@
<style>
    tr[data-tharga-current-user] > td {
        background-color: rgba(37, 99, 235, 0.16) !important;
    }

    tr[data-tharga-current-user] > td:first-child {
        box-shadow: inset 3px 0 0 0 var(--rz-primary, #2563eb);
    }
</style>

@if (!_canAdminister)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat" AllowClose="false" class="rz-mt-2">
        Viewing users requires the <b>@SystemUserScopes.Manage</b> system scope.
    </RadzenAlert>
}
else if (_loaded)
{
    @if (_showDirectory)
    {
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-3 rz-mt-2">
            <RadzenButton Text="@_text[UsersListViewText.VerifyAll]" Icon="how_to_reg" ButtonStyle="ButtonStyle.Light" Click="@VerifyAllAsync" Disabled="@_verifying" />
        </RadzenStack>
    }
    <RadzenDataGrid Data="@_allUsers" TItem="UserViewModel" AllowSorting="true" AllowPaging="true" PageSize="10"
                    AllowFiltering="true" FilterMode="FilterMode.Simple" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                    RowRender="@OnUserRowRender">
        <Columns>
            <RadzenDataGridColumn Title="" Width="66px" Sortable="false" Filterable="false">
                <Template>
                    <UserAvatar EMail="@context.EMail" IconReference="@context.Icon" Name="@context.Name" UserKey="@context.Key" Size="32px" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="@_text[UsersListViewText.ColumnName]" Property="Name" />
            <RadzenDataGridColumn Title="@_text[UsersListViewText.ColumnEmail]" Property="EMail" />
            <RadzenDataGridColumn Title="@_text[UsersListViewText.ColumnTeams]" Property="@nameof(UserViewModel.TeamCount)" Filterable="false" />
            <RadzenDataGridColumn Title="@_text[UsersListViewText.ColumnLastSeen]" Property="@nameof(UserViewModel.LastSeen)" Filterable="false">
                <Template>
                    @if (LastSeenText.IsNever(context.LastSeen))
                    {
                        <RadzenText TextStyle="TextStyle.Caption">@LastSeenText.Never</RadzenText>
                    }
                    else
                    {
                        <DateTimeView Date="@context.LastSeen" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="" Width="200px" Sortable="false" Filterable="false">
                <Template>
                    @{
                        var canDeleteUser = UserAdminGate.CanDeleteUser(context.Key, _currentUserKey);
                        var canDisableUser = UserAdminGate.CanDisableUser(context.Key, _currentUserKey);
                    }
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                        @* Two badges, never one. This is "blocked from this application"; the directory
                           badge beside it is "blocked from the organization". They are independent and can
                           disagree, and an operator who reads one as the other draws the wrong conclusion
                           in both directions. *@
                        @if (context.IsDisabled)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Danger" Variant="Variant.Filled" Text="@_text[UsersListViewText.BadgeDisabled]"
                                         title="@GetDisabledText(context)" />
                        }
                        @if (_showDirectory && context.DirectoryStatus != null)
                        {
                            <RadzenBadge BadgeStyle="@(Enum.Parse<BadgeStyle>(DirectoryStatusBadge.Style(context.DirectoryStatus.Value)))"
                                         Variant="Variant.Flat" Text="@DirectoryStatusBadge.Text(context.DirectoryStatus.Value)" />
                        }
                        <RadzenSplitButton Text="@_text[UsersListViewText.ActionView]" Icon="visibility" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                           Click="@(item => OnUserActionAsync(item, context))">
                            <ChildContent>
                                @if (_showDirectory)
                                {
                                    <RadzenSplitButtonItem Text="@_text[UsersListViewText.ActionVerify]" Value="@VerifyAction" Icon="person_search" />
                                }
                                <RadzenSplitButtonItem Text="@_text[UsersListViewText.ActionRename]" Value="@RenameAction" Icon="edit" />
                                @if (_showAdminUpload)
                                {
                                    <RadzenSplitButtonItem Text="@_text[UsersListViewText.ActionSetIcon]" Value="@SetIconAction" Icon="image" />
                                }
                                @if (UserAdminGate.CanReadAudit(ShowAuditLogButton, _canReadAudit))
                                {
                                    <RadzenSplitButtonItem Text="@_text[UsersListViewText.ActionAuditLog]" Value="@AuditAction" Icon="manage_search" />
                                }
                                @ActionItems
                                @if (context.IsDisabled)
                                {
                                    <RadzenSplitButtonItem Text="@_text[UsersListViewText.ActionEnable]" Value="@EnableAction" Icon="play_circle" />
                                }
                                else
                                {
                                    <RadzenSplitButtonItem Text="@(canDisableUser ? _text[UsersListViewText.ActionDisable] : _text[UsersListViewText.ActionDisableSelf])" Value="@DisableAction"
                                                           Icon="block" Disabled="@(!canDisableUser)" />
                                }
                                <RadzenSplitButtonItem Text="@(canDeleteUser ? _text[UsersListViewText.ActionDelete] : _text[UsersListViewText.ActionDeleteSelf])" Value="@DeleteAction"
                                                       Icon="delete" Disabled="@(!canDeleteUser)" />
                            </ChildContent>
                        </RadzenSplitButton>
                        @if (ActionsTemplate != null)
                        {
                            @ActionsTemplate(context)
                        }
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

    @if (_selectedUser != null)
    {
        <RadzenCard class="rz-mt-3">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-2">
                <UserAvatar EMail="@_selectedUser.EMail" IconReference="@_selectedUser.Icon" Name="@_selectedUser.Name" UserKey="@_selectedUser.Key" Size="48px" />
                <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                    <RadzenText TextStyle="TextStyle.Subtitle1"><strong>@(_selectedUser.Name ?? _selectedUser.EMail)</strong></RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption">@_selectedUser.EMail</RadzenText>
                </RadzenStack>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-2">
                <RadzenText TextStyle="TextStyle.Caption">@_text[UsersListViewText.UserKey]</RadzenText>
                <code>@_selectedUser.Key</code>
                <RadzenButton Icon="content_copy" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                              title="@_text[UsersListViewText.CopyUserKey]" Click="@(() => CopyAsync(_selectedUser.Key))" />
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-2">
                <RadzenText TextStyle="TextStyle.Caption">@_text[UsersListViewText.Identity]</RadzenText>
                <code>@_selectedUser.Identity</code>
                <RadzenButton Icon="content_copy" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                              title="@_text[UsersListViewText.CopyIdentity]" Click="@(() => CopyAsync(_selectedUser.Identity))" />
            </RadzenStack>
            @*
                Directory id is opt-in twice over — the host's entity must declare it, and the user must
                have been resolved since. Rendering an empty row would read as "no directory account",
                which is a different and alarming claim, so say which of the two applies.
            *@
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-2">
                <RadzenText TextStyle="TextStyle.Caption">@_text[UsersListViewText.DirectoryId]</RadzenText>
                @if (string.IsNullOrEmpty(_selectedUser.DirectoryId))
                {
                    <RadzenText TextStyle="TextStyle.Caption" title="@DirectoryLink.AbsenceHint(_directoryIdStored)">
                        <em>@DirectoryLink.AbsenceText(_directoryIdStored)</em>
                    </RadzenText>
                }
                else
                {
                    <code>@_selectedUser.DirectoryId</code>
                    <RadzenButton Icon="content_copy" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                  title="@_text[UsersListViewText.CopyDirectoryId]" Click="@(() => CopyAsync(_selectedUser.DirectoryId))" />
                }
            </RadzenStack>
            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">@_text[UsersListViewText.TeamMemberships]</RadzenText>
            <RadzenDataGrid Data="@_selectedUser.Teams" TItem="UserTeamInfo" AllowSorting="true">
                <Columns>
                    <RadzenDataGridColumn Title="@_text[UsersListViewText.ColumnTeam]" Property="TeamName">
                        <Template>
                            @if (TeamSelected.HasDelegate && !string.IsNullOrEmpty(context.TeamKey))
                            {
                                <RadzenButton Text="@context.TeamName" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text"
                                              Size="ButtonSize.Small" title="@_text[UsersListViewText.ShowThisTeam]"
                                              Click="@(() => TeamSelected.InvokeAsync(context.TeamKey))" />
                            }
                            else
                            {
                                @context.TeamName
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Title="@_text[UsersListViewText.ColumnRole]" Property="AccessLevel" Width="120px" />
                    <RadzenDataGridColumn Title="@_text[UsersListViewText.ColumnState]" Property="State" Width="100px" />
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    }
}
else
{
    <Loading />
}

@code {
    /// <summary>
    /// Optional template rendered after the built-in split button in each user row's action column.
    /// Use to inject row-level actions (edit, custom links) without forking the component.
    /// </summary>
    [Parameter] public RenderFragment<UserViewModel> ActionsTemplate { get; set; }

    /// <summary>
    /// Optional extra items appended to each row's split-button dropdown — supply
    /// <c>RadzenSplitButtonItem</c> components with distinct <c>Value</c>s. Clicks are delivered via
    /// <see cref="ActionInvoked"/> with the item's Value and the row's user.
    /// </summary>
    [Parameter] public RenderFragment ActionItems { get; set; }

    /// <summary>Raised when a consumer-supplied split-button item (<see cref="ActionItems"/>) is clicked.</summary>
    [Parameter] public EventCallback<UserRowAction> ActionInvoked { get; set; }

    /// <summary>
    /// Show a per-row action opening the audit log scoped to that user. Off by default — the audit log is
    /// only queryable when audit storage is configured, so a host opts in once it is.
    /// </summary>
    [Parameter] public bool ShowAuditLogButton { get; set; }

    /// <summary>
    /// Key of the user to expand when the view first renders. Lets a host (or the sibling teams tab)
    /// arrive with one user already open.
    /// </summary>
    [Parameter] public string FocusUserKey { get; set; }

    /// <summary>Raised when a team is clicked in a user's membership list, carrying that team's key.</summary>
    [Parameter] public EventCallback<string> TeamSelected { get; set; }

    private const string VerifyAction = "verify";
    private const string DeleteAction = "delete";
    private const string SetIconAction = "set-icon";
    private const string RenameAction = "rename";
    private const string AuditAction = "audit";
    private const string DisableAction = "disable";
    private const string EnableAction = "enable";

    private string _currentUserKey;
    private bool _directoryIdStored;
    private bool _loaded;
    private bool _canAdminister = true;
    private bool _canReadAudit;
    private bool _showDirectory;
    private bool _showAdminUpload;
    private bool _verifying;
    private IUser[] _users;
    private ITeam<TMember>[] _teams;
    private bool _canSeeAllTeams;

    private List<UserViewModel> _allUsers = new();
    private UserViewModel _selectedUser;
    private TextSet _text = TextSet.Empty;

    protected override async Task OnInitializedAsync()
    {
        _text = await TextProvider.ResolveAsync(UsersListViewText.All);

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var hasUsersManage = TeamScopeGate.HasSystemScope(authState.User, SystemUserScopes.Manage);

        // The audit action is cross-team from here -- this list spans every team -- so it needs the
        // system grant. Without this the action appeared for anyone whenever the host set the flag, and
        // the dialog it opened said "Access denied": shown-then-refused, the defect PR #126 fixed for
        // per-team actions. TeamComponent already gated its equivalent; this surface did not.
        _canReadAudit = TeamScopeGate.HasSystemScope(authState.User, AuditScopes.Read);

        var directoryRegistered = ServiceProvider.GetService<IUserDirectoryService>() is { IsConfigured: true };
        _canSeeAllTeams = TeamVisibility.CanSeeAllTeams(authState.User);
        _canAdminister = UserAdminGate.CanAdministerUsers(hasUsersManage);
        _showDirectory = UserAdminGate.ShowDirectoryFeatures(hasUsersManage, directoryRegistered);
        _showAdminUpload = hasUsersManage && IconSettings.AllowAdminUpload && ServiceProvider.GetService<IIconStore>() != null;

        if (_canAdminister)
        {
            _currentUserKey = (await UserService.GetCurrentUserAsync())?.Key;
            await LoadDataAsync();
            _selectedUser = _allUsers.FirstOrDefault(u => u.Key == FocusUserKey);
            _loaded = true;
        }

        await base.OnInitializedAsync();
    }

    /// <summary>
    /// Opens the user that a sibling surface asked to focus. Runs on parameter changes rather than only at
    /// initialization, because the tab is already rendered when the teams tab hands a user key across.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(FocusUserKey) || _selectedUser?.Key == FocusUserKey) return;

        var focused = _allUsers.FirstOrDefault(u => u.Key == FocusUserKey);
        if (focused != null) _selectedUser = focused;
    }

    private void OnUserRowRender(RowRenderEventArgs<UserViewModel> args)
    {
        if (MemberHighlight.IsCurrentMember(args.Data?.Key, _currentUserKey))
        {
            // Marker attribute only — the tint is applied to the cells (see the <style> block above),
            // because Radzen's <td> cells carry their own background and paint over a row-level style.
            args.Attributes["data-tharga-current-user"] = "true";
        }
    }

    private async Task LoadDataAsync()
    {
        _users = await UserService.GetAsync().ToArrayAsync();
        _teams = _canSeeAllTeams
            ? await TeamOversightService.GetAllTeamsAsync<TMember>().ToArrayAsync()
            : await TeamDirectoryService.GetTeamsAsync<TMember>().ToArrayAsync();

        BuildViewModels();
    }

    private void BuildViewModels()
    {
        var teamLookup = _teams
            .Where(t => t.Members != null)
            .SelectMany(t => t.Members.Select(m => new { Team = t, Member = m }))
            .GroupBy(x => new { TeamKey = x.Team.Key, MemberKey = x.Member.Key })
            .Select(g => g.First())
            .ToLookup(x => x.Member.Key);

        _directoryIdStored = _users.Length > 0 && DirectoryLink.IsStored(_users[0].GetType());

        _allUsers = _users.Select(u => new UserViewModel
        {
            Key = u.Key,
            Name = u.Name ?? TeamServiceBase.ResolveDisplayName(u),
            StoredName = u.Name,
            EMail = u.EMail,
            Identity = u.Identity,
            DirectoryId = u.DirectoryId,
            Icon = u.Icon,
            LastSeen = u.LastSeen,
            DisabledAt = u.DisabledAt,
            DisabledBy = u.DisabledBy,
            TeamCount = teamLookup[u.Key].Count(),
            Teams = teamLookup[u.Key].Select(x => new UserTeamInfo
            {
                TeamKey = x.Team.Key,
                TeamName = x.Team.Name,
                AccessLevel = x.Member.AccessLevel,
                State = x.Member.State
            }).ToArray()
        }).OrderBy(u => u.Name).ToList();
    }

    private async Task OnUserActionAsync(RadzenSplitButtonItem item, UserViewModel user)
    {
        switch (item?.Value)
        {
            case null:
                ToggleDetails(user);
                break;
            case VerifyAction:
                await VerifyUserAsync(user);
                break;
            case DeleteAction:
                await DeleteUserAsync(user);
                break;
            case DisableAction:
                await SetUserDisabledAsync(user, true);
                break;
            case EnableAction:
                await SetUserDisabledAsync(user, false);
                break;
            case SetIconAction:
                await SetUserIconAsync(user);
                break;
            case RenameAction:
                await RenameUserAsync(user);
                break;
            case AuditAction:
                await OpenAuditLogAsync(user);
                break;
            default:
                await ActionInvoked.InvokeAsync(new UserRowAction(item.Value, user));
                break;
        }
    }

    private async Task SetUserIconAsync(UserViewModel user)
    {
        var result = await DialogService.OpenAsync<UserIconDialog>(_text.Format(UsersListViewText.IconTitle, user.Name),
            new Dictionary<string, object>
            {
                { nameof(UserIconDialog.AdminUserKey), user.Key },
                { nameof(UserIconDialog.HasIcon), !string.IsNullOrEmpty(user.Icon) }
            },
            new DialogOptions { Width = "480px" });

        if (result is true) await LoadDataAsync();
    }

    /// <summary>
    /// Administrative edit of a user's root <see cref="IUser.Name"/> — the name they carry everywhere.
    /// Per-team display names are separate overrides, set on the team surface, and are not affected.
    /// </summary>
    private async Task RenameUserAsync(UserViewModel user)
    {
        var editedName = user.StoredName;

        var confirmed = await DialogService.OpenAsync(_text.Format(UsersListViewText.RenameTitle, user.EMail ?? user.Name), ds =>
            @<RadzenStack Gap="1rem">
                <RadzenText TextStyle="TextStyle.Body2">
                    @_text[UsersListViewText.RenameHelp]
                </RadzenText>
                <RadzenTextBox Value="@editedName" ValueChanged="@(v => editedName = v)" Placeholder="@_text[UsersListViewText.NamePlaceholder]" Style="width: 100%;" />
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" Gap="0.5rem">
                    <RadzenButton Text="@_text[UsersListViewText.Save]" ButtonStyle="ButtonStyle.Primary" Click="@(_ => ds.Close(true))" />
                    <RadzenButton Text="@_text[UsersListViewText.Cancel]" ButtonStyle="ButtonStyle.Light" Click="@(_ => ds.Close(false))" />
                </RadzenStack>
            </RadzenStack>,
            new DialogOptions { Width = "480px" });

        if (confirmed is not true) return;

        var trimmed = string.IsNullOrWhiteSpace(editedName) ? null : editedName.Trim();
        if (trimmed == user.StoredName) return;

        try
        {
            // Through the management service, not IUserService: this is the administrative rename, the
            // only path that may also write the name back to the directory.
            var result = await UserManagementService.SetUserNameAsync(user.Key, trimmed);
            await LoadDataAsync();

            // The local write succeeded — a directory failure is reported, never presented as a failed
            // rename, because the name in this application really did change.
            if (result?.DirectoryError != null)
            {
                NotificationService.Notify(NotificationSeverity.Warning, _text[UsersListViewText.RenamedLocallyTitle],
                    result.DirectoryError);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, _text[UsersListViewText.RenameFailed], ex.Message);
        }
    }

    private void ToggleDetails(UserViewModel user)
    {
        _selectedUser = _selectedUser?.Key == user.Key ? null : user;
    }

    private async Task CopyAsync(string value)
    {
        await Js.InvokeVoidAsync("clipboard.copyText", value);
    }

    /// <summary>
    /// Pins the audit log to this user by identity rather than by key: audit entries record the caller's
    /// identity, not the user record's key.
    /// </summary>
    private async Task OpenAuditLogAsync(UserViewModel user)
    {
        // Pinned on the subject, not the display string. CallerIdentity resolves through a fallback
        // chain and is matched by substring, so a dialog pinned to an email came up empty whenever the
        // identity provider put a display name in the name claim.
        var pinned = new Audit.AuditPinnedFilter { CallerUserIdentity = user.Identity };

        await DialogService.OpenAsync(_text.Format(UsersListViewText.AuditLogTitle, user.Name ?? user.EMail), _ =>
            @<Tharga.Team.Blazor.Features.Audit.AuditLogView PinnedFilter="@pinned" />,
            new DialogOptions { Width = "90vw", Height = "85vh", Resizable = true, Draggable = true });
    }

    private async Task VerifyUserAsync(UserViewModel user)
    {
        try
        {
            var result = await UserManagementService.VerifyUserAsync(user.Key);
            user.DirectoryStatus = result.Status;
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, _text[UsersListViewText.VerificationFailed], ex.Message);
        }
    }

    private async Task VerifyAllAsync()
    {
        _verifying = true;
        try
        {
            await foreach (var item in UserManagementService.VerifyAllAsync())
            {
                var row = _allUsers.FirstOrDefault(x => x.Key == item.UserKey);
                if (row != null) row.DirectoryStatus = item.Result.Status;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, _text[UsersListViewText.VerificationFailed], ex.Message);
        }
        finally
        {
            _verifying = false;
        }
    }

    /// <remarks>
    /// The self-check is repeated here for the same reason it is repeated in <see cref="DeleteUserAsync"/>:
    /// <c>ActionItems</c> lets a host inject an item, and this handler dispatches on the value, so a
    /// host-supplied "disable" reaches here without passing the markup gate. The service refuses it too —
    /// this only turns a thrown exception into an explanation.
    /// </remarks>
    private async Task SetUserDisabledAsync(UserViewModel user, bool disabled)
    {
        if (disabled && !UserAdminGate.CanDisableUser(user.Key, _currentUserKey))
        {
            NotificationService.Notify(NotificationSeverity.Warning, _text[UsersListViewText.CannotDisableSelfTitle],
                _text[UsersListViewText.CannotDisableSelfDetail]);
            return;
        }

        if (disabled)
        {
            var confirmed = await DialogService.Confirm(
                _text.Format(UsersListViewText.ConfirmDisable, user.Name ?? user.EMail),
                _text[UsersListViewText.ConfirmDisableTitle]);
            if (confirmed != true) return;
        }

        try
        {
            await UserManagementService.SetUserDisabledAsync(user.Key, disabled);
            NotificationService.Notify(NotificationSeverity.Success,
                _text[disabled ? UsersListViewText.UserDisabled : UsersListViewText.UserEnabled],
                _text.Format(disabled ? UsersListViewText.UserDisabledDetail : UsersListViewText.UserEnabledDetail, user.Name ?? user.EMail));
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error,
                _text[disabled ? UsersListViewText.CouldNotDisable : UsersListViewText.CouldNotEnable], ex.Message);
        }
    }

    /// <remarks>
    /// One whole sentence per variant rather than a head with an optional <c>" by {name}"</c> appended.
    /// The actor clause moves in other languages, so a sentence assembled from two halves cannot be
    /// translated. No longer static: it reads the resolved catalogue.
    /// </remarks>
    private string GetDisabledText(UserViewModel user)
    {
        var when = user.DisabledAt?.ToString("yyyy-MM-dd HH:mm");
        var hasActor = !string.IsNullOrEmpty(user.DisabledBy);
        return _text.Format(hasActor ? UsersListViewText.DisabledByTooltip : UsersListViewText.DisabledTooltip, when, user.DisabledBy);
    }

    private async Task DeleteUserAsync(UserViewModel user)
    {
        // Not redundant with the disabled item: ActionItems lets a host inject an item, and this handler
        // dispatches on the value, so a host-supplied "delete" reaches here without passing the markup gate.
        if (!UserAdminGate.CanDeleteUser(user.Key, _currentUserKey))
        {
            NotificationService.Notify(NotificationSeverity.Warning, _text[UsersListViewText.CannotDeleteSelfTitle],
                _text[UsersListViewText.CannotDeleteSelfDetail]);
            return;
        }

        var dialogResult = await DialogService.OpenAsync<DeleteUserDialog>(_text[UsersListViewText.DeleteUserTitle],
            new Dictionary<string, object>
            {
                { nameof(DeleteUserDialog.UserName), user.Name ?? user.EMail },
                { nameof(DeleteUserDialog.UserKey), user.Key },
                { nameof(DeleteUserDialog.ShowDirectoryOption), _showDirectory }
            });
        if (dialogResult is not bool alsoDeleteFromDirectory) return;

        try
        {
            var result = await UserManagementService.DeleteUserAsync(user.Key, alsoDeleteFromDirectory);
            if (result.DirectoryError != null)
            {
                NotificationService.Notify(NotificationSeverity.Warning, _text[UsersListViewText.DeletedLocallyTitle],
                    _text.Format(UsersListViewText.DirectoryDeleteIncomplete, result.DirectoryError));
            }
            else
            {
                // Four whole sentences over two independent axes - one team or several, directory or not.
                // The English "team(s)" shorthand has no equivalent in a language that inflects.
                var removed = result.RemovedTeamCount == 1
                    ? (result.DirectoryDeleted ? UsersListViewText.RemovedFromOneTeamAndDirectory : UsersListViewText.RemovedFromOneTeam)
                    : (result.DirectoryDeleted ? UsersListViewText.RemovedFromManyTeamsAndDirectory : UsersListViewText.RemovedFromManyTeams);
                NotificationService.Notify(NotificationSeverity.Success, _text[UsersListViewText.UserDeleted],
                    _text.Format(removed, result.RemovedTeamCount));
            }

            if (_selectedUser?.Key == user.Key) _selectedUser = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, _text[UsersListViewText.DeleteFailed], ex.Message);
        }
    }
}
