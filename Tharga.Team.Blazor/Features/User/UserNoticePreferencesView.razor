@using Microsoft.AspNetCore.Components.Rendering
@using Tharga.Team.Blazor.Framework
@inject IUserNoticePreferenceService Notices
@inject IUserService UserService
@inject NotificationService NotificationService

@* Which automatic notices a user receives and how. Only the notices the user may receive in one of their teams are
   listed; a switch and, where a notice allows both, the delivery save at once. The service checks the reader. *@

@if (Framed)
{
    <RadzenCard>
        @((RenderFragment)RenderContent)
    </RadzenCard>
}
else
{
    @((RenderFragment)RenderContent)
}

@code {
    private void RenderContent(RenderTreeBuilder __builder)
    {
        if (!_ready)
        {
            <Loading />
        }
        else if (_userKey == null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter">
                @_text[UserNoticePreferencesViewText.NoUser]
            </RadzenAlert>
        }
        else if (!_permitted)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter">
                @_text[UserNoticePreferencesViewText.NotPermitted]
            </RadzenAlert>
        }
        else
        {
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
                @if (Framed)
                {
                    <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">@_text[UserNoticePreferencesViewText.Title]</RadzenText>
                }
                <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@_text[UserNoticePreferencesViewText.Explanation]</RadzenText>

                @if (_choices.Length == 0)
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0" data-empty>@_text[UserNoticePreferencesViewText.Empty]</RadzenText>
                }

                @foreach (var choice in _choices)
                {
                    var notice = choice.Notice;
                    var description = Description(notice);

                    <RadzenStack @key="@($"{notice.Key}:{_revision}")" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.75rem" data-notice="@notice.Key">
                        <RadzenSwitch Value="@choice.Enabled" Disabled="@_busy" Change="@(value => SetAsync(choice, value, choice.Delivery))" aria-label="@Name(notice)" />
                        <RadzenStack Orientation="Orientation.Vertical" Gap="0.25rem">
                            <RadzenText TextStyle="TextStyle.Body1" class="rz-m-0"><strong>@Name(notice)</strong></RadzenText>
                            @if (description != null)
                            {
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">@description</RadzenText>
                            }
                            @if (notice.Deliveries.Length > 1)
                            {
                                <RadzenSelectBar TValue="UserNoticeDelivery" Value="@choice.Delivery" Disabled="@(_busy || !choice.Enabled)" Size="ButtonSize.ExtraSmall"
                                                 Change="@(value => SetAsync(choice, choice.Enabled, value))" aria-label="@_text[UserNoticeText.Delivery]" data-delivery="@notice.Key">
                                    <Items>
                                        @foreach (var delivery in notice.Deliveries)
                                        {
                                            <RadzenSelectBarItem Text="@_text[UserNoticeText.For(delivery)]" Value="@delivery" />
                                        }
                                    </Items>
                                </RadzenSelectBar>
                            }
                            @if (choice.VariesByTeam)
                            {
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0" data-varies="@notice.Key">@_text[UserNoticePreferencesViewText.VariesByTeam]</RadzenText>
                            }
                            @if (!choice.CategoryReceives)
                            {
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0" data-category-off="@notice.Key">@_text.Format(UserNoticePreferencesViewText.CategoryOff, CategoryName(choice.Category))</RadzenText>
                            }
                        </RadzenStack>
                    </RadzenStack>
                }
            </RadzenStack>
        }
    }

    [Inject] private IThargaTextProvider TextProvider { get; set; }

    /// <summary>Whose choices are shown and changed; the signed-in user's when not set, and another user's only with <c>users:manage</c>.</summary>
    [Parameter] public string UserKey { get; set; }

    /// <summary>Whether the view draws its own card and title; false leaves both to the host, such as a tab named for it, and shows the rest as it is.</summary>
    [Parameter] public bool Framed { get; set; } = true;

    private TextSet _text = TextSet.Empty;
    private UserNoticeChoice[] _choices = [];
    private string _loadedFor;
    private string _userKey;
    private bool _ready;
    private bool _permitted = true;
    private bool _busy;
    private int _revision;

    protected override async Task OnParametersSetAsync()
    {
        if (_ready && _loadedFor == UserKey) return;

        _loadedFor = UserKey;
        _ready = false;
        _permitted = true;
        _choices = [];

        _userKey = string.IsNullOrWhiteSpace(UserKey) ? (await UserService.GetCurrentUserAsync())?.Key : UserKey;

        if (_userKey != null)
        {
            try
            {
                _choices = await Notices.GetChoicesAsync(_userKey) ?? [];
            }
            catch (UnauthorizedAccessException)
            {
                _permitted = false;
            }
        }

        _text = await TextProvider.ResolveAsync([.. UserNoticePreferencesViewText.All, .. _choices.SelectMany(Keys)]);
        _ready = true;
    }

    private async Task SetAsync(UserNoticeChoice choice, bool enabled, UserNoticeDelivery delivery)
    {
        _busy = true;
        try
        {
            var changed = await Notices.SetChoiceAsync(_userKey, choice.Notice.Key, enabled, delivery);
            _choices = [.. _choices.Select(x => x.Notice.Key == choice.Notice.Key ? changed : x)];
        }
        catch (UnauthorizedAccessException)
        {
            _revision++;
            NotificationService.Notify(NotificationSeverity.Warning, _text[UserNoticePreferencesViewText.NotPermitted]);
        }
        catch (Exception)
        {
            _revision++;
            NotificationService.Notify(NotificationSeverity.Error, _text[UserNoticePreferencesViewText.SaveFailed]);
        }
        finally
        {
            _busy = false;
        }
    }

    private string Name(UserNoticeType notice) => _text[new TextKey(notice.NameKey, notice.Name)];

    private string Description(UserNoticeType notice)
        => string.IsNullOrWhiteSpace(notice.Description) ? null : _text[new TextKey(notice.DescriptionKey, notice.Description)];

    private string CategoryName(UserMailCategory category)
        => category == null ? string.Empty : _text[new TextKey(category.NameKey, category.Name)];

    private static IEnumerable<TextKey> Keys(UserNoticeChoice choice)
    {
        yield return new TextKey(choice.Notice.NameKey, choice.Notice.Name);
        if (!string.IsNullOrWhiteSpace(choice.Notice.Description)) yield return new TextKey(choice.Notice.DescriptionKey, choice.Notice.Description);
        if (choice.Category != null) yield return new TextKey(choice.Category.NameKey, choice.Category.Name);
    }
}
