@using Tharga.Team.Support.Cases
@using Tharga.Team.Blazor.Framework
@using Tharga.Team.Blazor.Features.Team
@implements IDisposable
@inject ISupportCaseService SupportCases
@inject ISupportCaseNotifier Notifier
@inject ITeamStateService TeamState
@inject DialogService DialogService

@* The support side: every case in the team, answered, closed and reopened from one place.

   Like SupportCasesView, this goes through ISupportCaseService and nothing else — see the remarks there.
   Reading other people's cases needs support:read, and the service refuses without it, so a host that places
   this component where an ordinary member can reach it gets a refusal rather than a leak. *@

@if (!_ready)
{
    <Loading />
}
else if (_teamKey == null)
{
    <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter">
        @_text[SupportQueueViewText.SelectTeam]
    </RadzenAlert>
}
else
{
    <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" AlignItems="AlignItems.Center">
            <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">@_text[SupportQueueViewText.Title]</RadzenText>
            @if (_awaiting > 0)
            {
                <RadzenBadge Text="@($"{_awaiting} {_text[SupportQueueViewText.Awaiting]}")" BadgeStyle="BadgeStyle.Danger" />
            }
        </RadzenStack>

        @if (_cases.Length == 0)
        {
            <RadzenText TextStyle="TextStyle.Body2">@_text[SupportQueueViewText.NoCases]</RadzenText>
        }
        else
        {
            foreach (var item in _cases)
            {
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                        @* A button, not a RadzenLink: RadzenLink has no Click parameter, so a handler passed to it is
                               swallowed as an unmatched attribute and silently does nothing — which is how this shipped
                               unable to open a case. A text-variant button also stays keyboard reachable. *@
                            <RadzenButton Text="@item.Subject" Variant="Variant.Text" Size="ButtonSize.Small"
                                          Click="@(() => ToggleAsync(item.Id))" />
                        <RadzenBadge Text="@StatusText(item)"
                                     BadgeStyle="@(item.Status == SupportCaseStatus.Open ? BadgeStyle.Info : BadgeStyle.Light)" />
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">
                            @_text[SupportQueueViewText.RaisedBy] @item.AuthorName
                        </RadzenText>
                        <SupportMailboxAddress Case="item" />
                    </RadzenStack>

                    @if (_selected?.Id == item.Id)
                    {
                        <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem" class="rz-mt-3">
                            @* Shared with SupportUnassignedView, which renders the same transcript for the
                               same reader. A copy is what gets extended in one place and not the other. *@
                            <SupportTranscript Messages="_messages" CaseAuthorIdentity="@_selected.AuthorIdentity"
                                               ShowDelivery="true" HasChannels="@(_selected.Bindings is { Length: > 0 })" Resend="ResendAsync"
                                               TeamKey="@_teamKey" CaseId="@_selected.Id" />

                            @if (_selected.Status == SupportCaseStatus.Open)
                            {
                                <SupportAnswerRouteLine Route="_route" />
                                <RichTextEditor @bind-Value="_answer" Label="@_text[SupportQueueViewText.AnswerLabel]" Disabled="_busy" Height="8rem" />
                                <SupportAttachmentPicker @bind-Files="_files" Disabled="_busy" />
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                    <RadzenButton Text="@_text[SupportQueueViewText.AnswerLabel]" Click="AnswerAsync"
                                                  Disabled="@(NothingToSend || _busy)" data-answer="@_selected.Id" />
                                    @if (_route?.ByMail == true)
                                    {
                                        <RadzenButton Text="@_mail[MailPreviewText.Open]" Icon="preview" ButtonStyle="ButtonStyle.Light" Click="PreviewAsync"
                                                      Disabled="_busy" data-preview-answer="@_selected.Id" />
                                    }
                                    <RadzenButton Text="@_text[SupportQueueViewText.Close]" ButtonStyle="ButtonStyle.Light"
                                                  Click="CloseAsync" Disabled="_busy" />
                                </RadzenStack>
                            }
                            else
                            {
                                <div>
                                    <RadzenButton Text="@_text[SupportQueueViewText.Reopen]" Icon="refresh"
                                                  ButtonStyle="ButtonStyle.Light" Click="ReopenAsync" Disabled="_busy" />
                                </div>
                            }
                        </RadzenStack>
                    }
                </RadzenCard>
            }
        }
    </RadzenStack>
}

@code {
    [Inject] private IThargaTextProvider TextProvider { get; set; }

    private TextSet _text = TextSet.Empty;
    private TextSet _mail = TextSet.Empty;
    private bool _ready;
    private bool _busy;

    private string _teamKey;
    private string _answer;
    private IReadOnlyList<SupportAttachmentUpload> _files = [];
    private int _awaiting;

    private SupportCase[] _cases = [];
    private SupportCase _selected;
    private SupportAnswerRoute _route;
    private SupportMessage[] _messages = [];

    protected override async Task OnInitializedAsync()
    {
        _text = await TextProvider.ResolveAsync(SupportQueueViewText.All);
        _mail = await TextProvider.ResolveAsync(MailPreviewText.All);

        _teamKey = TeamState == null ? null : (await TeamState.GetSelectedTeamAsync())?.Key;

        Notifier.CaseUpdated += OnCaseUpdated;

        if (_teamKey != null) await ReloadAsync();

        _ready = true;
    }

    public void Dispose() => Notifier.CaseUpdated -= OnCaseUpdated;

    /// <remarks>
    /// Marshals before touching state: the notifier is a singleton raised from whichever scope handled the
    /// change, which for an inbound channel reply or the inactivity sweep is not this circuit.
    /// </remarks>
    private void OnCaseUpdated(object sender, SupportCaseUpdatedEventArgs e)
    {
        if (e.TeamKey != _teamKey) return;

        _ = InvokeAsync(async () =>
        {
            await ReloadAsync();
            StateHasChanged();
        });
    }

    private string StatusText(SupportCase item)
        => item.Status == SupportCaseStatus.Open
            ? _text[SupportQueueViewText.Open]
            : item.ClosedReason == SupportCaseClosureReason.Inactivity
                ? _text[SupportQueueViewText.ClosedForInactivity]
                : _text[SupportQueueViewText.Closed];

    private bool NothingToSend => RichTextEditor.IsEmpty(_answer) && _files.Count == 0;

    /// <remarks>The editor's HTML goes as it is; the service sanitizes it and derives the text.</remarks>
    private async Task AnswerAsync()
    {
        if (NothingToSend || _selected == null) return;

        _busy = true;
        try
        {
            var files = SupportAttachmentPicker.Rewound(_files);

            await SupportCases.AnswerCaseAsync(_teamKey, _selected.Id, string.Empty, _answer ?? string.Empty, files);

            _answer = null;
            _files = [];

            await ReloadAsync();
            await SelectAsync(_selected.Id);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PreviewAsync()
    {
        if (_selected == null) return;

        _busy = true;
        MailPreview preview;
        try
        {
            preview = await SupportCases.PreviewAnswerAsync(_teamKey, _selected.Id, string.Empty, _answer ?? string.Empty);
        }
        finally
        {
            _busy = false;
        }

        await SupportAnswerPreview.ShowAsync(DialogService, _mail, preview, _files);
    }

    private async Task ResendAsync(SupportMessage message)
    {
        if (_selected == null) return;

        await SupportCases.ResendAsync(_teamKey, _selected.Id, message.Sequence);
        await SelectAsync(_selected.Id);
    }

    /// <remarks>
    /// <b>Advisory, never a block.</b> Support must still be able to close a case that is finished — the
    /// warning exists because the person best placed to say a problem is solved is the person who had it, not
    /// because closing is wrong.
    /// </remarks>
    private async Task CloseAsync()
    {
        if (_selected == null) return;

        var confirmed = await DialogService.Confirm(
            _text[SupportQueueViewText.ConfirmCloseBody],
            _text[SupportQueueViewText.ConfirmCloseTitle],
            new ConfirmOptions
            {
                OkButtonText = _text[SupportQueueViewText.ConfirmCloseAccept],
                CancelButtonText = _text[SupportQueueViewText.ConfirmCloseCancel]
            });

        if (confirmed != true) return;

        _busy = true;
        try
        {
            await SupportCases.CloseCaseAsync(_teamKey, _selected.Id);

            await ReloadAsync();
            await SelectAsync(_selected.Id);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReopenAsync()
    {
        if (_selected == null) return;

        _busy = true;
        try
        {
            await SupportCases.ReopenCaseAsync(_teamKey, _selected.Id);

            await ReloadAsync();
            await SelectAsync(_selected.Id);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <remarks>
    /// Clicking the open case closes it again, so a long transcript can be put away without leaving the page.
    /// </remarks>
    private async Task ToggleAsync(string caseId)
    {
        _files = [];

        if (_selected?.Id == caseId)
        {
            _selected = null;
            _route = null;
            _messages = [];
            return;
        }

        await SelectAsync(caseId);
    }

    private async Task SelectAsync(string caseId)
    {
        _selected = await SupportCases.GetCaseAsync(_teamKey, caseId);
        _messages = _selected == null ? [] : (await SupportCases.GetMessagesAsync(_teamKey, caseId)).Items;
        _route = await SupportAnswerPreview.RouteAsync(SupportCases, _selected);
    }

    private async Task ReloadAsync()
    {
        _cases = (await SupportCases.GetCasesAsync(_teamKey)).Items;
        _awaiting = await SupportCases.GetAwaitingSupportCountAsync(_teamKey);
    }
}
