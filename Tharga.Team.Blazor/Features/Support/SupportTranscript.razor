@using Tharga.Team.Blazor.Features.User
@using Tharga.Team.Support.Cases
@using Microsoft.JSInterop
@inject ISupportCaseService SupportCases
@inject IJSRuntime JsRuntime
@implements IAsyncDisposable

@* One case's conversation as a chat: the person who raised it on one side, everybody answering on the other. *@

<div style="display: flex; flex-direction: column; gap: 0.75rem;">
    @foreach (var message in Messages ?? [])
    {
        if (message.Kind == SupportMessageKind.System)
        {
            <div style="align-self: center; max-width: 85%; text-align: center;" data-sender="system">
                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0" Style="font-style: italic; color: var(--rz-text-secondary-color);">
                    @message.Body — @Time(message.SentAt)
                </RadzenText>
            </div>
            continue;
        }

        var fromAuthor = message.Kind == SupportMessageKind.User && !message.AsSupport && message.AuthorIdentity == CaseAuthorIdentity;
        var onRight = fromAuthor == AuthorOnRight;

        <div style="display: flex; gap: 0.5rem; align-items: flex-end; @(onRight ? "flex-direction: row-reverse;" : "")" data-side="@(onRight ? "right" : "left")">
            <div style="flex: 0 0 auto;">
                @if (message.Kind == SupportMessageKind.Assistant)
                {
                    <span title="@_text[SupportTranscriptText.Assistant]" aria-label="@_text[SupportTranscriptText.Assistant]" data-sender="assistant" style="@IconCircle">
                        <RadzenIcon Icon="smart_toy" />
                    </span>
                }
                else if (fromAuthor)
                {
                    <span data-sender="author"><UserAvatar Name="@message.AuthorName" Size="32px" /></span>
                }
                else
                {
                    <span title="@_text[SupportTranscriptText.Support]" aria-label="@_text[SupportTranscriptText.Support]" data-sender="support" style="@IconCircle">
                        <RadzenIcon Icon="support_agent" />
                    </span>
                }
            </div>

            <div style="max-width: 75%; padding: 0.5rem 0.75rem; border-radius: 0.75rem; @(onRight ? RightBubble : LeftBubble)">
                <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                    @if (message.Kind != SupportMessageKind.Assistant)
                    {
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0" Style="font-weight: 600;">@message.AuthorName</RadzenText>
                    }
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0" Style="color: var(--rz-text-secondary-color);">
                        @Time(message.SentAt)
                    </RadzenText>
                    @* Which door it came through: a name from a channel was matched, not signed in, and carries different weight. *@
                    @if (message.Source != null)
                    {
                        <RadzenBadge Text="@message.Source.ToString()" BadgeStyle="BadgeStyle.Light" />
                    }
                </div>
                <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0" Style="white-space: pre-wrap; overflow-wrap: anywhere;">@message.Body</RadzenText>

                @* Opened only when the browser shows the type without running anything; every other file is saved. *@
                @if (message.Attachments is { Length: > 0 })
                {
                    <div role="list" aria-label="@_files[SupportAttachmentText.Attached]" style="display: flex; flex-wrap: wrap; gap: 0.25rem; margin-top: 0.25rem;" data-attachments="@message.Sequence">
                        @foreach (var attachment in message.Attachments)
                        {
                            var opens = SupportAttachmentContentTypes.OpensInBrowser(attachment.ContentType);
                            var label = _files.Format(opens ? SupportAttachmentText.Open : SupportAttachmentText.Save, attachment.FileName);
                            <span role="listitem">
                                <RadzenButton Icon="@(opens ? "open_in_new" : "download")" Size="ButtonSize.ExtraSmall" Variant="Variant.Text"
                                              Text="@($"{attachment.FileName} ({SupportAttachmentSize.Format(attachment.Size)})")"
                                              Disabled="@(CaseId == null || _opening.Contains(attachment.Id))"
                                              Click="@(() => OpenAttachmentAsync(message, attachment))"
                                              title="@label" aria-label="@label"
                                              data-attachment="@attachment.Id" data-opens="@(opens ? "browser" : "save")" />
                            </span>
                        }
                    </div>
                    @foreach (var missing in message.Attachments.Where(x => _unavailable.Contains(x.Id)))
                    {
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0" Style="color: var(--rz-danger);" data-attachment-unavailable="@missing.Id">
                            @_files.Format(SupportAttachmentText.NotAvailable, missing.FileName)
                        </RadzenText>
                    }
                }

                @* Only an answer is followed to its channel; what the customer wrote reached us by definition. *@
                @if (ShowDelivery && !fromAuthor && message.Kind == SupportMessageKind.User)
                {
                    if (message.Delivery == SupportMessageDelivery.Pending && HasChannels)
                    {
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-mt-1" Style="color: var(--rz-text-secondary-color);" data-delivery="pending">
                            @_text[SupportTranscriptText.NotSentYet]
                        </RadzenText>
                    }
                    else if (message.Delivery == SupportMessageDelivery.Failed)
                    {
                        <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; margin-top: 0.25rem;" data-delivery="failed">
                            <RadzenIcon Icon="error_outline" Style="font-size: 1rem; color: var(--rz-danger);" />
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0" Style="font-weight: 600; color: var(--rz-danger);">@_text[SupportTranscriptText.NotDelivered]</RadzenText>
                            @if (!string.IsNullOrWhiteSpace(message.DeliveryError))
                            {
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0" Style="overflow-wrap: anywhere;" data-delivery-error="@message.Sequence">@message.DeliveryError</RadzenText>
                            }
                            @if (Resend.HasDelegate)
                            {
                                <RadzenButton Text="@_text[SupportTranscriptText.SendAgain]" Icon="send" Size="ButtonSize.ExtraSmall"
                                              ButtonStyle="ButtonStyle.Light" Disabled="@_resending.Contains(message.Sequence)"
                                              Click="@(() => ResendAsync(message))" data-resend="@message.Sequence" />
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    private const string IconCircle = "display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: var(--rz-secondary-lighter); color: var(--rz-secondary);";
    private const string RightBubble = "background: var(--rz-primary-lighter); border-bottom-right-radius: 0.25rem;";
    private const string LeftBubble = "background: var(--rz-base-200); border-bottom-left-radius: 0.25rem;";

    /// <summary>The entries to render, oldest first.</summary>
    [Parameter] public SupportMessage[] Messages { get; set; } = [];

    /// <summary>Who raised the case; their messages are told apart from the answers by this.</summary>
    [Parameter] public string CaseAuthorIdentity { get; set; }

    /// <summary>Whether the person who raised the case sits on the right — true when they are the one reading it.</summary>
    [Parameter] public bool AuthorOnRight { get; set; }

    /// <summary>How a time is shown; the host's own date setting. Defaults to the local short date and time.</summary>
    [Parameter] public RenderFragment<DateTime> TimeTemplate { get; set; }

    /// <summary>
    /// Whether answers say if they reached the case's channels. For support; the customer is reading the
    /// answer on the site already.
    /// </summary>
    [Parameter] public bool ShowDelivery { get; set; }

    /// <summary>
    /// Whether the case is projected onto any channel. Without one an answer has nowhere to go, so its
    /// Pending status says nothing worth showing.
    /// </summary>
    [Parameter] public bool HasChannels { get; set; }

    /// <summary>
    /// Sends an answer that did not arrive again. Offered only when set, so pass it only for a reader who may
    /// answer the case.
    /// </summary>
    [Parameter] public EventCallback<SupportMessage> Resend { get; set; }

    /// <summary>The team the case belongs to, or null for an unassigned case; files are opened through it.</summary>
    [Parameter] public string TeamKey { get; set; }

    /// <summary>The case the entries belong to; without it files are listed but cannot be opened.</summary>
    [Parameter] public string CaseId { get; set; }

    private readonly HashSet<int> _resending = [];
    private readonly HashSet<string> _opening = [];
    private readonly HashSet<string> _unavailable = [];
    private SupportAttachmentFiles _browser;

    /// <remarks>Opened through the service, so reading a file is checked exactly as reading the case is.</remarks>
    private async Task OpenAttachmentAsync(SupportMessage message, SupportAttachment attachment)
    {
        if (CaseId == null || !_opening.Add(attachment.Id)) return;

        try
        {
            await using var content = await SupportCases.OpenAttachmentAsync(TeamKey, CaseId, message.Sequence, attachment.Id);

            if (content?.Content == null)
            {
                _unavailable.Add(attachment.Id);
                return;
            }

            _unavailable.Remove(attachment.Id);
            _browser ??= new SupportAttachmentFiles(JsRuntime);
            await _browser.OpenOrSaveAsync(content);
        }
        finally
        {
            _opening.Remove(attachment.Id);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_browser != null) await _browser.DisposeAsync();
    }

    private async Task ResendAsync(SupportMessage message)
    {
        if (!_resending.Add(message.Sequence)) return;

        try
        {
            await Resend.InvokeAsync(message);
        }
        finally
        {
            _resending.Remove(message.Sequence);
        }
    }

    private RenderFragment Time(DateTime value)
        => TimeTemplate?.Invoke(value) ?? (builder => builder.AddContent(0, value.ToLocalTime().ToString("g")));

    [Inject] private IThargaTextProvider TextProvider { get; set; }

    private TextSet _text = TextSet.Empty;
    private TextSet _files = TextSet.Empty;

    protected override async Task OnInitializedAsync()
    {
        _text = await TextProvider.ResolveAsync(SupportTranscriptText.All);
        _files = await TextProvider.ResolveAsync(SupportAttachmentText.All);
    }
}
