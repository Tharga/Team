@using Tharga.Team.Support.Cases
@using Tharga.Team.Blazor.Framework
@using Tharga.Blazor
@implements IDisposable
@inject ISupportCaseService SupportCases
@inject ISupportCaseNotifier Notifier
@inject IServiceProvider Services

@* Support cases that belong to no team: answer them, and give one a team when you know which it is.

   Separate from SupportQueueView rather than a mode of it, because the two are governed differently. That
   one requires a selected team and a team scope; this one has no team at all and is governed by the system
   scopes, so a single component would have had an upper half checked one way and a lower half the other —
   and its "select a team" state would have had to mean two different things at once.

   Assigning is checked against the system scope and never against the receiving team: a scope on the team a
   case is moved *into* would let a member of any team pull an unassigned case, which may concern a different
   tenant entirely, into their own along with its whole transcript. *@

@if (!_ready)
{
    <Loading />
}
else if (!_permitted)
{
    <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter">
        @_text[SupportUnassignedViewText.NotPermitted]
    </RadzenAlert>
}
else
{
    <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">

        <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">@_text[SupportUnassignedViewText.Explanation]</RadzenText>

        @* No kind of conversation to choose: an assistant answers only in a team, so every case here is support's. *@
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
            <SupportCaseFilter @ref="_filter" StorageKey="@StorageKey" ShowKinds="false" ShowSearch="true" Changed="StateHasChanged" />
            @if (_awaiting > 0)
            {
                <RadzenBadge Text="@($"{_awaiting} {_text[SupportUnassignedViewText.Awaiting]}")" BadgeStyle="BadgeStyle.Danger" data-awaiting="@_awaiting" />
            }
        </RadzenStack>

        @if (_message != null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter"
                         AllowClose="false">
                @_message
            </RadzenAlert>
        }

        @if (_cases.Length == 0)
        {
            <RadzenText TextStyle="TextStyle.Body2">@_text[SupportUnassignedViewText.NoCases]</RadzenText>
        }
        else if (!Shown().Any())
        {
            <RadzenText TextStyle="TextStyle.Body2">@_text[SupportUnassignedViewText.NoneMatch]</RadzenText>
        }
        else
        {
            foreach (var item in Shown())
            {
                <div @key="item.Id" data-case="@item.Id">
                    <ExpandableCard Text="@CaseTitle(item)" Icon="@ChannelIcon(item)" AllowSaveState="false">
                        <TopMenu>
                            <RadzenBadge Text="@StatusText(item)" BadgeStyle="@StatusStyle(item)" data-status="@item.Id" />
                            @if (item.AwaitingSupport)
                            {
                                <RadzenBadge Text="@_text[SupportUnassignedViewText.NeedsAnswer]" BadgeStyle="BadgeStyle.Danger" data-needs-answer="@item.Id" />
                            }
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0" data-sender="@item.Id">
                                @_text[SupportUnassignedViewText.From] @item.AuthorName
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0" Style="color: var(--rz-text-secondary-color);" data-time="@item.Id">
                                @Time(item.LastMessageAt ?? item.CreatedAt)
                            </RadzenText>
                        </TopMenu>
                        <ChildContent>
                            <SupportUnassignedConversation Case="item" Teams="_teams" TimeTemplate="TimeTemplate"
                                                           Changed="OnChangedAsync" Assigned="OnAssignedAsync" />
                        </ChildContent>
                    </ExpandableCard>
                </div>
            }
        }
    </RadzenStack>
}

@code {
    /// <summary>How a time is shown; the host's own date setting. Defaults to the local short date and time.</summary>
    [Parameter] public RenderFragment<DateTime> TimeTemplate { get; set; }

    /// <summary>Where the list filter is remembered in the browser.</summary>
    [Parameter] public string StorageKey { get; set; } = "Tharga.Team.Support.Unassigned.Filter";

    [Inject] private IThargaTextProvider TextProvider { get; set; }

    private TextSet _text = TextSet.Empty;
    private bool _ready;
    private bool _permitted = true;

    private int _awaiting;
    private string _message;

    private SupportCaseFilter _filter;
    private SupportCase[] _cases = [];
    private SupportCaseTeam[] _teams = [];

    protected override async Task OnInitializedAsync()
    {
        _text = await TextProvider.ResolveAsync(SupportUnassignedViewText.All);

        Notifier.CaseUpdated += OnCaseUpdated;

        await ReloadAsync();
        await LoadTeamsAsync();

        _ready = true;
    }

    public void Dispose() => Notifier.CaseUpdated -= OnCaseUpdated;

    /// <summary>
    /// Re-reads the queue, and with it every open conversation. For a host that hears of a change the
    /// in-process notifier cannot carry — one made on another instance.
    /// </summary>
    public Task RefreshAsync() => InvokeAsync(async () =>
    {
        await ReloadAsync();
        StateHasChanged();
    });

    /// <remarks>
    /// An unassigned case is announced with no team, so that is what this listens for — and the queue must
    /// also refresh when a case <i>gains</i> one, because that is how it leaves.
    /// </remarks>
    private void OnCaseUpdated(object sender, SupportCaseUpdatedEventArgs e)
    {
        if (e.Change == SupportCaseChange.Read) return;
        if (e.TeamKey != null && e.Change != SupportCaseChange.Assigned) return;

        _ = InvokeAsync(async () =>
        {
            await ReloadAsync();
            StateHasChanged();
        });
    }

    private static string CaseTitle(SupportCase item) => string.IsNullOrWhiteSpace(item.Subject) ? item.Id : item.Subject;

    private static string ChannelIcon(SupportCase item)
        => (item.Bindings ?? []).Any(x => x.ChannelType == SupportChannelType.Email) ? "mail" : "support_agent";

    private string StatusText(SupportCase item)
        => item.Status == SupportCaseStatus.Open
            ? _text[SupportUnassignedViewText.Open]
            : item.ClosedReason == SupportCaseClosureReason.Inactivity
                ? _text[SupportUnassignedViewText.ClosedForInactivity]
                : _text[SupportUnassignedViewText.Closed];

    private static BadgeStyle StatusStyle(SupportCase item) => item.Status == SupportCaseStatus.Open ? BadgeStyle.Info : BadgeStyle.Light;

    /// <summary>The cases the filter lets through: waiting ones first, then the liveliest conversation.</summary>
    private IEnumerable<SupportCase> Shown()
        => _cases
            .Where(x => _filter?.Shows(x) ?? SupportCaseFilter.ShowsByDefault(x))
            .OrderByDescending(x => x.AwaitingSupport)
            .ThenByDescending(x => x.LastMessageAt ?? x.CreatedAt);

    private RenderFragment Time(DateTime value)
        => TimeTemplate?.Invoke(value) ?? (builder => builder.AddContent(0, value.ToLocalTime().ToString("g")));

    private async Task OnChangedAsync(string caseId)
    {
        _message = null;
        await ReloadAsync();
    }

    /// <remarks>
    /// The case leaves this queue either way. A refusal means another operator was first, and the operator is
    /// told so rather than left looking at a button that did nothing.
    /// </remarks>
    private async Task OnAssignedAsync(bool assigned)
    {
        _message = assigned ? null : _text[SupportUnassignedViewText.AlreadyAssigned];
        await ReloadAsync();
    }

    /// <remarks>
    /// <b>The refusal is caught rather than left to take the circuit down.</b> This is a panel on a page
    /// whose other content the operator can see, so an unhandled exception would cost them the whole page
    /// over one component they simply do not have a grant for. <c>SupportQueueView</c> lets its refusal
    /// propagate because there it <i>is</i> the page.
    /// </remarks>
    private async Task ReloadAsync()
    {
        try
        {
            _cases = await SupportCasePaging.AllAsync(cursor => SupportCases.GetUnassignedCasesAsync(cursor, SupportCasePaging.PageSize));
            _awaiting = await SupportCases.GetAwaitingUnassignedCountAsync();
            _permitted = true;
        }
        catch (UnauthorizedAccessException)
        {
            _cases = [];
            _awaiting = 0;
            _permitted = false;
        }
    }

    /// <remarks>
    /// <b>Only teams that exist can be offered, which is what makes a typo impossible.</b> Nothing validates
    /// the key on the way through — the operation takes whatever it is given — so a free-text field would let
    /// somebody assign a case to a team that does not exist, which loses it out of this queue and into
    /// nobody's.
    /// <para>
    /// Cross-team discovery is its own system grant, so an operator may be able to read this queue and not to
    /// list teams. That is a smaller capability rather than a broken one: they can still answer and close.
    /// </para>
    /// </remarks>
    private async Task LoadTeamsAsync()
    {
        if (Services.GetService(typeof(ITeamOversightService)) is not ITeamOversightService oversight) return;

        try
        {
            var found = new List<SupportCaseTeam>();

            await foreach (var team in oversight.GetAllTeamsAsync())
            {
                found.Add(new SupportCaseTeam { Key = team.Key, Name = string.IsNullOrWhiteSpace(team.Name) ? team.Key : team.Name });
            }

            _teams = [.. found.OrderBy(x => x.Name)];
        }
        catch (UnauthorizedAccessException)
        {
            _teams = [];
        }
    }
}
