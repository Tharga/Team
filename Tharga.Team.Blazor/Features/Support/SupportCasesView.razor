@using Tharga.Team.Support.Cases
@using Tharga.Team.Blazor.Framework
@using Tharga.Team.Blazor.Features.Team
@using Tharga.Blazor
@implements IDisposable
@inject ISupportCaseService SupportCases
@inject ISupportCaseNotifier Notifier
@inject ITeamStateService TeamState

@* The customer's side of support: follow every conversation, and talk to the assistant or a person.
   Everything goes through ISupportCaseService and nothing else — SupportComponentSurfaceTests enforces it. *@

@if (!_ready)
{
    <Loading />
}
else if (_teamKey == null)
{
    <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter">
        @_text[SupportCasesViewText.SelectTeam]
    </RadzenAlert>
}
else
{
    <RadzenTabs SelectedIndex="_tab" SelectedIndexChanged="OnTabSelectedAsync" RenderMode="TabRenderMode.Client">
        <Tabs>
            <RadzenTabsItem Text="@_text[SupportCasesViewText.CasesTab]" data-tab="cases">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
                    <SupportCaseFilter @ref="_filter" StorageKey="@StorageKey" Changed="StateHasChanged" />

                    @if (_cases.Length == 0)
                    {
                        <RadzenText TextStyle="TextStyle.Body2">@_text[SupportCasesViewText.NothingYet]</RadzenText>
                    }
                    else if (!Shown().Any())
                    {
                        <RadzenText TextStyle="TextStyle.Body2">@_text[SupportCasesViewText.NoneMatch]</RadzenText>
                    }
                    else
                    {
                        foreach (var item in Shown())
                        {
                            <div @key="item.Id" data-case="@item.Id">
                                <ExpandableCard Text="@CaseTitle(item)" Icon="@KindIcon(item)" AllowSaveState="false" Selected="@(item.Id == _opened)">
                                    <TopMenu>
                                        <RadzenBadge Text="@StatusText(item)" BadgeStyle="@StatusStyle(item)" data-status="@item.Id" />
                                        @if (UnreadIn(item.Id) is > 0 and var unread)
                                        {
                                            <RadzenBadge Text="@unread.ToString()" BadgeStyle="BadgeStyle.Danger" data-unread="@item.Id" />
                                        }
                                        <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0" Style="color: var(--rz-text-secondary-color);">
                                            @Time(item.LastMessageAt ?? item.CreatedAt)
                                        </RadzenText>
                                    </TopMenu>
                                    <ChildContent>
                                        <SupportCaseConversation Case="item" Unread="@UnreadIn(item.Id)" Thinking="@(_thinking == item.Id)" AssistantProgress="@(_thinking == item.Id ? _progress : null)" Declined="@(_declined == item.Id)"
                                                                 TimeTemplate="TimeTemplate" Changed="OnChangedAsync" Read="OnRead" Written="RunAssistantAsync" />
                                    </ChildContent>
                                </ExpandableCard>
                            </div>
                        }
                    }
                </RadzenStack>
            </RadzenTabsItem>

            <RadzenTabsItem Text="@_text[SupportCasesViewText.NewCase]" data-tab="new">
                <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                        @if (_offered.Length > 1)
                        {
                            <RadzenSelectBar @bind-Value="_answeredBy" TValue="SupportAssistance" Size="ButtonSize.Small" aria-label="@_text[SupportCasesViewText.NewCase]">
                                <Items>
                                    <RadzenSelectBarItem Text="@_text[SupportCasesViewText.AnsweredByAssistant]" Icon="smart_toy" Value="SupportAssistance.Assistant" />
                                    <RadzenSelectBarItem Text="@_text[SupportCasesViewText.AnsweredByHuman]" Icon="support_agent" Value="SupportAssistance.None" />
                                </Items>
                            </RadzenSelectBar>
                        }
                        else
                        {
                            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0">@KindText(_answeredBy)</RadzenText>
                        }

                        @* Unknown renders nothing: saying "offline" when Slack would not tell us discourages asking for help that is there. *@
                        @if (_answeredBy == SupportAssistance.None && _presence == SupportPresenceState.Online)
                        {
                            <RadzenBadge Text="@_text[SupportCasesViewText.SupportOnline]" BadgeStyle="BadgeStyle.Success" />
                        }
                        else if (_answeredBy == SupportAssistance.None && _presence == SupportPresenceState.Away)
                        {
                            <RadzenBadge Text="@_text[SupportCasesViewText.SupportAway]" BadgeStyle="BadgeStyle.Light" />
                        }
                    </RadzenStack>

                    @if (ShowSubject)
                    {
                        <RadzenTextBox @bind-Value="_subject" Placeholder="@_text[SupportCasesViewText.SubjectLabel]"
                                       Style="width: 100%;" aria-label="@_text[SupportCasesViewText.SubjectLabel]" />
                    }

                    @* oninput as well as the binding: Radzen binds on change, so Send would stay disabled until the box lost focus. *@
                    <RadzenTextArea Value="@_body" ValueChanged="@(v => _body = v)"
                                    @oninput="@(e => _body = e.Value?.ToString())"
                                    Placeholder="@_text[SupportCasesViewText.MessageLabel]" Rows="4"
                                    Style="width: 100%;" aria-label="@_text[SupportCasesViewText.MessageLabel]" />

                    <div>
                        <RadzenButton Text="@_text[SupportCasesViewText.Send]" Icon="send" Click="RaiseAsync"
                                      Disabled="@(string.IsNullOrWhiteSpace(_body) || _busy)" />
                    </div>
                </RadzenStack>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
}

@code {
    /// <summary>
    /// Whether to ask for a subject. Defaults to <c>false</c>, matching <c>SupportCaseOptions.UseSubject</c>.
    /// </summary>
    /// <remarks>
    /// A parameter rather than a read of the options, because the options live in <c>Tharga.Team.Support</c>
    /// and this component depends on contracts only. With no subject asked for, the service derives one.
    /// </remarks>
    [Parameter] public bool ShowSubject { get; set; }

    /// <summary>
    /// A case to open on first render, or null to show the list. Lets a host route <c>/support/{caseId}</c>
    /// straight to a conversation; an unknown or unreadable id shows the list rather than an error.
    /// </summary>
    [Parameter] public string CaseId { get; set; }

    /// <summary>
    /// Who may be talked to: the assistant, support, or both. Null offers support, plus the assistant when the
    /// team is ready for one. The assistant is never offered to a team that is not
    /// (<see cref="ISupportCaseService.GetAssistantReadinessAsync"/>), whatever is passed.
    /// </summary>
    /// <remarks>With both offered the customer chooses on a select bar; with one there is nothing to choose.</remarks>
    [Parameter] public SupportAssistance[] Offered { get; set; }

    /// <summary>How a time is shown; the host's own date setting. Defaults to the local short date and time.</summary>
    [Parameter] public RenderFragment<DateTime> TimeTemplate { get; set; }

    /// <summary>
    /// The tab to show by name — <see cref="CasesTab"/> or <see cref="NewCaseTab"/> — so a host can link straight to one.
    /// Null or unknown picks for the reader: the cases, or where help is asked for when there are none yet.
    /// </summary>
    [Parameter] public string Tab { get; set; }

    /// <summary>Raised with the tab's name whenever the shown tab changes, so a host can keep its address in step.</summary>
    [Parameter] public EventCallback<string> TabChanged { get; set; }

    /// <summary>The name of the tab listing every conversation.</summary>
    public const string CasesTab = "cases";

    /// <summary>The name of the tab where help is asked for.</summary>
    public const string NewCaseTab = "new";

    /// <summary>Where the list filter is remembered in the browser.</summary>
    [Parameter] public string StorageKey { get; set; } = "Tharga.Team.Support.Cases.Filter";

    [Inject] private IThargaTextProvider TextProvider { get; set; }

    /// <remarks>
    /// Resolved through the provider rather than injected, because presence is registered only when the host
    /// configured it, and <c>[Inject]</c> on a missing service fails the whole render. Whether there is an
    /// assistant is asked of the case service instead, per team.
    /// </remarks>
    [Inject] private IServiceProvider Services { get; set; }

    private const int CasesIndex = 0;
    private const int NewCaseIndex = 1;

    private SupportPresenceState _presence = SupportPresenceState.Unknown;
    private SupportAssistance[] _offered = [SupportAssistance.None];

    private TextSet _text = TextSet.Empty;
    private bool _ready;
    private bool _busy;
    private int _tab = CasesIndex;
    private string _appliedTab;

    private string _teamKey;
    private string _subject;
    private string _body;
    private SupportAssistance _answeredBy = SupportAssistance.None;
    private string _thinking;
    private SupportAssistantProgress _progress;
    private string _declined;
    private string _opened;

    private SupportCaseFilter _filter;
    private SupportCase[] _cases = [];
    private Dictionary<string, int> _unreadByCase = new();

    protected override async Task OnInitializedAsync()
    {
        _text = await TextProvider.ResolveAsync(SupportCasesViewText.All);

        _teamKey = TeamState == null ? null : (await TeamState.GetSelectedTeamAsync())?.Key;

        var assistantAvailable = _teamKey != null && await AssistantReadinessAsync() == SupportAssistantReadiness.Ready;
        _offered = [.. (Offered ?? [SupportAssistance.Assistant, SupportAssistance.None])
            .Distinct()
            .Where(x => x != SupportAssistance.Assistant || assistantAvailable)];
        if (_offered.Length == 0) _offered = [SupportAssistance.None];
        _answeredBy = _offered.Contains(SupportAssistance.None) ? SupportAssistance.None : _offered[0];

        Notifier.CaseUpdated += OnCaseUpdated;

        if (_teamKey != null) await ReloadAsync();

        // A deep link opens its case, and is silently ignored when it names nothing this caller may read.
        if (!string.IsNullOrWhiteSpace(CaseId) && _cases.Any(x => x.Id == CaseId)) _opened = CaseId;

        // A first visit has nothing to follow yet, so it starts where help is asked for.
        if (_teamKey != null && _cases.Length == 0) _tab = NewCaseIndex;
        ApplyTab();

        // After _ready: presence is advisory and must never delay the form being usable.
        _ready = true;

        await RefreshPresenceAsync();
    }

    private async Task RefreshPresenceAsync()
    {
        if (Services?.GetService(typeof(ISupportPresence)) is not ISupportPresence presence) return;

        try
        {
            _presence = await presence.GetAsync();
            StateHasChanged();
        }
        catch (Exception)
        {
            _presence = SupportPresenceState.Unknown;
        }
    }

    protected override void OnParametersSet()
    {
        if (_ready) ApplyTab();
    }

    // Only a changed name moves the tab, so a host re-rendering with the same address leaves the reader's choice alone.
    private void ApplyTab()
    {
        if (Tab == _appliedTab) return;

        _appliedTab = Tab;
        if (IndexOf(Tab) is { } index) _tab = index;
    }

    private static int? IndexOf(string tab) => tab switch
    {
        CasesTab => CasesIndex,
        NewCaseTab => NewCaseIndex,
        _ => null
    };

    private static string NameOf(int index) => index == NewCaseIndex ? NewCaseTab : CasesTab;

    private async Task OnTabSelectedAsync(int index)
    {
        _tab = index;
        _appliedTab = NameOf(index);
        await TabChanged.InvokeAsync(_appliedTab);
    }

    public void Dispose() => Notifier.CaseUpdated -= OnCaseUpdated;

    /// <remarks>Marshalled: the notifier is raised from whichever scope handled the change, not this circuit's.</remarks>
    private void OnCaseUpdated(object sender, SupportCaseUpdatedEventArgs e)
    {
        if (e.TeamKey != _teamKey || e.Change == SupportCaseChange.Read) return;

        _ = InvokeAsync(async () =>
        {
            await ReloadAsync();
            StateHasChanged();
        });
    }

    private static SupportAssistance KindOf(SupportCase item)
        => item.AssistantState == SupportAssistantState.Active ? SupportAssistance.Assistant : SupportAssistance.None;

    private static string KindIcon(SupportCase item) => KindOf(item) == SupportAssistance.Assistant ? "smart_toy" : "support_agent";

    private string KindText(SupportAssistance kind)
        => kind == SupportAssistance.Assistant ? _text[SupportCasesViewText.AnsweredByAssistant] : _text[SupportCasesViewText.AnsweredByHuman];

    private static string CaseTitle(SupportCase item) => string.IsNullOrWhiteSpace(item.Subject) ? item.Id : item.Subject;

    /// <summary>The cases the filter lets through, the liveliest conversation first; the opened one stays.</summary>
    private IEnumerable<SupportCase> Shown()
        => _cases
            .Where(x => (_filter?.Shows(x) ?? SupportCaseFilter.ShowsByDefault(x)) || x.Id == _opened)
            .OrderByDescending(x => x.LastMessageAt ?? x.CreatedAt);

    private RenderFragment Time(DateTime value)
        => TimeTemplate?.Invoke(value) ?? (builder => builder.AddContent(0, value.ToLocalTime().ToString("g")));

    /// <remarks>A conversation with the assistant is neither open nor closed; it says what it is instead.</remarks>
    private string StatusText(SupportCase item)
        => KindOf(item) == SupportAssistance.Assistant
            ? _text[SupportCasesViewText.WithAssistant]
            : item.Status == SupportCaseStatus.Open
                ? _text[SupportCasesViewText.Open]
                : item.ClosedReason == SupportCaseClosureReason.Inactivity
                    ? _text[SupportCasesViewText.ClosedForInactivity]
                    : _text[SupportCasesViewText.Closed];

    private static BadgeStyle StatusStyle(SupportCase item)
        => KindOf(item) == SupportAssistance.Assistant ? BadgeStyle.Secondary
            : item.Status == SupportCaseStatus.Open ? BadgeStyle.Info : BadgeStyle.Light;

    private async Task RaiseAsync()
    {
        if (string.IsNullOrWhiteSpace(_body)) return;

        _busy = true;
        try
        {
            var raised = await SupportCases.RaiseCaseAsync(_teamKey, _subject, _body, _answeredBy);

            _subject = null;
            _body = null;

            await ReloadAsync();
            _opened = raised.Id;
            await OnTabSelectedAsync(CasesIndex);
            StateHasChanged();

            // After the case is on screen: raising stays fast, and the answer lands when the model is done.
            await RunAssistantAsync(raised.Id);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <remarks>
    /// The team's own answer, asked once: whether the assistant exists is a question about the team, since a
    /// deployment can give each team its own model or none. A refusal or a failure offers support alone.
    /// </remarks>
    private async Task<SupportAssistantReadiness> AssistantReadinessAsync()
    {
        try
        {
            return await SupportCases.GetAssistantReadinessAsync(_teamKey);
        }
        catch (Exception)
        {
            return SupportAssistantReadiness.NotConfigured;
        }
    }

    /// <remarks>
    /// Unconditional: the service answers nothing when the case has no assistant, so this need not decide. When
    /// nothing is answered the conversation says so, because silence would read as nobody caring; it shows only
    /// on a case still with the assistant, where talking to a person is offered beside it.
    /// </remarks>
    private async Task RunAssistantAsync(string caseId)
    {
        _thinking = caseId;
        _progress = null;
        _declined = null;
        StateHasChanged();

        var relay = new SupportAssistantRelay(InvokeAsync, progress =>
        {
            _progress = progress;
            StateHasChanged();
        });
        try
        {
            if (await SupportCases.RunAssistantAsync(_teamKey, caseId, relay)) await ReloadAsync();
            else _declined = caseId;
        }
        finally
        {
            relay.End();
            _thinking = null;
            _progress = null;
        }
    }

    private async Task OnChangedAsync(string caseId)
    {
        _opened = caseId;
        await ReloadAsync();
    }

    private void OnRead(string caseId) => _unreadByCase.Remove(caseId);

    private async Task ReloadAsync()
    {
        _cases = await SupportCasePaging.AllAsync(cursor => SupportCases.GetMyCasesAsync(_teamKey, cursor, SupportCasePaging.PageSize));
        _unreadByCase = (await SupportCases.GetMyUnreadByCaseAsync(_teamKey) ?? []).ToDictionary(x => x.CaseId, x => x.Count);
    }

    private int UnreadIn(string caseId) => _unreadByCase.TryGetValue(caseId, out var count) ? count : 0;

    /// <summary>
    /// Re-reads the cases, and with them every open conversation. For a host that hears of a change the
    /// in-process notifier cannot carry — one made on another instance.
    /// </summary>
    public Task RefreshAsync() => InvokeAsync(async () =>
    {
        if (_teamKey == null) return;

        await ReloadAsync();
        StateHasChanged();
    });
}
