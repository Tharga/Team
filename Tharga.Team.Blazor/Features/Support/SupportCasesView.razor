@using Tharga.Team.Support.Cases
@using Tharga.Team.Blazor.Framework
@using Tharga.Team.Blazor.Features.Team
@implements IDisposable
@inject ISupportCaseService SupportCases
@inject ISupportCaseNotifier Notifier
@inject ITeamStateService TeamState

@* The customer's side of support: talk to the assistant or a person, follow every conversation, close and reopen.
   Everything goes through ISupportCaseService and nothing else — SupportComponentSurfaceTests enforces it. *@

@if (!_ready)
{
    <Loading />
}
else if (_teamKey == null)
{
    <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter">
        @_text[SupportCasesViewText.SelectTeam]
    </RadzenAlert>
}
else
{
    <RadzenStack Orientation="Orientation.Vertical" Gap="1.5rem">

        <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">@_text[SupportCasesViewText.NewCase]</RadzenText>

                @if (_offered.Length > 1)
                {
                    <RadzenSelectBar @bind-Value="_answeredBy" TValue="SupportAssistance" Size="ButtonSize.Small" aria-label="@_text[SupportCasesViewText.NewCase]">
                        <Items>
                            <RadzenSelectBarItem Text="@_text[SupportCasesViewText.AnsweredByAssistant]" Icon="smart_toy" Value="SupportAssistance.Assistant" />
                            <RadzenSelectBarItem Text="@_text[SupportCasesViewText.AnsweredByHuman]" Icon="support_agent" Value="SupportAssistance.None" />
                        </Items>
                    </RadzenSelectBar>
                }
                else
                {
                    <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">@KindText(_answeredBy)</RadzenText>
                }

                @* Unknown renders nothing: saying "offline" when Slack would not tell us discourages asking for help that is there. *@
                @if (_answeredBy == SupportAssistance.None && _presence == SupportPresenceState.Online)
                {
                    <RadzenBadge Text="@_text[SupportCasesViewText.SupportOnline]" BadgeStyle="BadgeStyle.Success" />
                }
                else if (_answeredBy == SupportAssistance.None && _presence == SupportPresenceState.Away)
                {
                    <RadzenBadge Text="@_text[SupportCasesViewText.SupportAway]" BadgeStyle="BadgeStyle.Light" />
                }
            </RadzenStack>

            @if (ShowSubject)
            {
                <RadzenTextBox @bind-Value="_subject" Placeholder="@_text[SupportCasesViewText.SubjectLabel]"
                               Style="width: 100%;" aria-label="@_text[SupportCasesViewText.SubjectLabel]" />
            }

            @* oninput as well as the binding: Radzen binds on change, so Send would stay disabled until the box lost focus. *@
            <RadzenTextArea Value="@_body" ValueChanged="@(v => _body = v)"
                            @oninput="@(e => _body = e.Value?.ToString())"
                            Placeholder="@_text[SupportCasesViewText.MessageLabel]" Rows="4"
                            Style="width: 100%;" aria-label="@_text[SupportCasesViewText.MessageLabel]" />

            <div>
                <RadzenButton Text="@_text[SupportCasesViewText.Send]" Icon="send" Click="RaiseAsync"
                              Disabled="@(string.IsNullOrWhiteSpace(_body) || _busy)" />
            </div>
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">@_text[SupportCasesViewText.MyCases]</RadzenText>

                <RadzenSelectBar @bind-Value="_kinds" TValue="IEnumerable<SupportAssistance>" Multiple="true" Size="ButtonSize.Small" aria-label="@_text[SupportCasesViewText.MyCases]">
                    <Items>
                        <RadzenSelectBarItem Text="@_text[SupportCasesViewText.AnsweredByHuman]" Icon="support_agent" Value="SupportAssistance.None" />
                        <RadzenSelectBarItem Text="@_text[SupportCasesViewText.AnsweredByAssistant]" Icon="smart_toy" Value="SupportAssistance.Assistant" />
                    </Items>
                </RadzenSelectBar>

                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" AlignItems="AlignItems.Center">
                    <RadzenCheckBox @bind-Value="_showClosed" Name="showClosed" />
                    <RadzenLabel Text="@_text[SupportCasesViewText.ShowClosed]" Component="showClosed" />
                </RadzenStack>
            </RadzenStack>

            @if (_cases.Length == 0)
            {
                <RadzenText TextStyle="TextStyle.Body2">@_text[SupportCasesViewText.NoCases]</RadzenText>
            }
            else
            {
                foreach (var item in Shown())
                {
                    <RadzenPanel @key="item.Id" AllowCollapse="true" Collapsed="@(_selected?.Id != item.Id)"
                                 Expand="@(() => SelectAsync(item.Id))" Collapse="@Deselect" data-case="@item.Id">
                        <HeaderTemplate>
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                                <RadzenIcon Icon="@(KindOf(item) == SupportAssistance.Assistant ? "smart_toy" : "support_agent")"
                                            title="@KindText(KindOf(item))" data-kind="@(KindOf(item) == SupportAssistance.Assistant ? "assistant" : "support")" />
                                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0">@item.Subject</RadzenText>
                                <RadzenBadge Text="@StatusText(item)" BadgeStyle="@(item.Status == SupportCaseStatus.Open ? BadgeStyle.Info : BadgeStyle.Light)" />
                                @if (item.Id != _selected?.Id && UnreadIn(item.Id) is > 0 and var unread)
                                {
                                    <RadzenBadge Text="@unread.ToString()" BadgeStyle="BadgeStyle.Danger" data-unread="@item.Id" />
                                }
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0" Style="color: var(--rz-text-secondary-color);">
                                    @Time(item.LastMessageAt ?? item.CreatedAt)
                                </RadzenText>
                            </RadzenStack>
                        </HeaderTemplate>
                        <ChildContent>
                            @if (_selected?.Id == item.Id)
                            {
                                <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem" class="rz-mt-2">
                                    <SupportTranscript Messages="_messages" CaseAuthorIdentity="@_selected.AuthorIdentity" AuthorOnRight="true" TimeTemplate="TimeTemplate" />

                                    @if (_selected.Status == SupportCaseStatus.Open)
                                    {
                                        <RadzenTextArea Value="@_reply" ValueChanged="@(v => _reply = v)"
                                                        @oninput="@(e => _reply = e.Value?.ToString())"
                                                        Placeholder="@_text[SupportCasesViewText.ReplyLabel]"
                                                        Rows="3" Style="width: 100%;" aria-label="@_text[SupportCasesViewText.ReplyLabel]" />
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                                            <RadzenButton Text="@_text[SupportCasesViewText.ReplyLabel]" Click="ReplyAsync"
                                                          Disabled="@(string.IsNullOrWhiteSpace(_reply) || _busy)" />

                                            @* Only while an assistant is answering; on a case already handed over it would promise what has happened. *@
                                            @if (_selected.AssistantState == SupportAssistantState.Active)
                                            {
                                                <RadzenButton Text="@_text[SupportCasesViewText.TalkToAPerson]" Icon="support_agent"
                                                              ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                                                              Click="RequestHumanAsync" Disabled="_busy" />
                                            }

                                            <RadzenButton Text="@_text[SupportCasesViewText.Close]" Icon="check"
                                                          ButtonStyle="ButtonStyle.Light" Click="CloseAsync" Disabled="_busy" />

                                            @if (_thinking)
                                            {
                                                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">@_text[SupportCasesViewText.AssistantThinking]</RadzenText>
                                            }
                                        </RadzenStack>

                                        @* Offered only when the host lets each case decide, which is when a case carries a visibility. *@
                                        @if (_selected.Visibility != null)
                                        {
                                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                                                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">@_text[SupportCasesViewText.VisibilityLabel]</RadzenText>
                                                <RadzenSelectBar Value="@_selected.Visibility.Value" TValue="SupportCaseVisibility" Size="ButtonSize.Small"
                                                                 Change="@((SupportCaseVisibility v) => SetVisibilityAsync(v))" Disabled="_busy"
                                                                 aria-label="@_text[SupportCasesViewText.VisibilityLabel]">
                                                    <Items>
                                                        <RadzenSelectBarItem Text="@_text[SupportCasesViewText.VisibilityTeam]" Value="SupportCaseVisibility.Team" />
                                                        <RadzenSelectBarItem Text="@_text[SupportCasesViewText.VisibilityPrivate]" Value="SupportCaseVisibility.Private" />
                                                    </Items>
                                                </RadzenSelectBar>
                                            </RadzenStack>
                                        }
                                    }
                                    else
                                    {
                                        @* Offered on every closed case: a problem that came back continues the conversation that explains it. *@
                                        <div>
                                            <RadzenButton Text="@_text[SupportCasesViewText.Reopen]" Icon="refresh"
                                                          ButtonStyle="ButtonStyle.Light" Click="ReopenAsync" Disabled="_busy" />
                                        </div>
                                    }
                                </RadzenStack>
                            }
                        </ChildContent>
                    </RadzenPanel>
                }
            }
        </RadzenStack>
    </RadzenStack>
}

@code {
    /// <summary>
    /// Whether to ask for a subject. Defaults to <c>false</c>, matching <c>SupportCaseOptions.UseSubject</c>.
    /// </summary>
    /// <remarks>
    /// A parameter rather than a read of the options, because the options live in <c>Tharga.Team.Support</c>
    /// and this component depends on contracts only. With no subject asked for, the service derives one.
    /// </remarks>
    [Parameter] public bool ShowSubject { get; set; }

    /// <summary>
    /// A case to open on first render, or null to show the list. Lets a host route <c>/support/{caseId}</c>
    /// straight to a conversation; an unknown or unreadable id shows the list rather than an error.
    /// </summary>
    [Parameter] public string CaseId { get; set; }

    /// <summary>
    /// Who may be talked to: the assistant, support, or both. Null offers support, plus the assistant when one
    /// is registered. The assistant is never offered without an <c>ISupportResponder</c>, whatever is passed.
    /// </summary>
    /// <remarks>With both offered the customer chooses on a select bar; with one there is nothing to choose.</remarks>
    [Parameter] public SupportAssistance[] Offered { get; set; }

    /// <summary>How a time is shown; the host's own date setting. Defaults to the local short date and time.</summary>
    [Parameter] public RenderFragment<DateTime> TimeTemplate { get; set; }

    [Inject] private IThargaTextProvider TextProvider { get; set; }

    /// <remarks>
    /// Resolved through the provider rather than injected, because presence and the assistant are registered
    /// only when the host configured them, and <c>[Inject]</c> on a missing service fails the whole render.
    /// </remarks>
    [Inject] private IServiceProvider Services { get; set; }

    private SupportPresenceState _presence = SupportPresenceState.Unknown;
    private SupportAssistance[] _offered = [SupportAssistance.None];

    private TextSet _text = TextSet.Empty;
    private bool _ready;
    private bool _busy;

    private string _teamKey;
    private string _subject;
    private string _body;
    private string _reply;
    private SupportAssistance _answeredBy = SupportAssistance.None;
    private bool _thinking;

    private bool _showClosed;
    private IEnumerable<SupportAssistance> _kinds = [SupportAssistance.None];

    private SupportCase[] _cases = [];
    private SupportCase _selected;
    private SupportMessage[] _messages = [];
    private Dictionary<string, int> _unreadByCase = new();

    protected override async Task OnInitializedAsync()
    {
        _text = await TextProvider.ResolveAsync(SupportCasesViewText.All);

        _teamKey = TeamState == null ? null : (await TeamState.GetSelectedTeamAsync())?.Key;

        var assistantAvailable = Services.GetService(typeof(ISupportResponder)) != null;
        _offered = [.. (Offered ?? [SupportAssistance.Assistant, SupportAssistance.None])
            .Distinct()
            .Where(x => x != SupportAssistance.Assistant || assistantAvailable)];
        if (_offered.Length == 0) _offered = [SupportAssistance.None];
        _answeredBy = _offered.Contains(SupportAssistance.None) ? SupportAssistance.None : _offered[0];

        Notifier.CaseUpdated += OnCaseUpdated;

        if (_teamKey != null) await ReloadAsync();

        // A deep link opens its case, and is silently ignored when it names nothing this caller may read.
        if (_teamKey != null && !string.IsNullOrWhiteSpace(CaseId))
        {
            try
            {
                await SelectAsync(CaseId);
            }
            catch (UnauthorizedAccessException)
            {
                _selected = null;
            }
        }

        // After _ready: presence is advisory and must never delay the form being usable.
        _ready = true;

        await RefreshPresenceAsync();
    }

    private async Task RefreshPresenceAsync()
    {
        if (Services?.GetService(typeof(ISupportPresence)) is not ISupportPresence presence) return;

        try
        {
            _presence = await presence.GetAsync();
            StateHasChanged();
        }
        catch (Exception)
        {
            _presence = SupportPresenceState.Unknown;
        }
    }

    public void Dispose() => Notifier.CaseUpdated -= OnCaseUpdated;

    /// <remarks>Marshalled: the notifier is raised from whichever scope handled the change, not this circuit's.</remarks>
    private void OnCaseUpdated(object sender, SupportCaseUpdatedEventArgs e)
    {
        if (e.TeamKey != _teamKey || e.Change == SupportCaseChange.Read) return;

        _ = InvokeAsync(async () =>
        {
            await ReloadAsync();
            StateHasChanged();
        });
    }

    private static SupportAssistance KindOf(SupportCase item)
        => item.AssistantState == SupportAssistantState.Active ? SupportAssistance.Assistant : SupportAssistance.None;

    private string KindText(SupportAssistance kind)
        => kind == SupportAssistance.Assistant ? _text[SupportCasesViewText.AnsweredByAssistant] : _text[SupportCasesViewText.AnsweredByHuman];

    /// <summary>The cases the filters let through, the liveliest conversation first.</summary>
    private IEnumerable<SupportCase> Shown()
        => _cases
            .Where(x => _showClosed || x.Status == SupportCaseStatus.Open || x.Id == _selected?.Id)
            .Where(x => (_kinds ?? []).Contains(KindOf(x)) || x.Id == _selected?.Id)
            .OrderByDescending(x => x.LastMessageAt ?? x.CreatedAt);

    private RenderFragment Time(DateTime value)
        => TimeTemplate?.Invoke(value) ?? (builder => builder.AddContent(0, value.ToLocalTime().ToString("g")));

    private string StatusText(SupportCase item)
        => item.Status == SupportCaseStatus.Open
            ? _text[SupportCasesViewText.Open]
            : item.ClosedReason == SupportCaseClosureReason.Inactivity
                ? _text[SupportCasesViewText.ClosedForInactivity]
                : _text[SupportCasesViewText.Closed];

    private async Task RaiseAsync()
    {
        if (string.IsNullOrWhiteSpace(_body)) return;

        _busy = true;
        try
        {
            var raised = await SupportCases.RaiseCaseAsync(_teamKey, _subject, _body, _answeredBy);

            _subject = null;
            _body = null;

            // A new conversation of a kind the filter hides would vanish the moment it was raised.
            if (!(_kinds ?? []).Contains(_answeredBy)) _kinds = [.. _kinds ?? [], _answeredBy];

            await ReloadAsync();
            await SelectAsync(raised.Id);

            // After the case is on screen: raising stays fast, and the answer lands when the model is done.
            await RunAssistantAsync(raised.Id);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReplyAsync()
    {
        if (string.IsNullOrWhiteSpace(_reply) || _selected == null) return;

        _busy = true;
        try
        {
            var caseId = _selected.Id;

            await SupportCases.ReplyToCaseAsync(_teamKey, caseId, _reply);
            _reply = null;

            await ReloadAsync();
            await SelectAsync(caseId);

            await RunAssistantAsync(caseId);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <remarks>Unconditional: the service answers nothing when the case has no assistant, so this need not decide.</remarks>
    private async Task RunAssistantAsync(string caseId)
    {
        _thinking = true;
        StateHasChanged();
        try
        {
            if (await SupportCases.RunAssistantAsync(_teamKey, caseId))
            {
                await ReloadAsync();
                await SelectAsync(caseId);
            }
        }
        finally
        {
            _thinking = false;
        }
    }

    private Task RequestHumanAsync() => ActAsync(caseId => SupportCases.RequestHumanAsync(_teamKey, caseId));

    private Task CloseAsync() => ActAsync(caseId => SupportCases.CloseCaseAsync(_teamKey, caseId));

    private Task ReopenAsync() => ActAsync(caseId => SupportCases.ReopenCaseAsync(_teamKey, caseId));

    private Task SetVisibilityAsync(SupportCaseVisibility visibility)
        => ActAsync(caseId => SupportCases.SetCaseVisibilityAsync(_teamKey, caseId, visibility));

    private async Task ActAsync(Func<string, Task> act)
    {
        if (_selected == null) return;

        _busy = true;
        try
        {
            var caseId = _selected.Id;

            await act(caseId);

            await ReloadAsync();
            await SelectAsync(caseId);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Deselect()
    {
        _selected = null;
        _messages = [];
    }

    private async Task SelectAsync(string caseId)
    {
        _selected = await SupportCases.GetCaseAsync(_teamKey, caseId);
        _messages = _selected == null ? [] : (await SupportCases.GetMessagesAsync(_teamKey, caseId)).Items;

        if (_selected == null) return;

        // Opening a case is what clears its indicator.
        await SupportCases.MarkReadAsync(_teamKey, _selected.Id);
        _unreadByCase.Remove(_selected.Id);
    }

    private async Task ReloadAsync()
    {
        _cases = (await SupportCases.GetMyCasesAsync(_teamKey)).Items;
        _unreadByCase = (await SupportCases.GetMyUnreadByCaseAsync(_teamKey) ?? []).ToDictionary(x => x.CaseId, x => x.Count);
    }

    private int UnreadIn(string caseId) => _unreadByCase.TryGetValue(caseId, out var count) ? count : 0;

    /// <summary>
    /// Re-reads the cases and the open one. For a host that hears of a change the in-process notifier cannot
    /// carry — one made on another instance.
    /// </summary>
    public Task RefreshAsync() => InvokeAsync(async () =>
    {
        if (_teamKey == null) return;

        await ReloadAsync();

        if (_selected != null)
        {
            var open = _selected.Id;
            _selected = await SupportCases.GetCaseAsync(_teamKey, open);
            _messages = _selected == null ? [] : (await SupportCases.GetMessagesAsync(_teamKey, open)).Items;
        }

        StateHasChanged();
    });
}
