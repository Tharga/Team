@using Tharga.Team.Support.Cases
@using Tharga.Team.Blazor.Framework
@using Tharga.Blazor
@implements IDisposable
@inject ISupportCaseService SupportCases
@inject ISupportCaseNotifier Notifier

@* What the assistant was asked and had no way to do, across every team: for the people who build it, so they can see
   what to add. The same thing asked in several cases is one entry, most asked first, and each case opens as it does on
   the desk. Read through the cross-team listing, so it needs exactly what SupportAcrossTeamsView needs. *@

@if (!_ready)
{
    <Loading />
}
else if (!_permitted)
{
    <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat" Shade="Shade.Lighter">
        @_text[SupportAssistantGapsViewText.NotPermitted]
    </RadzenAlert>
}
else if (_gaps.Length == 0)
{
    <RadzenText TextStyle="TextStyle.Body2" data-no-gaps>@_text[SupportAssistantGapsViewText.NoGaps]</RadzenText>
}
else
{
    <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
        @foreach (var gap in _gaps)
        {
            <div @key="gap.Text" data-gap="@gap.Text">
                <ExpandableCard Text="@gap.Text" Icon="build" AllowSaveState="false">
                    <TopMenu>
                        <RadzenBadge Text="@_text.Format(SupportAssistantGapsViewText.Cases, gap.Cases.Length)" BadgeStyle="BadgeStyle.Light" data-cases="@gap.Cases.Length" />
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0" Style="color: var(--rz-text-secondary-color);">@Time(gap.Last)</RadzenText>
                    </TopMenu>
                    <ChildContent>
                        <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                            @foreach (var item in gap.Cases)
                            {
                                <div @key="item.Id" data-gap-case="@item.Id">
                                    <ExpandableCard Text="@(string.IsNullOrWhiteSpace(item.Subject) ? item.Id : item.Subject)"
                                                    Icon="@(item.AssistantState == SupportAssistantState.Active ? "smart_toy" : "support_agent")" AllowSaveState="false">
                                        <TopMenu>
                                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">@(item.TeamName ?? item.TeamKey)</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0" Style="color: var(--rz-text-secondary-color);">@Time(item.LastMessageAt ?? item.CreatedAt)</RadzenText>
                                        </TopMenu>
                                        <ChildContent>
                                            <SupportCaseConversation Case="item" AsStaff="true" TimeTemplate="TimeTemplate" Changed="OnChangedAsync" />
                                        </ChildContent>
                                    </ExpandableCard>
                                </div>
                            }
                        </RadzenStack>
                    </ChildContent>
                </ExpandableCard>
            </div>
        }
    </RadzenStack>
}

@code {
    /// <summary>How a time is shown; the host's own date setting. Defaults to the local short date and time.</summary>
    [Parameter] public RenderFragment<DateTime> TimeTemplate { get; set; }

    [Inject] private IThargaTextProvider TextProvider { get; set; }

    private TextSet _text = TextSet.Empty;
    private bool _ready;
    private bool _permitted = true;
    private Gap[] _gaps = [];

    protected override async Task OnInitializedAsync()
    {
        _text = await TextProvider.ResolveAsync(SupportAssistantGapsViewText.All);
        Notifier.CaseUpdated += OnCaseUpdated;

        await ReloadAsync();
        _ready = true;
    }

    public void Dispose() => Notifier.CaseUpdated -= OnCaseUpdated;

    /// <summary>Reads the list again, for a host that hears of a change the in-process notifier cannot carry.</summary>
    public Task RefreshAsync() => InvokeAsync(async () =>
    {
        await ReloadAsync();
        StateHasChanged();
    });

    private void OnCaseUpdated(object sender, SupportCaseUpdatedEventArgs e)
    {
        if (e.TeamKey == null || e.Change == SupportCaseChange.Read) return;

        _ = InvokeAsync(async () =>
        {
            await ReloadAsync();
            StateHasChanged();
        });
    }

    private Task OnChangedAsync(string caseId) => ReloadAsync();

    private async Task ReloadAsync()
    {
        try
        {
            var cases = await SupportCasePaging.AllAsync(cursor => SupportCases.GetCasesAcrossTeamsAsync(cursor, SupportCasePaging.PageSize));
            _gaps = GapsOf(cases);
            _permitted = true;
        }
        catch (UnauthorizedAccessException)
        {
            _gaps = [];
            _permitted = false;
        }
    }

    /// <summary>One entry per thing asked, however it was capitalised, with its cases newest first; the most asked first.</summary>
    internal static Gap[] GapsOf(IEnumerable<SupportCase> cases)
        => [.. cases
            .SelectMany(c => (c.AssistantGaps ?? []).Select(g => (Text: g, Case: c)))
            .GroupBy(x => x.Text, StringComparer.OrdinalIgnoreCase)
            .Select(g =>
            {
                SupportCase[] gapCases = [.. g.Select(x => x.Case).DistinctBy(x => x.Id).OrderByDescending(x => x.LastMessageAt ?? x.CreatedAt)];
                return new Gap(g.First().Text, gapCases, gapCases.Max(x => x.LastMessageAt ?? x.CreatedAt));
            })
            .OrderByDescending(x => x.Cases.Length)
            .ThenByDescending(x => x.Last)];

    private RenderFragment Time(DateTime value)
        => TimeTemplate?.Invoke(value) ?? (builder => builder.AddContent(0, value.ToLocalTime().ToString("g")));

    /// <summary>One thing the assistant could not do, and the cases it was asked in.</summary>
    internal sealed record Gap(string Text, SupportCase[] Cases, DateTime Last);
}
