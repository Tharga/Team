@using Microsoft.Extensions.Options
@using Tharga.Team
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITeamStateService TeamStateService
@inject ITeamDirectoryService TeamDirectoryService
@inject ITeamOversightService TeamOversightService
@inject IThargaTextProvider TextProvider
@inject IOptions<ThargaBlazorOptions> BlazorOptions

<AuthorizeView>
    <Authorized>
        @if (_teams == null)
        {
            <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="true" Size="ProgressBarCircularSize.ExtraSmall">
                <Template>@_loadingText</Template>
            </RadzenProgressBarCircular>
        }
        else if (_teams.Length == 0)
        {
            @if (TeamSelectorGate.ShowCreateTeamLink(_teams.Length, _allowTeamCreation, ShowCreateTeamLink))
            {
                @if (CreateTeamRequested.HasDelegate)
                {
                    <a href="" class="rz-link" @onclick="InvokeCreateTeamRequested" @onclick:preventDefault>@_createTeamText</a>
                }
                else
                {
                    <RadzenLink Text="@_createTeamText" Path="@_createTeamPath" />
                }
            }
        }
        else if (_teams.Length == 1 && SelectedTeam != null)
        {
            <TeamAvatar Team="SelectedTeam" Size="24px" />
            <span>@SelectedTeam.Name</span>
            @if (IsSuspended(SelectedTeam))
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Warning" Variant="Variant.Flat" Text="@_text[TeamSelectorText.Suspended]"
                             title="@SuspendedTitle" />
            }
        }
        else if (_teams.Length > 1 && SelectedTeam != null)
        {
            <RadzenDropDown @bind-Value=@SelectedTeam Data="@(_teams.OrderBy(f => f.Name))" TextProperty="Name"
                            AllowFiltering="@TeamSelectorGate.ShowFilter(_teams.Length, FilterThreshold, AllowFiltering)"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            FilterOperator="StringFilterOperator.Contains">
                <ValueTemplate Context="team">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                        <TeamAvatar Team="@((ITeam)team)" Size="20px" />
                        <span>@(((ITeam)team).Name)</span>
                        @if (IsSuspended((ITeam)team))
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Warning" Variant="Variant.Flat" Text="@_text[TeamSelectorText.Suspended]"
                                         title="@SuspendedTitle" />
                        }
                    </RadzenStack>
                </ValueTemplate>
                <Template Context="team">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                        <TeamAvatar Team="@((ITeam)team)" Size="20px" />
                        <span>@(((ITeam)team).Name)</span>
                        @if (IsSuspended((ITeam)team))
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Warning" Variant="Variant.Flat" Text="@_text[TeamSelectorText.Suspended]"
                                         title="@SuspendedTitle" />
                        }
                    </RadzenStack>
                </Template>
            </RadzenDropDown>
        }

        @if (AccessLevelBadge.ShouldShow(context.User, SelectedTeam != null))
        {
            var accessLevel = AccessLevelBadge.Resolve(context.User);
            <RadzenBadge BadgeStyle="@(Enum.Parse<BadgeStyle>(AccessLevelBadge.Style(accessLevel)))"
                         Variant="Variant.Flat"
                         Text="@AccessLevelBadge.Text(accessLevel, _text)"
                         title="@_text[TeamSelectorText.AccessLevelTooltip]" />
        }
    </Authorized>
</AuthorizeView>

@code {
    /// <summary>
    /// Optional callback invoked when a teamless user activates the built-in "Create team" link.
    /// When set, it takes precedence over <see cref="ThargaBlazorOptions.CreateTeamPath"/> and the
    /// default <c>/team</c> navigation — letting a host launch its own onboarding flow (e.g. a dialog).
    /// When unset, the link navigates to <c>CreateTeamPath</c> (if configured) or <c>/team</c>.
    /// </summary>
    [Parameter] public EventCallback CreateTeamRequested { get; set; }

    /// <summary>
    /// Whether the top bar offers a "Create team" link to a caller who belongs to no team. Default true.
    /// </summary>
    /// <remarks>
    /// <b>Presentation only.</b> This hides a link; it does not stop anyone creating a team. Use it where
    /// creation should stay reachable from the team page but not be advertised in the top bar — a layout
    /// decision, not an authorization one.
    /// <para>
    /// To actually prevent creation, set <see cref="ThargaBlazorOptions.AllowTeamCreation"/> to false,
    /// which the service enforces as well as the UI. Setting this parameter instead would hide the link
    /// and leave the capability, which is the shape of a security bug rather than a fix.
    /// </para>
    /// </remarks>
    [Parameter] public bool ShowCreateTeamLink { get; set; } = true;

    /// <summary>
    /// How many teams there must be before the selector offers a search box. Defaults to
    /// <see cref="TeamSelectorGate.DefaultFilterThreshold"/>.
    /// </summary>
    /// <remarks>
    /// A short list is read faster than it is typed into, so the filter appears only once scanning is
    /// the slower option. Lower it for a host whose team names are long or similar; raise it for one
    /// whose users belong to a handful of memorable teams.
    /// </remarks>
    [Parameter] public int FilterThreshold { get; set; } = TeamSelectorGate.DefaultFilterThreshold;

    /// <summary>
    /// Forces the search box on or off, ignoring <see cref="FilterThreshold"/>. Null, the default, lets
    /// the threshold decide.
    /// </summary>
    [Parameter] public bool? AllowFiltering { get; set; }

    private ITeam[] _teams;

    /// <summary>
    /// Team keys where the caller's own membership is suspended. Resolved once per reload rather than
    /// per render: the templates run on every keystroke of the dropdown and cannot await.
    /// </summary>
    /// <remarks>
    /// The team is still listed — <c>team:read</c> filtering recomputes scopes from access level and
    /// roles, which suspension does not touch. The badge is the only thing that has to be asked for.
    /// </remarks>
    private HashSet<string> _suspendedTeamKeys = [];

    private const string SuspendedTitle =
        "Your access to this team is suspended. Select it to see what that means.";

    private bool IsSuspended(ITeam team) => team != null && _suspendedTeamKeys.Contains(team.Key);

    private bool _canSeeAllTeams;
    private ITeam _selectedTeam;
    // One pass over every key this component renders, rather than an await and a field per label.
    private TextSet _text = TextSet.Empty;
    private string _loadingText => _text[TeamMenuText.Loading];
    private string _createTeamText => _text[TeamMenuText.CreateTeam];
    private string _createTeamPath = "/team";
    private bool _allowTeamCreation = true;

    private ITeam SelectedTeam
    {
        get => _selectedTeam;
        set
        {
            if (Equals(_selectedTeam, value)) return;
            _selectedTeam = value;
            TeamStateService.SetSelectedTeamAsync(_selectedTeam);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _text = await TextProvider.ResolveAsync(
            [TeamMenuText.Loading, TeamMenuText.CreateTeam, TeamSelectorText.Suspended, TeamSelectorText.AccessLevelTooltip, .. AccessLevelText.All]);

        _allowTeamCreation = BlazorOptions.Value.AllowTeamCreation;

        var configuredPath = BlazorOptions.Value.CreateTeamPath;
        if (!string.IsNullOrWhiteSpace(configuredPath)) _createTeamPath = configuredPath;

        TeamStateService.SelectedTeamChangedEvent += async (_, e) =>
        {
            _selectedTeam = e.SelectedTeam;
            await InvokeAsync(StateHasChanged);
        };

        TeamStateService.TeamsListChangedEvent += async (_, _) =>
        {
            await ReloadTeams();
        };

        var current = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (current.User.Identity?.IsAuthenticated ?? false)
        {
            await ReloadTeams();
        }

        await base.OnInitializedAsync();
    }

    private async Task ReloadTeams()
    {
        var current = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _canSeeAllTeams = TeamVisibility.CanSeeAllTeams(current.User);
        _teams = _canSeeAllTeams
            ? await TeamOversightService.GetAllTeamsAsync().ToArrayAsync()
            : await TeamDirectoryService.GetTeamsAsync().ToArrayAsync();
        // An oversight caller listing every team is not asking about their own membership in each of
        // them, and would make one lookup per team in the system.
        _suspendedTeamKeys = _canSeeAllTeams ? [] : await ResolveSuspendedAsync(_teams);

        var selectedTeam = await TeamStateService.GetSelectedTeamAsync();
        SelectedTeam ??= selectedTeam;
        StateHasChanged();
    }

    private async Task<HashSet<string>> ResolveSuspendedAsync(ITeam[] teams)
    {
        var suspended = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var team in teams ?? [])
        {
            if (await TeamDirectoryService.IsSuspendedAsync(team.Key)) suspended.Add(team.Key);
        }
        return suspended;
    }

    private async Task InvokeCreateTeamRequested()
    {
        if (CreateTeamRequested.HasDelegate) await CreateTeamRequested.InvokeAsync();
    }
}
