@using Microsoft.AspNetCore.Components.Authorization
@using Tharga.Team.Blazor.Framework
@inject ITeamDirectoryService TeamDirectoryService
@inject ITeamStateService TeamStateService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IThargaTextProvider TextProvider

@*
    Explains why the selected team does nothing, to the one person who cannot find out any other way.

    A suspended member holds no team scopes, so every scoped surface refuses them. Without this they see
    a team that loads empty or errors -- the "controls that throw when clicked" defect, at team scale.
    Security does not depend on this component: it is the explanation, not the enforcement.

    Place it in the host layout above @Body. It renders nothing at all unless the caller's own membership
    in the selected team is suspended, so it is safe to leave in place permanently.
*@

@implements IDisposable

@if (_suspended)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter"
                 AllowClose="false" Icon="block" Title="@(Title ?? _text[SuspendedTeamNoticeText.Title])">
        <RadzenText TextStyle="TextStyle.Body1">@(Message ?? _text[SuspendedTeamNoticeText.Message])</RadzenText>
        @if (ChildContent != null)
        {
            @ChildContent
        }
    </RadzenAlert>
}

@code {
    /// <summary>Heading. Override to match the host's vocabulary for teams.</summary>
    [Parameter] public string Title { get; set; }

    /// <summary>
    /// Body text. The default deliberately says what is *not* lost — a suspension that reads like a
    /// deletion produces the same panicked support ticket the visible-in-selector design exists to avoid.
    /// </summary>
    [Parameter] public string Message { get; set; }

    /// <summary>Optional extra content — a support link, or who to contact.</summary>
    [Parameter] public RenderFragment ChildContent { get; set; }

    private bool _suspended;
    private TextSet _text = TextSet.Empty;

    protected override async Task OnInitializedAsync()
    {
        _text = await TextProvider.ResolveAsync(SuspendedTeamNoticeText.All);
        TeamStateService.SelectedTeamChangedEvent += OnSelectedTeamChanged;
        await RefreshAsync();
    }

    private async void OnSelectedTeamChanged(object sender, SelectedTeamChangedEventArgs e)
    {
        await RefreshAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated != true)
        {
            _suspended = false;
            return;
        }

        var team = await TeamStateService.GetSelectedTeamAsync();
        _suspended = team != null && await TeamDirectoryService.IsSuspendedAsync(team.Key);
    }

    public void Dispose() => TeamStateService.SelectedTeamChangedEvent -= OnSelectedTeamChanged;
}
