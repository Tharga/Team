@using Microsoft.Extensions.Options
@using Tharga.Team
@inject ITeamManagementService TeamManagementService
@inject ITeamAccessRequestService AccessRequestService
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IOptions<ThargaBlazorOptions> BlazorOptions
@inject IThargaTextProvider TextProvider

@* Access requests for one team, in the team's detail: what a manager can decide, and what a non-member can ask for.
   Renders nothing when neither applies and consent is standing. *@
@if (_temporaryNotice != null || _pending.Count > 0 || CanRequest)
{
    <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem" class="rz-mb-2">
        @if (_temporaryNotice != null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" ShowIcon="true" AllowClose="false" class="rz-m-0">@_temporaryNotice</RadzenAlert>
        }

        @if (_pending.Count > 0)
        {
            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0">@_text[TeamAccessRequestText.Title]</RadzenText>
            @foreach (var request in _pending)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">
                            @_text.Format(TeamAccessRequestText.RequestLine, request.RequesterName ?? request.RequesterKey, request.AccessLevel, TeamAccessRequestGate.DurationPhrase(request.Duration, _text))
                        </RadzenText>
                        @if (!string.IsNullOrEmpty(request.Message))
                        {
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0" Style="font-style: italic;">@request.Message</RadzenText>
                        }
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                        <RadzenButton Text="@_text[TeamAccessRequestText.Approve]" Icon="check" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                      Disabled="@_busy" Click="@(() => ApproveAsync(request))" />
                        <RadzenButton Text="@_text[TeamAccessRequestText.Deny]" Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      Disabled="@_busy" Click="@(() => DenyAsync(request))" />
                    </RadzenStack>
                </RadzenStack>
            }
        }

        @if (CanRequest)
        {
            @if (MyPendingRequest != null)
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">
                        @_text.Format(TeamAccessRequestText.YourPendingRequest, MyPendingRequest.AccessLevel, TeamAccessRequestGate.DurationPhrase(MyPendingRequest.Duration, _text))
                    </RadzenText>
                    <RadzenButton Text="@_text[TeamAccessRequestText.Withdraw]" Icon="undo" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                  Disabled="@_busy" Click="@WithdrawAsync" />
                </RadzenStack>
            }
            else
            {
                <div>
                    <RadzenButton Text="@_text[TeamAccessRequestText.RequestAccess]" Icon="key" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                  Click="@RequestAsync" />
                </div>
            }
        }
    </RadzenStack>
}

@code {
    /// <summary>The team.</summary>
    [Parameter] public ITeam Team { get; set; }

    /// <summary>Whether the caller can decide requests here — see <c>TeamAccessRequestGate.CanDecide</c>.</summary>
    [Parameter] public bool CanDecide { get; set; }

    /// <summary>Whether the caller may ask for access here — see <c>TeamAccessRequestGate.CanRequest</c>.</summary>
    [Parameter] public bool CanRequest { get; set; }

    /// <summary>The caller's own pending request on this team, if any.</summary>
    [Parameter] public TeamAccessRequest MyPendingRequest { get; set; }

    /// <summary>Raised after anything here changed the team, so the host reloads it.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private TextSet _text = TextSet.Empty;
    private IReadOnlyList<TeamAccessRequest> _pending = [];
    private string _temporaryNotice;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _text = await TextProvider.ResolveAsync(TeamAccessRequestText.All);
    }

    protected override async Task OnParametersSetAsync()
    {
        _temporaryNotice = Team == null ? null : TeamAccessRequestGate.TemporaryConsentNotice(Team, BlazorOptions.Value.Consent.AccessLevel, DateTime.UtcNow, _text);

        _pending = CanDecide && Team != null
            ? [.. (await TeamManagementService.GetAccessRequestsAsync(Team.Key)).Where(x => x.Status == TeamAccessRequestStatus.Pending)]
            : [];
    }

    private async Task RequestAsync()
    {
        var sent = await DialogService.OpenAsync<TeamAccessRequestDialog>(_text[TeamAccessRequestText.RequestAccess],
            new Dictionary<string, object> { [nameof(TeamAccessRequestDialog.TeamKey)] = Team.Key },
            new DialogOptions { Width = "520px" });

        if (sent is not true) return;

        NotificationService.Notify(NotificationSeverity.Success, _text[TeamAccessRequestText.Sent]);
        await Changed.InvokeAsync();
    }

    private async Task ApproveAsync(TeamAccessRequest request)
    {
        var warning = TeamAccessRequestGate.ApprovalWarning(BlazorOptions.Value.Consent.Roles, request, Team.Name, _text);
        var confirmed = await DialogService.Confirm(warning, _text[TeamAccessRequestText.ApproveTitle],
            new ConfirmOptions { OkButtonText = _text[TeamAccessRequestText.Approve] });

        if (confirmed != true) return;

        await RunAsync(() => TeamManagementService.ApproveTeamAccessRequestAsync(Team.Key, request.Id), TeamAccessRequestText.Approved);
    }

    private Task DenyAsync(TeamAccessRequest request)
        => RunAsync(() => TeamManagementService.DenyTeamAccessRequestAsync(Team.Key, request.Id), TeamAccessRequestText.Denied);

    private Task WithdrawAsync()
        => RunAsync(() => AccessRequestService.CancelTeamAccessRequestAsync(Team.Key, MyPendingRequest.Id), TeamAccessRequestText.Withdrawn);

    private async Task RunAsync(Func<Task> operation, TextKey done)
    {
        _busy = true;
        try
        {
            await operation();
            NotificationService.Notify(NotificationSeverity.Success, _text[done]);
            await Changed.InvokeAsync();
        }
        catch (Exception e) when (e is UnauthorizedAccessException or InvalidOperationException or ArgumentException)
        {
            NotificationService.Notify(NotificationSeverity.Error, _text[TeamAccessRequestText.Failed], e.Message);
        }
        finally
        {
            _busy = false;
        }
    }
}
