@using System.Net.Http
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Options
@using Tharga.Team
@using Tharga.Team.Blazor.Framework
@inject ITeamManagementService TeamManagementService
@inject IHttpClientFactory HttpClientFactory
@inject IOptions<IconOptions> IconOptions
@inject IIconProcessor IconProcessor
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IThargaTextProvider TextProvider

@*
    Sets a team's icon from a file upload or an image URL (downloaded server-side), or removes it. All
    paths go through ITeamManagementService (team:manage) and the pluggable IIconStore.
*@
<RadzenStack Gap="1rem">
    <RadzenText TextStyle="TextStyle.Body2">@_text.Format(_canDownscale ? TeamIconDialogText.IntroDownscale : TeamIconDialogText.IntroNoDownscale, _maxUploadMb)</RadzenText>

    <RadzenStack Gap="0.25rem">
        <RadzenLabel Text="@_text[TeamIconDialogText.UploadFile]" />
        <InputFile OnChange="OnFileSelected" accept="image/*" disabled="@_busy" />
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.5rem">
        <RadzenStack Gap="0.25rem" Style="flex:1;">
            <RadzenLabel Text="@_text[TeamIconDialogText.OrImageUrl]" />
            <RadzenTextBox @bind-Value="_url" Placeholder="https://…/logo.png" Style="width:100%;" Disabled="@_busy" />
        </RadzenStack>
        <RadzenButton Text="@_text[TeamIconDialogText.Download]" Icon="download" Click="OnFetchUrl" Disabled="@(_busy || string.IsNullOrWhiteSpace(_url))" />
    </RadzenStack>

    @if (_busy)
    {
        <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" Style="width:24px;height:24px;" ShowValue="false" />
    }

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <div>
            <RadzenButton Text="@_text[TeamIconDialogText.RemoveIcon]" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" Click="OnRemove" Visible="@HasIcon" Disabled="@_busy" />
        </div>
        <RadzenButton Text="@_text[TeamIconDialogText.Close]" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Click="@(() => DialogService.Close(_changed))" />
    </RadzenStack>
</RadzenStack>

@code {
    /// <summary>The team whose icon is being set.</summary>
    [Parameter] public string TeamKey { get; set; }

    /// <summary>Whether the team currently has an icon (controls the Remove button).</summary>
    [Parameter] public bool HasIcon { get; set; }

    private string _url;
    private bool _busy;
    private bool _changed;
    private int _maxUploadMb;

    // The default NoOpIconProcessor does not resize, so promising automatic downscaling
    // without a real one tells the user something false — oversized uploads are rejected.
    private bool _canDownscale;
    private TextSet _text = TextSet.Empty;

    protected override async Task OnInitializedAsync()
    {
        _text = await TextProvider.ResolveAsync(TeamIconDialogText.All);
        _maxUploadMb = Math.Max(1, IconOptions.Value.MaxUploadBytes / (1024 * 1024));
        _canDownscale = IconCapability.CanProcessImages(IconProcessor);

        await base.OnInitializedAsync();
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        _busy = true;
        try
        {
            using var stream = new MemoryStream();
            await file.OpenReadStream(IconOptions.Value.MaxUploadBytes).CopyToAsync(stream);
            await SaveAsync(stream.ToArray(), file.ContentType);
        }
        catch (Exception ex) { NotifyError(ex); }
        finally { _busy = false; }
    }

    private async Task OnFetchUrl()
    {
        if (string.IsNullOrWhiteSpace(_url)) return;

        _busy = true;
        try
        {
            var client = HttpClientFactory.CreateClient(Tharga.Team.Blazor.Framework.ThargaTeamRegistration.IconHttpClientName);
            using var response = await client.GetAsync(_url);
            response.EnsureSuccessStatusCode();
            var contentType = response.Content.Headers.ContentType?.MediaType ?? "application/octet-stream";
            var bytes = await response.Content.ReadAsByteArrayAsync();
            await SaveAsync(bytes, contentType);
        }
        catch (Exception ex) { NotifyError(ex); }
        finally { _busy = false; }
    }

    private async Task SaveAsync(byte[] data, string contentType)
    {
        await TeamManagementService.SetTeamIconAsync(TeamKey, data, contentType);
        _changed = true;
        NotificationService.Notify(NotificationSeverity.Success, _text[TeamIconDialogText.NotifyUpdated]);
        DialogService.Close(true);
    }

    private async Task OnRemove()
    {
        _busy = true;
        try
        {
            await TeamManagementService.ClearTeamIconAsync(TeamKey);
            _changed = true;
            NotificationService.Notify(NotificationSeverity.Success, _text[TeamIconDialogText.NotifyRemoved]);
            DialogService.Close(true);
        }
        catch (Exception ex) { NotifyError(ex); }
        finally { _busy = false; }
    }

    private void NotifyError(Exception ex) => NotificationService.Notify(NotificationSeverity.Error, _text[TeamIconDialogText.NotifyFailed], ex.Message);
}
