@using System.Text.Json
@using Microsoft.Extensions.Options
@using Tharga.Team
@using Tharga.Toolkit
@typeparam TMember where TMember : class, Tharga.Team.ITeamMember
@inject ILocalStorageService LocalStorage
@inject ITeamInvitationService TeamInvitationService
@inject ITeamManagementService TeamManagementService
@inject ITeamStateService TeamStateService
@inject IUserService UserService
@inject NavigationManager NavigationManager
@inject IOptions<ThargaBlazorOptions> BlazorOptions
@inject IThargaTextProvider TextProvider

<RadzenStack Visible="@(_outcome == InviteOutcome.Open)">
    <CascadingAuthenticationState>
        <AuthorizeView>
            <Authorized>
                <RadzenText Text="@_text.Format(TeamInviteViewText.Invitation, _invitation.TeamName)" />
                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem">
                    <StandardButton Text="@_text[TeamInviteViewText.Accept]" Icon="check_circle" Click="JoinTeam" />
                    <StandardButton Text="@_text[TeamInviteViewText.Decline]" Icon="do_not_disturb_on" Click="Decline" />
                </RadzenStack>
            </Authorized>
        </AuthorizeView>
    </CascadingAuthenticationState>
</RadzenStack>

@{
    var message = Message();
}
@if (message != null)
{
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-p-2">
        <RadzenIcon Icon="mail" />
        <RadzenText TextStyle="TextStyle.Body1">@message</RadzenText>
    </RadzenStack>
}

@code
{
    private enum InviteOutcome { NoCode, Invalid, AlreadyMember, Expired, Open }

    private InviteOutcome _outcome = InviteOutcome.NoCode;
    private TeamInvitation _invitation;
    private IUser _user;
    private TextSet _text = TextSet.Empty;

    [Parameter]
    public string InviteCode { get; set; }

    /// <summary>
    /// When true, shows a "no pending invitations" message when no invitation code was presented. Use on a
    /// standalone invites page; leave false (the default) when embedding the view elsewhere.
    /// </summary>
    /// <remarks>
    /// Governs only the case with no code. A presented code that cannot be answered — invalid, expired, or
    /// for a team the caller already belongs to — is always reported, because the visitor followed a link and
    /// saying nothing would read as the link being broken silently.
    /// </remarks>
    [Parameter]
    public bool ShowEmptyMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Resolved before the early return: the "no pending invitations" message renders precisely when
        // there is no invite code, so resolving after it would leave that one string in English.
        _text = await TextProvider.ResolveAsync(TeamInviteViewText.All);

        var inviteCode = await GetInviteCode();
        if (string.IsNullOrEmpty(inviteCode)) return;

        // Resolved by the code, not by reading the team. The invitee holds no scope for the team they
        // are joining, so the gated read would refuse them — and the read this replaces returned the whole
        // roster to someone who had only been sent a link.
        _invitation = await TeamInvitationService.GetInvitationAsync(inviteCode);

        // Null covers malformed, unknown and already-answered alike; the service does not distinguish
        // them, so neither can this.
        _outcome = _invitation switch
        {
            null => InviteOutcome.Invalid,
            { AlreadyMember: true } => InviteOutcome.AlreadyMember,
            { Status: InvitationStatus.Expired } => InviteOutcome.Expired,
            _ => InviteOutcome.Open
        };

        if (_outcome == InviteOutcome.Open)
        {
            _user = await UserService.GetCurrentUserAsync();
            await LocalStorage.SetItemAsync(Constants.TeamInviteCode, inviteCode);
        }
        else
        {
            await LocalStorage.RemoveItemAsync(Constants.TeamInviteCode);
        }
    }

    /// <summary>What to tell the visitor when there is nothing to answer, or null when the join prompt shows.</summary>
    private string Message() => _outcome switch
    {
        InviteOutcome.NoCode => ShowEmptyMessage ? _text[TeamInviteViewText.NoInvitations] : null,
        InviteOutcome.Invalid => _text[TeamInviteViewText.InvalidLink],
        InviteOutcome.AlreadyMember => _text.Format(TeamInviteViewText.AlreadyMember, _invitation.TeamName),
        InviteOutcome.Expired => _text.Format(TeamInviteViewText.Expired, _invitation.TeamName),
        _ => null
    };

    private async Task<string> GetInviteCode()
    {
        var uri = new Uri(NavigationManager.Uri);

        // Both parameters are read: 'tic' is what links carry from 3.20, and 'TeamInviteCode' is what is
        // sitting in inboxes from before it. Local storage is the third source, holding whichever form was
        // presented while the invitee went away to sign in.
        var values = Tharga.Blazor.Framework.UriExtensions.GetQueryValue(uri, Constants.TeamInviteToken)
            .Concat(Tharga.Blazor.Framework.UriExtensions.GetQueryValue(uri, Constants.TeamInviteCode))
            .ToArray();

        return values.Any()
            ? values.First()
            : await LocalStorage.GetItemAsync<string>(Constants.TeamInviteCode);
    }

    /// <summary>
    /// Accepts the invitation, selects the team it was for, and leaves for the site's landing page.
    /// </summary>
    /// <remarks>
    /// <b>The selection is taken here rather than left to the service's <c>SelectTeamEvent</c></b>, which
    /// the accept no longer raises. That event could not be awaited by whoever raised it, so the selection
    /// it wrote raced this navigation and the reload it performed of its own was a second navigation for
    /// one click (Tharga/Team#287).
    /// <para>
    /// The team is read back through the gated <see cref="ITeamManagementService"/> rather than the
    /// internal service a component must never inject. It resolves from live membership — which the accept
    /// has just created — so the caller's not-yet-rebuilt claims do not refuse it.
    /// </para>
    /// </remarks>
    private async Task JoinTeam()
    {
        await TeamManagementService.SetInvitationResponseAsync(_invitation.TeamKey, _user.Key, _invitation.InviteKey, true);
        await LocalStorage.RemoveItemAsync(Constants.TeamInviteCode);

        var team = await TeamManagementService.GetTeamByKeyAsync(_invitation.TeamKey);
        if (team != null) await TeamStateService.SetSelectedTeamAsync(team, false);

        NavigateHome();
    }

    /// <summary>
    /// Declines the invitation and leaves for the same place accepting does, selecting nothing — declining
    /// grants no access, so it must leave the current selection exactly as it found it.
    /// </summary>
    private async Task Decline()
    {
        await TeamManagementService.SetInvitationResponseAsync(_invitation.TeamKey, _user.Key, _invitation.InviteKey, false);
        await LocalStorage.RemoveItemAsync(Constants.TeamInviteCode);

        NavigateHome();
    }

    /// <summary>
    /// Leaves the invitation behind. Forced, because the answer changes the caller's teams and the new
    /// claims only apply on a fresh load.
    /// </summary>
    private void NavigateHome()
    {
        NavigationManager.NavigateTo(HomePathResolver.Resolve(BlazorOptions.Value.HomePath, NavigationManager.BaseUri), true);
    }
}
