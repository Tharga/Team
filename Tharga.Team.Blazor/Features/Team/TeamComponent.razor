@using System.Text.Json
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Options
@using Microsoft.JSInterop
@using Tharga.Team.Blazor.Features.User
@using Tharga.Toolkit
@typeparam TMember where TMember : class, Tharga.Team.ITeamMember
@inject ITeamManagementService TeamManagementService
@inject ITeamDirectoryService TeamDirectoryService
@inject ITeamOversightService TeamOversightService
@inject ITeamManagementService TeamManagementService
@inject ITeamLifecycleService TeamLifecycleService
@inject ITeamStateService TeamStateService
@inject AuthenticationStateProvider AuthStateProvider
@inject IUserService UserService
@inject IJSRuntime Js
@inject DialogService DialogService
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService
@inject IOptions<ThargaBlazorOptions> BlazorOptions
@inject IServiceProvider ServiceProvider
@inject ILogger<TeamComponent<TMember>> Logger

@* Current-user row highlight. Applied to the cells (not the <tr>) so Radzen's own cell backgrounds
   don't paint over it. The translucent blue composites correctly on both light and dark themes;
   colour-mix keeps the left accent visible against either. *@
<style>
    tr[data-tharga-current-member] > td {
        background-color: rgba(37, 99, 235, 0.16) !important;
    }

    tr[data-tharga-current-member] > td:first-child {
        box-shadow: inset 3px 0 0 0 var(--rz-primary, #2563eb);
    }

    /* The selected team, marking what ExpandableCard.Selected used to. A left accent only: the current
       member row already owns the tint, and two competing backgrounds in one view read as an error
       rather than as two facts. Cell-level for the same reason as above -- a background on the row
       element is painted over by Radzen's own cell backgrounds.
       (Angle brackets are avoided even in this comment: Razor parses them inside a style block.) */
    tr[data-tharga-selected-team] > td:first-child {
        box-shadow: inset 3px 0 0 0 var(--rz-primary, #2563eb);
    }

    tr[data-tharga-selected-team] > td {
        font-weight: 600;
    }
</style>

@if (_teams == null)
{
    <Loading />
}
else
{
    <RadzenStack Gap="1rem">
        <TeamInviteView TMember="TMember" />
        @if (_teams.Any())
        {
            @* Two shapes for two situations, chosen by the same threshold the selector uses.

               Cards suit a handful: the expand affordance is obvious and a grid of three rows looks like
               an administrative report of nothing much. Past the threshold that reverses -- cards cannot
               be sorted, filtered or paged, and a page of stacked accordions is not a list.

               Both render @TeamDetail and @TeamActions, defined once below. That is what keeps two
               layouts from being twice the work: only the container differs, never the contents, so a
               change to a member column or an action cannot land in one shape and not the other.

               Paging is a *rendering* fix, not a loading one: ReloadTeams still fetches every team with
               its members. A paged, member-less read is a service-contract change and is out of scope. *@
            @if (TeamListPresentation.ShowAsGrid(_teams.Length, TeamFilterThreshold, TeamLayout))
            {
                <RadzenDataGrid @ref="_teamGrid" Data="@_teams" TItem="ITeam<TMember>"
                                AllowSorting="@AllowTeamSorting"
                                AllowFiltering="@TeamSelectorGate.ShowFilter(_teams.Length, TeamFilterThreshold, AllowTeamFiltering)"
                                AllowPaging="@TeamSelectorGate.ShowFilter(_teams.Length, TeamPageSize + 1, AllowTeamPaging)"
                                FilterMode="FilterMode.Simple" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                PageSize="@TeamPageSize" PageSizeOptions="@TeamPageSizeOptionsValues"
                                ShowPagingSummary="true" PagingSummaryFormat="Showing {0}-{1} of {2}"
                                ExpandMode="DataGridExpandMode.Multiple"
                                RowRender="@OnTeamRowRender">
                    <Columns>
                        @* Name is a real property on ITeam, so it sorts and filters through the grid's
                           own machinery. Every other column here is derived -- the caller's level comes
                           from their membership row, the badges from consent -- so they are marked
                           unsortable rather than given a SortProperty that does not exist. A sort control
                           that silently does nothing is worse than no control. *@
                        <RadzenDataGridColumn TItem="ITeam<TMember>" Title="Team" Property="Name"
                                              SortOrder="SortOrder.Ascending" Filterable="true">
                            <Template Context="team">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <TeamAvatar Team="@team" Size="24px" />
                                    <span>@team.Name</span>
                                </RadzenStack>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ITeam<TMember>" Title="Your access" Width="140px" Filterable="false" Sortable="false">
                            <Template Context="team">
                                @{
                                    var myLevel = MyAccessLevel(team);
                                }
                                @if (myLevel != null)
                                {
                                    <RadzenBadge BadgeStyle="@(Enum.Parse<BadgeStyle>(AccessLevelBadge.Style(myLevel)))"
                                                 Variant="Variant.Flat"
                                                 @* TextSet.Empty renders the English defaults: this component
                                                    has not been migrated onto the text catalogue yet, and is
                                                    listed as pending in TextCoverage. *@
                                                 Text="@AccessLevelBadge.Text(myLevel, TextSet.Empty)"
                                                 title="Your access level on this team." />
                                }
                                else
                                {
                                    <span class="rz-text-disabled">—</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ITeam<TMember>" Title="Consent" Width="230px" Filterable="false" Sortable="false"
                                              Visible="@(_canSeeAllTeams || _showConsentToggle)">
                            <Template Context="team">
                                @* No label: the column header already says Consent, and repeating it in
                                   every cell is the same word printed once per row. *@
                                @ConsentCell(team)
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ITeam<TMember>" Title="Members" Width="110px" Filterable="false" Sortable="false">
                            <Template Context="team">
                                @{
                                    var counts = TeamMemberCounts.Of(team.Members);
                                }
                                <span title="@counts.Title">@counts.Text</span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ITeam<TMember>" Title="" Width="240px" Sortable="false" Filterable="false" TextAlign="TextAlign.Right">
                            <Template Context="team">
                                @TeamActionsFragment(team)
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                    <Template Context="team">
                        @TeamDetail(team)
                    </Template>
                </RadzenDataGrid>
            }
            else
            {
                @foreach (var team in _teams)
                {
                    <ExpandableCard Text="@team.Name" Icon="groups" ImageUrl="@TeamIconUrl(team)" Selected="@(_selectedTeam?.Key == team.Key)">
                        @* On the title, so what a team grants is readable without opening it -- the same
                           thing the grid's Consent column does for a row. Badges only: TopMenu sits
                           inside the header's click handler, so a control here would toggle the card as
                           well as itself. *@
                        <TopMenu>
                            @ConsentBadges(team)
                        </TopMenu>
                        <ChildContent>
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" AlignItems="AlignItems.End" Gap="0.75rem">
                                @ConsentControl(team, showLabel: true)
                                @TeamActionsFragment(team)
                            </RadzenStack>
                            @TeamDetail(team)
                        </ChildContent>
                    </ExpandableCard>
                }
            }
        }
        <RadzenText Visible="@(!_teams.Any() && _allowTeamCreation)">You are not member of a team. Create your own team and start inviting members.</RadzenText>
        <RadzenText Visible="@(!_teams.Any() && !_allowTeamCreation)">You are not member of a team.</RadzenText>
        @if (_allowTeamCreation)
        {
            <RadzenStack Orientation="Orientation.Horizontal">
                <RadzenButton Icon="add" Text="Create new Team" Click="@(() => CreateTeam())"/>
            </RadzenStack>
        }

    </RadzenStack>
}

@code {
    /// <summary>
    /// When true, callers with the <c>team:manage</c> scope can inline-edit a member's display name
    /// (Member.Name) via a pencil icon. When false (default), the Name column is read-only — preserves
    /// the existing behavior for consumers that haven't opted in.
    /// </summary>
    [Parameter] public bool EnableMemberNameEdit { get; set; }

    /// <summary>
    /// Optional callback invoked after a successful inline edit of <see cref="ITeamMember.Name"/>.
    /// Use to refresh derived caches, log additional context, etc.
    /// Tharga.Team handles the persistence itself; this is purely observational.
    /// </summary>
    [Parameter] public EventCallback<MemberNameChangedArgs> OnMemberNameChanged { get; set; }

    /// <summary>When true (and an <see cref="IScopeRegistry"/> is registered), shows the per-member effective-scope (i) tooltip. Default true.</summary>
    [Parameter] public bool ShowScopeTooltip { get; set; } = true;

    /// <summary>When true (and an <see cref="IScopeRegistry"/> is registered), shows the per-member scope-override editor column. Default false.</summary>
    [Parameter] public bool ShowScopeOverrides { get; set; }

    /// <summary>When true (and an <see cref="ITenantRoleRegistry"/> is registered), shows the per-member tenant-role editor column. Default false.</summary>
    [Parameter] public bool ShowRoles { get; set; }

    // --- The teams grid. Deliberately prefixed "Team", because every other parameter on this component
    // --- configures the *members* grid inside a row, and a bare "AllowSorting" would be ambiguous.

    /// <summary>
    /// Whether the team list is drawn as cards or as a grid. Defaults to
    /// <see cref="TeamListLayout.Auto"/>: cards while the list is short, a grid once it is not.
    /// </summary>
    [Parameter] public TeamListLayout TeamLayout { get; set; } = TeamListLayout.Auto;

    /// <summary>Sorting on the team list. Default on.</summary>
    [Parameter] public bool AllowTeamSorting { get; set; } = true;

    /// <summary>
    /// Forces the team-name filter on or off. Null, the default, shows it once there are
    /// <see cref="TeamFilterThreshold"/> teams or more.
    /// </summary>
    [Parameter] public bool? AllowTeamFiltering { get; set; }

    /// <summary>
    /// How many teams there must be before the list offers a filter. Defaults to
    /// <see cref="TeamSelectorGate.DefaultFilterThreshold"/> — the same judgement the selector makes,
    /// because it is the same question about the same collection.
    /// </summary>
    [Parameter] public int TeamFilterThreshold { get; set; } = TeamSelectorGate.DefaultFilterThreshold;

    /// <summary>
    /// Forces paging on or off. Null, the default, pages only when there is more than one page —
    /// a pager under a list that fits is a control that does nothing.
    /// </summary>
    [Parameter] public bool? AllowTeamPaging { get; set; }

    /// <summary>Teams per page. Default 10.</summary>
    [Parameter] public int TeamPageSize { get; set; } = 10;

    /// <summary>Page sizes offered. Defaults to 10 / 25 / 50.</summary>
    [Parameter] public IEnumerable<int> TeamPageSizeOptionsValues { get; set; } = [10, 25, 50];

    /// <summary>
    /// Optional callback invoked when the user activates the built-in "Create new Team" button.
    /// When set, it takes precedence over <see cref="ThargaBlazorOptions.CreateTeamPath"/> and the
    /// built-in create — letting a host launch its own onboarding flow (e.g. a dialog or wizard).
    /// When unset, the button navigates to <c>CreateTeamPath</c> (if configured), otherwise it
    /// performs the built-in <see cref="ITeamLifecycleService.CreateTeamAsync"/>.
    /// </summary>
    [Parameter] public EventCallback CreateTeamRequested { get; set; }

    private string _editingMemberKey;
    private string _editingMemberName;

    private ITeam<TMember>[] _teams;
    /// <summary>
    /// Show a per-member action opening the audit log for that member, scoped to this team. Off by
    /// default — the log is only queryable when audit storage is configured, and the action is hidden
    /// regardless for callers without <c>audit:read</c>.
    /// </summary>
    [Parameter] public bool ShowAuditLogButton { get; set; }

    private IUser[] _users;
    private ITeam _selectedTeam;
    private IUser _user;
    private IReadOnlyList<TenantRoleDefinition> _roleDefinitions = Array.Empty<TenantRoleDefinition>();
    private ITenantRoleService _tenantRoleService;
    private bool _canManage;
    private bool _canManageMembers;
    private bool _hasSystemAuditRead;
    private bool _hasTeamAuditRead;
    private bool _canSeeAllTeams;
    private bool _allowTeamCreation;
    private string _createTeamPath;
    private bool _showConsentToggle;
    private string[] _consentRoles;
    private AccessLevel _consentDefaultLevel;
    private string[] _allScopeNames = Array.Empty<string>();
    private IReadOnlyDictionary<string, string> _scopeDescriptions = new Dictionary<string, string>();
    private IScopeRegistry _scopeRegistry;
    private ITenantRoleRegistry _tenantRoleRegistry;
    private ITenantRoleVisibilityProvider _roleVisibilityProvider;
    private readonly Dictionary<string, IReadOnlyList<TenantRoleDefinition>> _visibleRolesByTeam = new();

    private RadzenDataGrid<ITeam<TMember>> _teamGrid;

    /// <summary>
    /// Whether the selected team's row has been opened for the current set of teams.
    /// </summary>
    /// <remarks>
    /// Latched so the row is expanded once and then left alone. Without it, every re-render would
    /// re-open a row the reader had just collapsed — the grid would refuse to stay shut, which reads as
    /// a broken control rather than as a helpful default. Cleared by <see cref="ReloadTeams"/>, so a
    /// changed selection or a reloaded list opens the right row again.
    /// </remarks>
    private bool _selectedRowExpanded;

    /// <summary>
    /// Opens the selected team's row, so the surface a caller is actually working in is the one already
    /// showing.
    /// </summary>
    /// <remarks>
    /// Done here rather than at load because the grid has to exist before a row can be expanded —
    /// <c>_teamGrid</c> is null until the first render that draws it, and in the cards layout it stays
    /// null for good.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (_selectedRowExpanded || _teamGrid == null || _teams == null || _selectedTeam == null) return;

        var row = _teams.FirstOrDefault(x => x.Key == _selectedTeam.Key);
        if (row == null) return;

        _selectedRowExpanded = true;
        await _teamGrid.ExpandRow(row);
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var claims = authState.User;
        _canManage = claims.HasClaim(TeamClaimTypes.Scope, TeamScopes.Manage);
        _canManageMembers = claims.HasClaim(TeamClaimTypes.Scope, TeamScopes.MemberManage);
        _hasSystemAuditRead = TeamScopeGate.HasSystemScope(claims, AuditScopes.Read);
        _hasTeamAuditRead = claims.HasClaim(TeamClaimTypes.Scope, AuditScopes.Read);
        _canSeeAllTeams = TeamVisibility.CanSeeAllTeams(claims);

        _scopeRegistry = ServiceProvider.GetService<IScopeRegistry>();
        _tenantRoleRegistry = ServiceProvider.GetService<ITenantRoleRegistry>();
        _tenantRoleService = ServiceProvider.GetService<ITenantRoleService>();
        _roleVisibilityProvider = ServiceProvider.GetService<ITenantRoleVisibilityProvider>();

        _allowTeamCreation = BlazorOptions.Value.AllowTeamCreation;
        _createTeamPath = BlazorOptions.Value.CreateTeamPath;
        _showConsentToggle = BlazorOptions.Value.Consent.ShowToggle;
        _consentRoles = BlazorOptions.Value.Consent.Roles ?? [];
        _consentDefaultLevel = BlazorOptions.Value.Consent.AccessLevel;
        if (_tenantRoleRegistry != null)
            _roleDefinitions = _tenantRoleRegistry.All;
        if (_scopeRegistry != null)
        {
            _allScopeNames = _scopeRegistry.All.Select(s => s.Name).ToArray();
            _scopeDescriptions = _scopeRegistry.All.ToDictionary(s => s.Name, s => s.Description);
        }

        _user = await UserService.GetCurrentUserAsync();
        _users = UserDirectoryGate.Resolve(TeamScopeGate.HasSystemScope(claims, SystemUserScopes.Manage)) == UserDirectorySource.FullDirectory
            ? await UserService.GetAsync().ToArrayAsync()
            : [.. await UserService.GetTeamMemberUsersAsync()];

        await ReloadTeams();

        await base.OnInitializedAsync();
    }

    private string GetEffectiveScopesWithOriginText(ITeam<TMember> team, TMember member)
    {
        if (_scopeRegistry == null) return "";

        var roleNames = member.TenantRoles ?? Array.Empty<string>();
        var accessLevelScopes = _scopeRegistry.GetScopesForAccessLevel(member.AccessLevel);
        var codeRoleScopes = _tenantRoleRegistry?.GetScopesForRoles(roleNames)
            ?? (IReadOnlyList<string>)Array.Empty<string>();
        var customRoleScopes = (_tenantRoleService != null ? team.CustomRoles ?? [] : [])
            .Where(r => roleNames.Contains(r.Name))
            .SelectMany(r => r.Scopes ?? []);
        var roleScopes = codeRoleScopes.Concat(customRoleScopes).ToHashSet(StringComparer.Ordinal);
        var overrides = member.ScopeOverrides ?? Array.Empty<string>();

        var allScopes = accessLevelScopes.Concat(roleScopes).Concat(overrides).Distinct();
        var lines = new List<string>();
        foreach (var scope in allScopes.OrderBy(s => s, StringComparer.Ordinal))
        {
            var origin = overrides.Contains(scope) ? "override"
                : roleScopes.Contains(scope) ? "role"
                : "access level";
            lines.Add($"{scope} ({origin})");
        }
        return string.Join("\n", lines);
    }

    private async Task ChangeTenantRoles(ITeam<TMember> team, string userKey, IEnumerable<string> roles)
    {
        var user = _users.FirstOrDefault(x => x.Key == userKey || x.Identity == userKey);
        var lookupKey = user?.Key ?? userKey;
        var member = team.Members.PickOneOrDefault(x => x.Key == lookupKey, Logger, team.Key, lookupKey);
        if (member == null)
        {
            NotifyMemberNotFound();
            return;
        }

        await TeamManagementService.SetMemberTenantRolesAsync(team.Key, member.Key, roles.ToArray());
        await ReloadTeams();
    }

    private async Task ChangeScopeOverrides(ITeam<TMember> team, string userKey, IEnumerable<string> scopes)
    {
        var user = _users.FirstOrDefault(x => x.Key == userKey || x.Identity == userKey);
        var lookupKey = user?.Key ?? userKey;
        var member = team.Members.PickOneOrDefault(x => x.Key == lookupKey, Logger, team.Key, lookupKey);
        if (member == null)
        {
            NotifyMemberNotFound();
            return;
        }

        await TeamManagementService.SetMemberScopeOverridesAsync(team.Key, member.Key, scopes.ToArray());
        await ReloadTeams();
    }

    private async Task CreateTeam()
    {
        switch (CreateTeamActionResolver.Resolve(CreateTeamRequested.HasDelegate, _createTeamPath))
        {
            case CreateTeamAction.Callback:
                await CreateTeamRequested.InvokeAsync();
                return;
            case CreateTeamAction.Navigate:
                NavigationManager.NavigateTo(_createTeamPath);
                return;
            default:
                await TeamLifecycleService.CreateTeamAsync();
                await ReloadTeams();
                return;
        }
    }

    private async Task RenameTeam(ITeam team)
    {
        var result = await DialogService.OpenAsync<TeamDialog<TMember>>(
            $"Rename {team.Name}",
            new Dictionary<string, object> { { "TeamKey", team.Key }, { "Name", team.Name } },
            new DialogOptions { Resizable = true, Draggable = true });

        if (result == true) await ReloadTeams();
    }

    private async Task SetTeamIcon(ITeam<TMember> team)
    {
        var result = await DialogService.OpenAsync<TeamIconDialog>(
            $"Icon — {team.Name}",
            new Dictionary<string, object>
            {
                { nameof(TeamIconDialog.TeamKey), team.Key },
                { nameof(TeamIconDialog.HasIcon), !string.IsNullOrEmpty(team.Icon) }
            },
            new DialogOptions { Width = "480px" });

        if (result is true) await ReloadTeams();
    }

    private async Task AddUser(ITeam<TMember> team)
    {
        var result = await DialogService.OpenAsync<InviteUserDialog>(
            "Invite User",
            new Dictionary<string, object> { { "TeamKey", team.Key }, { "TeamName", team.Name } },
            new DialogOptions { Resizable = true, Draggable = true });

        if (result is InviteUserDialog.InviteResult inviteResult && inviteResult.Success)
        {
            await ReloadTeams();

            var updatedTeam = await TeamManagementService.GetTeamAsync<TMember>(team.Key);
            var invitedMember = updatedTeam?.Members
                .FirstOrDefault(m => m.Invitation != null && m.Name == inviteResult.Name);

            if (invitedMember?.Invitation != null)
            {
                var link = BuildInviteLink(updatedTeam.Key, invitedMember.Invitation.InviteKey);

                var emailSender = ServiceProvider.GetService<ITeamEmailSender>();
                if (emailSender != null && !string.IsNullOrWhiteSpace(inviteResult.Email))
                {
                    try
                    {
                        await emailSender.SendInviteAsync(inviteResult.Email, inviteResult.Name, link, team.Name);
                        NotificationService.Notify(NotificationSeverity.Success,
                            "Invitation sent", $"Email sent to {inviteResult.Email}");
                    }
                    catch (Exception ex)
                    {
                        NotificationService.Notify(NotificationSeverity.Warning,
                            "Email failed", $"Could not send email: {ex.Message}");
                    }
                }

                await Js.InvokeVoidAsync("clipboard.copyText", link);
                NotificationService.Notify(new NotificationMessage
                {
                    Summary = "The invitation link has been copied to the clipboard."
                });
            }
        }
    }

    private async Task RemoveUserFromTeam(ITeam<TMember> team, string userKey)
    {
        var user = _users.FirstOrDefault(x => x.Key == userKey || x.Identity == userKey);
        var lookupKey = user?.Key ?? userKey;
        var member = team.Members.PickOneOrDefault(x => x.Key == lookupKey, Logger, team.Key, lookupKey);
        if (member == null)
        {
            NotifyMemberNotFound();
            return;
        }

        var email = member.Invitation?.EMail ?? user?.EMail;
        var response = await DialogService.Confirm($"User '{email}' will be removed from the team '{team.Name}'.");
        if (response != true) return;

        await TeamManagementService.RemoveMemberAsync(team.Key, member.Key);
        await ReloadTeams();
    }

    private async Task ChangeRole(ITeam<TMember> team, string userKey, AccessLevel accessLevel)
    {
        var user = _users.FirstOrDefault(x => x.Key == userKey || x.Identity == userKey);
        var lookupKey = user?.Key ?? userKey;
        var member = team.Members.PickOneOrDefault(x => x.Key == lookupKey, Logger, team.Key, lookupKey);
        if (member == null)
        {
            NotifyMemberNotFound();
            return;
        }

        await TeamManagementService.SetMemberRoleAsync(team.Key, member.Key, accessLevel);
        await ReloadTeams();
    }

    private void NotifyMemberNotFound()
    {
        NotificationService.Notify(NotificationSeverity.Warning, "Member not found", "The member could not be located. Please reload the page.");
    }

    private void StartMemberNameEdit(TMember member)
    {
        _editingMemberKey = member.Key;
        _editingMemberName = member.Name ?? ResolveDefaultMemberName(member);
    }

    private void CancelMemberNameEdit()
    {
        _editingMemberKey = null;
        _editingMemberName = null;
    }

    private string ResolveDefaultMemberName(TMember member)
    {
        var user = _users.FirstOrDefault(x => x.Key == member.Key);
        return user?.Name ?? TeamServiceBase.ResolveDisplayName(user);
    }

    private async Task SaveMemberName(ITeam<TMember> team, TMember member)
    {
        var oldName = member.Name;

        // Per-team override only — the root IUser.Name belongs to the user's profile page and to user
        // administration, and must not be reachable from a member row. See MemberNamePolicy.
        var newName = MemberNamePolicy.ResolveOverride(_editingMemberName, ResolveDefaultMemberName(member));

        if (newName == oldName)
        {
            CancelMemberNameEdit();
            return;
        }

        await TeamManagementService.SetMemberNameAsync(team.Key, member.Key, newName);
        CancelMemberNameEdit();
        await ReloadTeams();

        if (OnMemberNameChanged.HasDelegate)
        {
            await OnMemberNameChanged.InvokeAsync(new MemberNameChangedArgs(team.Key, member.Key, oldName, newName));
        }
    }

    private async Task ResetMemberName(ITeam<TMember> team, TMember member)
    {
        var oldName = member.Name;
        if (oldName == null)
        {
            CancelMemberNameEdit();
            return;
        }

        await TeamManagementService.SetMemberNameAsync(team.Key, member.Key, null);
        CancelMemberNameEdit();
        await ReloadTeams();

        if (OnMemberNameChanged.HasDelegate)
        {
            await OnMemberNameChanged.InvokeAsync(new MemberNameChangedArgs(team.Key, member.Key, oldName, null));
        }
    }

    private async Task TransferOwnership(ITeam<TMember> team)
    {
        var eligibleMembers = team.Members
            .Where(x => x.Key != _user.Key && x.State == MembershipState.Member)
            .ToArray();

        if (eligibleMembers.Length == 0)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "No eligible members", "There are no other active members to transfer ownership to.");
            return;
        }

        var memberOptions = eligibleMembers.Select(m =>
        {
            var user = _users.FirstOrDefault(u => u.Key == m.Key);
            var display = user?.EMail ?? m.Name ?? m.Key;
            return new { m.Key, Display = display };
        }).ToArray();

        string selectedKey = memberOptions.First().Key;

        var result = await DialogService.OpenAsync("Transfer Ownership", ds =>
            @<RadzenStack Gap="1rem">
                <RadzenText>Select the new owner of team '@team.Name':</RadzenText>
                <RadzenDropDown TValue="string" @bind-Value="selectedKey"
                                Data="@memberOptions"
                                TextProperty="Display"
                                ValueProperty="Key" />
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Right" Gap="0.5rem">
                    <RadzenButton Text="Transfer" ButtonStyle="ButtonStyle.Warning" Click="@(_ => ds.Close(true))" />
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(_ => ds.Close(false))" />
                </RadzenStack>
            </RadzenStack>,
            new DialogOptions { Width = "400px" });

        if (result is not true) return;

        await TeamManagementService.TransferOwnershipAsync(team.Key, selectedKey);
        await ReloadTeams();
        NotificationService.Notify(NotificationSeverity.Success, "Ownership transferred");
    }

    /// <summary>
    /// A team's members and its consent selector — the body of a card, and the detail row of a grid.
    /// </summary>
    /// <remarks>
    /// Defined once and rendered by both layouts. Two presentations of the same thing are only worth
    /// having while the thing itself has one definition; duplicating this would mean a new member column
    /// landing in one shape and not the other, which is worse than having no choice of shape at all.
    /// </remarks>
    private RenderFragment<ITeam<TMember>> TeamDetail => team =>
    @<text>
        <RadzenRow>
            <RadzenColumn>
                @* <RadzenDataGrid Data="@team.Members" Visible="@(HasAccessLevel(team, AccessLevel.Administrator))" TItem="TMember"> *@
                <RadzenDataGrid Data="@team.Members" TItem="TMember" RowRender="@OnMemberRowRender">
                    <Columns>
                        @* <RadzenDataGridColumn Title="Key" Property="@nameof(ITeamMember.Key)" /> *@
                        <RadzenDataGridColumn Title="EMail" SortOrder="SortOrder.Ascending">
                            <Template>
                                @{
                                    var user = _users.FirstOrDefault(x => x.Key == context.Key);
                                    <span style="margin-right: 6px;"><UserAvatar User="user" EMail="@(context.Invitation?.EMail ?? user?.EMail)" Name="@context.Name" Size="32px" /></span>
                                    @(context.Invitation?.EMail ?? user?.EMail)
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Name" Property="@nameof(ITeamMember.Name)">
                            <Template>
                                @{
                                    var canEditThisRow = EnableMemberNameEdit && CanManageMembers(team);
                                }
                                @if (canEditThisRow && !string.IsNullOrEmpty(_editingMemberKey) && _editingMemberKey == context.Key)
                                {
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem"
                                                 Style="min-width: 0; flex-wrap: nowrap;">
                                        <RadzenTextBox Value="@_editingMemberName"
                                                       ValueChanged="@(v => _editingMemberName = v)"
                                                       Style="flex: 1 1 0; min-width: 0;" />
                                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat" Size="ButtonSize.Small"
                                                      Click="@(() => SaveMemberName(team, context))"
                                                      Style="flex: 0 0 auto;" />
                                        @if (!string.IsNullOrEmpty(context.Name))
                                        {
                                            <RadzenButton Icon="restart_alt" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Flat" Size="ButtonSize.Small"
                                                          Click="@(() => ResetMemberName(team, context))"
                                                          title="Clear override (use the global user name)"
                                                          Style="flex: 0 0 auto;" />
                                        }
                                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Size="ButtonSize.Small"
                                                      Click="@CancelMemberNameEdit"
                                                      Style="flex: 0 0 auto;" />
                                    </RadzenStack>
                                }
                                else
                                {
                                    var member = context;
                                    var user = _users.FirstOrDefault(x => x.Key == member.Key);
                                    var displayName = !string.IsNullOrEmpty(member.Name)
                                        ? member.Name
                                        : user?.Name ?? TeamServiceBase.ResolveDisplayName(user);
                                    var hasOverride = !string.IsNullOrEmpty(member.Name)
                                                      && !string.IsNullOrEmpty(user?.Name)
                                                      && member.Name != user.Name;
                                    var tooltip = hasOverride
                                        ? $"Team override. Original name: {user.Name}"
                                        : null;

                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                        <span title="@tooltip" style="@(hasOverride ? "font-style: italic;" : "")">@displayName</span>
                                        @if (canEditThisRow)
                                        {
                                            <RadzenButton Icon="edit" Variant="Variant.Text" Size="ButtonSize.Small"
                                                          Click="@(() => StartMemberNameEdit(member))"
                                                          title="Edit display name" />
                                        }
                                    </RadzenStack>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Access Level" Property="@nameof(ITeamMember.AccessLevel)">
                            <Template>
                                @if (_user.Key == context.Key || context.AccessLevel == AccessLevel.Owner) //Cannot change self or owner.
                                {
                                    <RadzenText>@context.AccessLevel</RadzenText>
                                }
                                else if (CanManageMembers(team))
                                {
                                    // Custom hidden until #76 adds member scope/role editing (see InviteUserDialog).
                                    var accessLevels = Enum.GetValues<AccessLevel>().Where(x => x != AccessLevel.Owner && x != AccessLevel.Custom);
                                    <RadzenDropDown TValue="AccessLevel" Value="@context.AccessLevel" ValueChanged="@(x => ChangeRole(team, context.Key, x))" Data="@accessLevels"/>
                                }
                                else
                                {
                                    <RadzenText>@context.AccessLevel</RadzenText>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Roles" Width="200px" Visible="@(ShowRoles && _tenantRoleRegistry != null)">
                            <Template>
                                @if (CanManageMembers(team) && _user.Key != context.Key && context.AccessLevel != AccessLevel.Owner)
                                {
                                    <RoleEditor Roles="@GetVisibleRoles(team.Key)"
                                                Selected="@(context.TenantRoles ?? Array.Empty<string>())"
                                                SelectedChanged="@(r => ChangeTenantRoles(team, context.Key, r))" />
                                }
                                else
                                {
                                    <RadzenText>@(string.Join(", ", context.TenantRoles ?? Array.Empty<string>()))</RadzenText>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Scope Overrides" Width="200px" Visible="@(ShowScopeOverrides && _scopeRegistry != null)">
                            <Template>
                                @if (CanManageMembers(team) && _user.Key != context.Key && context.AccessLevel != AccessLevel.Owner)
                                {
                                    <ScopeOverrideEditor AllScopes="_allScopeNames"
                                                         Descriptions="_scopeDescriptions"
                                                         InheritedScopes="@_scopeRegistry.GetEffectiveScopes(context.AccessLevel, context.TenantRoles, null)"
                                                         Overrides="@(context.ScopeOverrides ?? Array.Empty<string>())"
                                                         OverridesChanged="@(o => ChangeScopeOverrides(team, context.Key, o))" />
                                }
                                else
                                {
                                    <RadzenText>@(string.Join(", ", context.ScopeOverrides ?? Array.Empty<string>()))</RadzenText>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Scopes" Width="80px" Visible="@(_scopeRegistry != null && ShowScopeTooltip)">
                            <Template>
                                <span title="@GetEffectiveScopesWithOriginText(team, context)">
                                    <RadzenIcon Icon="info" Style="cursor: help;" />
                                </span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Status" Property="@nameof(ITeamMember.State)">
                            <Template>
                                @if (context.State == MembershipState.Invited && context.Invitation != null)
                                {
                                    <span title="@($"Invited {context.Invitation.InviteTime:yyyy-MM-dd HH:mm} UTC")" style="cursor: help;">@context.State</span>
                                }
                                else
                                {
                                    <span>@context.State</span>
                                }
                                @* Shown beside the state, not instead of it. Suspension deliberately
                                   leaves State at Member -- that is what keeps the team in the
                                   member's selector -- so the row has to say both things or it
                                   misdescribes what was done. *@
                                @if (context.SuspendedAt != null)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Warning" Variant="Variant.Flat"
                                                 Text="Suspended" class="rz-ml-2"
                                                 title="@SuspendedMemberTitle(context)" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Last Seen" Property="@nameof(ITeamMember.LastSeen)">
                            <Template>
                                <DateTimeView Date="@context.LastSeen"/>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn>
                            <Template>
                                @{
                                    var memberActions = MemberActions(team, context);
                                }
                                @* Same Text/Icon/style as the split button's primary half, so a
                                   member with one available action does not look like a
                                   different kind of control from the member beside them. *@
                                @if (memberActions.Count == 1)
                                {
                                    <RadzenButton Text="@memberActions[0].Text" Icon="@memberActions[0].Icon"
                                                  ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                  Click="@(() => InvokeMemberActionAsync(memberActions[0].Value, team, context.Key))"/>
                                }
                                else if (memberActions.Count > 1)
                                {
                                    <RadzenSplitButton Text="@memberActions[0].Text" Icon="@memberActions[0].Icon"
                                                       ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                       Click="@(item => OnMemberActionAsync(item, team, context.Key, memberActions[0].Value))">
                                        <ChildContent>
                                            @foreach (var action in memberActions.Skip(1))
                                            {
                                                <RadzenSplitButtonItem Text="@action.Text" Value="@action.Value" Icon="@action.Icon"/>
                                            }
                                        </ChildContent>
                                    </RadzenSplitButton>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenColumn>
        </RadzenRow>
    </text>;

    /// <summary>
    /// What this team grants, and the control to change it. Rendered in the grid's Consent column and in
    /// a card's header.
    /// </summary>
    /// <remarks>
    /// <b>Only where it can be changed.</b> Consent is editable on the selected team alone, so in a list
    /// most rows cannot be edited — and a column of disabled drop-downs is a row of controls that do
    /// nothing. Those rows state the level instead.
    /// <para>
    /// The label is the caller's to ask for: a grid column header already says "Consent", so repeating it
    /// in every cell prints the same word once per row. A card has no header, so there it carries.
    /// </para>
    /// The label sits <b>above</b> the drop-down rather than beside it. Side by side, the label ran
    /// straight into the selected level and the two read as one sentence — "Consent access for Developer,
    /// Administrator" — which states something nobody wrote: that Administrator is a consenting role
    /// rather than the level being granted. Stacking separates the question from the answer.
    /// <para>
    /// The roles are listed in full rather than abbreviated. Naming fewer than actually hold consent
    /// would be a comfortable label that misstates who can reach the team.
    /// </para>
    /// </remarks>
    /// <summary>
    /// Whether the caller belongs to this team and what it grants, side by side.
    /// </summary>
    /// <remarks>
    /// Horizontal, because the two are one thought — "not a member, but full access" is the sentence an
    /// oversight caller is reading. Stacked, they looked like two unrelated properties.
    /// <para>
    /// Membership comes first because it qualifies the level that follows: the caller reads why they can
    /// see the team before reading how much of it they get. Read the other way, the level lands as a plain
    /// statement of their standing and the qualifier arrives too late to change it.
    /// </para>
    /// <para>
    /// Read-only by design, which is what lets it sit in a card's <c>TopMenu</c>: that slot lives inside
    /// the header's click handler, so anything interactive there would toggle the card as well as itself.
    /// </para>
    /// </remarks>
    private RenderFragment ConsentBadges(ITeam<TMember> team) =>
    @<text>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.35rem" Wrap="FlexWrap.Wrap">
            @if (_canSeeAllTeams && !IsMemberOf(team))
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Light" Variant="Variant.Flat" Text="Not a member"
                             title="You are viewing this team through cross-team access, not membership." />
            }
            @if (_canSeeAllTeams || _showConsentToggle)
            {
                <RadzenBadge BadgeStyle="@(Enum.Parse<BadgeStyle>(TeamVisibility.BadgeStyle(ConsentOf(team))))"
                             Variant="Variant.Flat"
                             Text="@TeamVisibility.Label(ConsentOf(team))"
                             title="What this team has consented to grant. Select the team to change it." />
            }
        </RadzenStack>
    </text>;

    /// <summary>
    /// The consent selector, where consent can actually be changed. Renders nothing where it cannot.
    /// </summary>
    private RenderFragment ConsentControl(ITeam<TMember> team, bool showLabel) =>
    @<text>
        @if (_showConsentToggle && CanEditConsent(team))
        {
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.15rem" AlignItems="AlignItems.Start">
                @if (showLabel)
                {
                    <RadzenLabel Text="@ConsentLabel" Style="font-size: 0.85em; opacity: 0.75;" />
                }
                <RadzenDropDown TValue="AccessLevel?"
                                Value="@ConsentOf(team)"
                                Data="@_consentLevels"
                                AllowClear="true"
                                Placeholder="No access"
                                Change="@(async args => await SetConsent(team, (AccessLevel?)args))"
                                Style="width: 100%;" />
            </RadzenStack>
        }
    </text>;

    /// <summary>
    /// The grid's Consent cell: the selector on the row that can be changed, the value stated on the rest.
    /// </summary>
    /// <remarks>
    /// Consent is editable on the selected team alone, so in a list most rows cannot be edited — and a
    /// column of disabled drop-downs is a row of controls that do nothing.
    /// </remarks>
    private RenderFragment ConsentCell(ITeam<TMember> team) =>
    @<text>
        @if (_showConsentToggle && CanEditConsent(team))
        {
            @ConsentControl(team, showLabel: false)
        }
        else
        {
            @ConsentBadges(team)
        }
    </text>;

    /// <summary>
    /// "Consent access for Developer" — the roles a team can consent to, named.
    /// </summary>
    /// <remarks>
    /// Computed once rather than per row: it does not vary by team, and rebuilding it inside a template
    /// that runs per render is work for nothing.
    /// </remarks>
    private string ConsentLabel => $"Consent access for {string.Join(", ", _consentRoles)}";

    /// <summary>The team-level actions, as a button or a split button. Shared by both layouts.</summary>
    private RenderFragment<ITeam<TMember>> TeamActionsFragment => team =>
    @<text>
        @{
            var teamActions = TeamActions(team);
        }
        @if (teamActions.Count == 1)
        {
            <RadzenButton Text="@teamActions[0].Text" Icon="@teamActions[0].Icon" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                          Click="@(() => InvokeTeamActionAsync(teamActions[0].Value, team))" />
        }
        else if (teamActions.Count > 1)
        {
            <RadzenSplitButton Text="@teamActions[0].Text" Icon="@teamActions[0].Icon" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                               Click="@(item => OnTeamActionAsync(item, team, teamActions[0].Value))">
                <ChildContent>
                    @foreach (var action in teamActions.Skip(1))
                    {
                        <RadzenSplitButtonItem Text="@action.Text" Value="@action.Value" Icon="@action.Icon" />
                    }
                </ChildContent>
            </RadzenSplitButton>
        }
    </text>;

    /// <summary>
    /// Marks the selected team's row, replacing what <c>ExpandableCard.Selected</c> did.
    /// </summary>
    /// <remarks>
    /// Class rather than inline style so a host can restyle it, and so it follows the theme. The member
    /// grid marks the signed-in user's own row the same way (<see cref="OnMemberRowRender"/>), so the two
    /// highlights are consistent devices rather than two inventions.
    /// </remarks>
    private void OnTeamRowRender(RowRenderEventArgs<ITeam<TMember>> args)
    {
        if (_selectedTeam?.Key == args.Data?.Key)
        {
            // Marker attribute, styled on the cells -- a background set on the row element is invisible
            // under Radzen's own cell backgrounds. Same device and reason as the current-member row.
            args.Attributes["data-tharga-selected-team"] = "true";
        }
    }

    private async Task DeleteTeam(ITeam<TMember> team)
    {
        var response = await DialogService.Confirm($"Team '{team.Name}' will be deleted.");
        if (response != true) return;

        await TeamManagementService.DeleteTeamAsync(team.Key);

        await ReloadTeams();
    }

    private readonly AccessLevel[] _consentLevels = [AccessLevel.Viewer, AccessLevel.User, AccessLevel.Administrator];

    private async Task SetConsent(ITeam<TMember> team, AccessLevel? level)
    {
        var roles = level.HasValue ? _consentRoles : Array.Empty<string>();
        await TeamManagementService.SetTeamConsentAsync(team.Key, roles, level);
        await ReloadTeams();
    }

    private bool HasAccessLevel(ITeam<TMember> team, AccessLevel accessLevel)
    {
        var member = team.Members.PickOneOrDefault(x => x.Key == _user.Key, Logger, team.Key, _user.Key);
        if (member == null) return false;
        return member.AccessLevel <= accessLevel;
    }

    private void OnMemberRowRender(RowRenderEventArgs<TMember> args)
    {
        if (MemberHighlight.IsCurrentMember(args.Data?.Key, _user?.Key))
        {
            // Marker attribute only — the tint must be applied to the cells (see the <style> block at the
            // top of this component). Radzen's <td> cells carry their own background and would paint over
            // a background set on the <tr> here, so a row-level style is invisible.
            args.Attributes["data-tharga-current-member"] = "true";
        }
    }

    /// <summary>
    /// The caller's own access level on a team, or null when they are not a member of it.
    /// </summary>
    /// <remarks>
    /// Null means "not a member", which is a different statement from any level — an oversight caller
    /// reaching a team by consent has access without membership, and showing them a level here would
    /// claim a membership they do not have. The Consent column says what they actually get.
    /// </remarks>
    private AccessLevel? MyAccessLevel(ITeam<TMember> team)
    {
        var member = team.Members?.FirstOrDefault(x => x.Key == _user?.Key && x.State == MembershipState.Member);
        return member?.AccessLevel;
    }

    private bool IsMemberOf(ITeam<TMember> team)
    {
        return team.Members.Any(x => x.Key == _user.Key && x.State == MembershipState.Member);
    }

    private const string IconAction = "icon";
    private const string RenameAction = "rename";
    private const string InviteAction = "invite";
    private const string TransferAction = "transfer";
    private const string DeleteAction = "delete";
    private const string LeaveAction = "leave";

    private string TeamIconUrl(ITeam<TMember> team)
        => string.IsNullOrEmpty(team.Icon) ? null : IconRoute.Url(team.Icon);

    /// <summary>
    /// The actions available on a team, in priority order — the first is the split button's default
    /// (primary) action, with "Invite user" preferred when available.
    /// </summary>
    private const string CopyInviteAction = "copy-invite";
    private const string RemoveMemberAction = "remove-member";
    private const string MemberAuditAction = "member-audit";
    private const string SuspendMemberAction = "suspend-member";
    private const string RestoreMemberAction = "restore-member";

    /// <summary>
    /// Row actions for one member, in the order they collapse: the first is the primary button, the rest
    /// go in the dropdown. Built as a list rather than three conditional buttons so a member with several
    /// available actions gets one split button instead of a row of icons.
    /// </summary>
    /// <remarks>
    /// Only suspension is confirmed; restoring is the reversible direction, and confirming it teaches
    /// people to click through the dialog that matters.
    /// </remarks>
    private async Task SetMemberSuspendedAsync(ITeam<TMember> team, string memberKey, bool suspended)
    {
        if (suspended)
        {
            var confirmed = await DialogService.Confirm(
                "They keep their membership, access level and history, and still see the team -- but can do nothing in it until access is restored.",
                "Suspend access to this team?");
            if (confirmed != true) return;
        }

        try
        {
            await TeamManagementService.SetMemberSuspendedAsync(team.Key, memberKey, suspended);
            await ReloadTeams();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error,
                suspended ? "Could not suspend access" : "Could not restore access", ex.Message);
        }
    }

    private static string SuspendedMemberTitle(TMember member)
    {
        var when = member.SuspendedAt?.ToString("yyyy-MM-dd HH:mm");
        var who = string.IsNullOrEmpty(member.SuspendedBy) ? null : $" by {member.SuspendedBy}";
        return $"Access suspended {when}{who}. Still a member of the team, with no scopes in it.";
    }

    private List<(string Value, string Text, string Icon)> MemberActions(ITeam<TMember> team, TMember member)
    {
        var actions = new List<(string, string, string)>();
        if (CanManageMembers(team) && member.Invitation != null) actions.Add((CopyInviteAction, "Copy invitation link", "link"));
        if (ShowAuditLogButton && CanReadMemberAudit(team)) actions.Add((MemberAuditAction, "Audit log", "manage_search"));
        if (CanManageMembers(team) && _user.Key != member.Key && member.AccessLevel != AccessLevel.Owner)
        {
            // Suspension needs access to take away, and an invitation that has not been accepted grants
            // none -- the right action there is to withdraw the invitation, which Remove already does.
            // Offering it anyway is how this shipped first, and the service could only report the person
            // as not being in the team at all.
            if (member.State is null or MembershipState.Member)
            {
                // Otherwise the same conditions as Remove, for the same reasons: member:manage, never
                // your own row, never the owner. The service refuses all of them regardless.
                actions.Add(member.SuspendedAt != null
                    ? (RestoreMemberAction, "Restore access", "play_circle")
                    : (SuspendMemberAction, "Suspend access", "block"));
            }
            actions.Add((RemoveMemberAction, "Remove member", "remove"));
        }
        return actions;
    }

    private Task OnMemberActionAsync(RadzenSplitButtonItem item, ITeam<TMember> team, string memberKey, string defaultValue)
        => InvokeMemberActionAsync(item?.Value ?? defaultValue, team, memberKey);

    private async Task InvokeMemberActionAsync(string value, ITeam<TMember> team, string memberKey)
    {
        switch (value)
        {
            case CopyInviteAction: await CopyInvitationLink(team, memberKey); break;
            case MemberAuditAction: await OpenMemberAuditLogAsync(team, memberKey); break;
            case RemoveMemberAction: await RemoveUserFromTeam(team, memberKey); break;
            case SuspendMemberAction: await SetMemberSuspendedAsync(team, memberKey, true); break;
            case RestoreMemberAction: await SetMemberSuspendedAsync(team, memberKey, false); break;
        }
    }

    private List<(string Value, string Text, string Icon)> TeamActions(ITeam<TMember> team)
    {
        var actions = new List<(string, string, string)>();
        if (CanManageMembers(team)) actions.Add((InviteAction, "Invite user", "person_add"));
        if (CanRenameTeam(team))
        {
            actions.Add((IconAction, "Set icon", "image"));
            actions.Add((RenameAction, "Rename", "edit"));
        }
        if (CanTransferOwnership(team)) actions.Add((TransferAction, "Transfer ownership", "swap_horiz"));
        if (CanLeaveTeam(team)) actions.Add((LeaveAction, "Leave", "remove"));
        if (CanDeleteTeam(team)) actions.Add((DeleteAction, "Delete", "delete"));
        return actions;
    }

    private Task OnTeamActionAsync(RadzenSplitButtonItem item, ITeam<TMember> team, string defaultValue)
        => InvokeTeamActionAsync(item?.Value ?? defaultValue, team);

    private async Task InvokeTeamActionAsync(string value, ITeam<TMember> team)
    {
        switch (value)
        {
            case IconAction: await SetTeamIcon(team); break;
            case RenameAction: await RenameTeam(team); break;
            case InviteAction: await AddUser(team); break;
            case TransferAction: await TransferOwnership(team); break;
            case LeaveAction: await RemoveUserFromTeam(team, _user.Key); break;
            case DeleteAction: await DeleteTeam(team); break;
        }
    }

    private bool CanRenameTeam(ITeam<TMember> team)
    {
        return TeamActionGate.CanRename(_canManage, _selectedTeam?.Key, team.Key);
    }

    private bool CanManageMembers(ITeam<TMember> team)
    {
        return TeamActionGate.CanManageMembers(_canManageMembers, _selectedTeam?.Key, team.Key);
    }

    private bool CanReadMemberAudit(ITeam<TMember> team)
    {
        return TeamActionGate.CanReadMemberAudit(_hasSystemAuditRead, _hasTeamAuditRead, _selectedTeam?.Key, team.Key);
    }

    /// <summary>
    /// Opens the audit log for one member, scoped to what they did <i>in this team</i>. Pinning both the
    /// caller and the team is what keeps a team administrator's view inside their own tenant — the same
    /// boundary the <c>audit:read</c> team grant already enforces server-side.
    /// </summary>
    private async Task OpenMemberAuditLogAsync(ITeam<TMember> team, string memberKey)
    {
        var user = _users.FirstOrDefault(x => x.Key == memberKey);
        var identity = user?.EMail ?? user?.Name ?? memberKey;

        // Pinned on the subject rather than the display string — an exact match, where CallerIdentity
        // is a substring match against whichever claim the identity provider happened to emit.
        var pinned = new Tharga.Team.Blazor.Features.Audit.AuditPinnedFilter
        {
            CallerUserIdentity = user?.Identity,
            TeamKey = team.Key
        };

        // Fully qualified deliberately. Razor resolves a component tag by @using or by full name only —
        // it does not walk enclosing namespaces the way C# does, so a partially-qualified tag compiles
        // clean and renders as an unknown HTML element: an empty dialog, no exception, no log.
        await DialogService.OpenAsync($"Audit log — {identity}", _ =>
            @<Tharga.Team.Blazor.Features.Audit.AuditLogView PinnedFilter="@pinned" />,
            new DialogOptions { Width = "90vw", Height = "85vh", Resizable = true, Draggable = true });
    }

    private bool CanDeleteTeam(ITeam<TMember> team)
    {
        return TeamActionGate.CanDelete(_canManage, _selectedTeam?.Key, team.Key, _allowTeamCreation, HasAccessLevel(team, AccessLevel.Owner));
    }

    private bool CanLeaveTeam(ITeam<TMember> team)
    {
        return TeamActionGate.CanLeave(IsMemberOf(team), HasAccessLevel(team, AccessLevel.Owner), _selectedTeam?.Key, team.Key);
    }

    private bool CanTransferOwnership(ITeam<TMember> team)
    {
        return TeamActionGate.CanTransferOwnership(HasAccessLevel(team, AccessLevel.Owner), team.Members.Length > 1, _selectedTeam?.Key, team.Key);
    }

    private bool CanEditConsent(ITeam<TMember> team)
    {
        return TeamActionGate.CanEditConsent(_canManage, _selectedTeam?.Key, team.Key, HasAccessLevel(team, AccessLevel.Administrator));
    }

    private async Task ReloadTeams()
    {
        _teams = null;

        // The list is about to change, so the "already opened" latch no longer refers to anything. A
        // reload after selecting a different team should open that team's row.
        _selectedRowExpanded = false;
        _selectedTeam = await TeamStateService.GetSelectedTeamAsync();
        var teams = _canSeeAllTeams
            ? await TeamOversightService.GetAllTeamsAsync<TMember>().ToArrayAsync()
            : await TeamDirectoryService.GetTeamsAsync<TMember>().ToArrayAsync();
        _teams = teams.OrderBy(x => x.Name).ToArray();
        await BuildVisibleRolesAsync();
        StateHasChanged();
    }

    private AccessLevel? ConsentOf(ITeam<TMember> team)
    {
        return TeamVisibility.Resolve(team.ConsentedRoles, team.ConsentAccessLevel, _consentDefaultLevel);
    }

    private async Task BuildVisibleRolesAsync()
    {
        _visibleRolesByTeam.Clear();
        if (_teams == null) return;

        foreach (var team in _teams)
        {
            var teamRoles = RolesForTeam(team);
            if (teamRoles.Count == 0)
            {
                _visibleRolesByTeam[team.Key] = teamRoles;
                continue;
            }

            if (_roleVisibilityProvider == null)
            {
                _visibleRolesByTeam[team.Key] = teamRoles;
                continue;
            }

            var visible = new List<TenantRoleDefinition>(teamRoles.Count);
            foreach (var role in teamRoles)
            {
                if (await _roleVisibilityProvider.IsRoleVisibleAsync(team.Key, role.Name))
                    visible.Add(role);
            }
            _visibleRolesByTeam[team.Key] = visible;
        }
    }

    // Code-registered roles plus (when dynamic roles are enabled) the team's own custom roles. Code roles
    // win on a name clash. Reads the team's custom roles from the already-loaded team document (no extra fetch).
    private IReadOnlyList<TenantRoleDefinition> RolesForTeam(ITeam<TMember> team)
    {
        if (_tenantRoleService == null || team.CustomRoles is not { Count: > 0 })
            return _roleDefinitions;

        var codeNames = _roleDefinitions.Select(r => r.Name).ToHashSet(StringComparer.Ordinal);
        return _roleDefinitions
            .Concat(team.CustomRoles.Where(r => !codeNames.Contains(r.Name)))
            .ToList();
    }

    private IReadOnlyList<TenantRoleDefinition> GetVisibleRoles(string teamKey)
        => _visibleRolesByTeam.TryGetValue(teamKey, out var roles) ? roles : _roleDefinitions;

    private async Task CopyInvitationLink(ITeam<TMember> team, string userKey)
    {
        var member = team.Members.PickOneOrDefault(x => x.Key == userKey, Logger, team.Key, userKey);
        if (member?.Invitation == null) return;

        var link = BuildInviteLink(team.Key, member.Invitation.InviteKey);

        await Js.InvokeVoidAsync("clipboard.copyText", link);
        NotificationService.Notify(new NotificationMessage
        {
            Summary = "The invitation link has been copied to the clipboard."
        });
    }

    /// <summary>
    /// The link an invitee follows. Used by the invitation email and by "Copy invitation link" alike —
    /// one builder, so <see cref="ThargaBlazorOptions.InvitePath"/> reaches both.
    /// </summary>
    /// <remarks>
    /// The clipboard half is why the option exists rather than leaving hosts to rewrite the link
    /// themselves: an <c>ITeamEmailSender</c> can rewrite what it sends, but nothing can rewrite what an
    /// administrator copies out of this component.
    /// </remarks>
    private string BuildInviteLink(string teamKey, string inviteKey)
    {
        var inviteModel = new InviteModel { TeamKey = teamKey, Code = inviteKey };
        var inviteModelJson = JsonSerializer.Serialize(inviteModel);
        var inviteCode = inviteModelJson.ToBase64();
        var path = InvitePathResolver.Resolve(BlazorOptions.Value.InvitePath);
        return $"{NavigationManager.BaseUri}{path}?{Constants.TeamInviteCode}={inviteCode}";
    }

}
