@namespace Tharga.Team.Blazor.Features.Scopes
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.DependencyInjection
@using Tharga.Team
@using Tharga.Team.Blazor.Features.Team
@using Tharga.Team.Blazor.Framework
@inject IServiceProvider ServiceProvider
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IThargaTextProvider TextProvider

@*
    Interactive scope explorer: pick an access level and roles to see which scopes a member would have.
    Scopes not granted by the current selection are greyed out; the signed-in member's personal scope
    overrides are highlighted. Built dynamically from IScopeRegistry and the roles in force for the selected
    team -- its own custom definitions merged with the code-registered ones -- so it always reflects the live
    configuration. Defaults to the current member's access level, roles and overrides.
*@
@if (_rows.Count == 0 && !ShowSystemSection)
{
    <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat">
        No scopes are configured. Register them via <code>o.ConfigureScopes</code> in Program.cs.
    </RadzenAlert>
}

@if (_rows.Count > 0)
{
    @if (ShowSystemSection)
    {
        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Team scopes</RadzenText>
    }
    <RadzenStack Orientation="Orientation.Horizontal" Gap="1.5rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap" class="rz-mb-3">
        @if (ShowAccessLevelSelector)
        {
            <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                <RadzenLabel Text="Access level" />
                <RadzenSelectBar @bind-Value="_selectedLevel" TValue="AccessLevel?" Change="@(_ => RecomputeGrants())" Size="ButtonSize.Small">
                    <Items>
                        <RadzenSelectBarItem Text="Viewer" Value="AccessLevel.Viewer" />
                        <RadzenSelectBarItem Text="User" Value="AccessLevel.User" />
                        <RadzenSelectBarItem Text="Owner / Administrator" Value="AccessLevel.Administrator" />
                    </Items>
                </RadzenSelectBar>
            </RadzenStack>
        }
        @if (ShowRoles && _allRoleNames.Count > 0)
        {
            <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                <RadzenLabel Text="Roles" />
                <RadzenSelectBar @bind-Value="_selectedRolesValue" TValue="IEnumerable<string>" Multiple="true" Change="@(_ => RecomputeGrants())" Size="ButtonSize.Small">
                    <Items>
                        @foreach (var role in _allRoleNames)
                        {
                            <RadzenSelectBarItem Text="@role" Value="@role" />
                        }
                    </Items>
                </RadzenSelectBar>
            </RadzenStack>
        }
    </RadzenStack>

    <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-2">
        Scopes granted by the selected access level and roles are shown in full; greyed rows are not granted.
        @if (_loadedFromMember)
        {
            <text>Pre-selected to your current membership — <b>Override</b> marks your personal scope overrides.</text>
        }
        @if (_rows.Any(r => r.GrantOnly))
        {
            <text>@_text[ScopeViewText.GrantOnlyLegend]</text>
        }
    </RadzenText>

    <RadzenDataGrid Data="@_rows" TItem="ScopeRow"
                    AllowSorting="@AllowGridSorting"
                    AllowFiltering="@AllowGridFiltering"
                    FilterMode="FilterMode.Simple"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                    RowRender="@OnRowRender">
        <Columns>
            <RadzenDataGridColumn Title="Scope" Property="@nameof(ScopeRow.Name)" Width="260px" SortOrder="SortOrder.Ascending">
                <Template>
                    <code>@context.Name</code>
                    @if (Grant(context.Name).ByOverride)
                    {
                        <RadzenIcon Icon="star" Style="color: var(--rz-warning); margin-left: .35rem; font-size: 1rem; cursor: help;"
                                    title="You have a personal scope override for this scope." />
                    }
                    @if (context.GrantOnly)
                    {
                        <RadzenIcon Icon="lock" Style="color: var(--rz-danger); margin-left: .35rem; font-size: 1rem; cursor: help;"
                                    title="@_text[ScopeViewText.GrantOnlyTooltip]" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="Description" Property="@nameof(ScopeRow.Description)" Visible="@ShowDescription" Filterable="false" />
            <RadzenDataGridColumn Title="Granted by" Sortable="false" Filterable="false">
                <Template>
                    @{ var grant = Grant(context.Name); }
                    @if (!grant.Granted)
                    {
                        <RadzenText TextStyle="TextStyle.Body2">—</RadzenText>
                    }
                    else
                    {
                        @if (grant.ByLevel)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Variant="Variant.Flat" Text="@LevelLabel(_selectedLevel)" class="rz-mr-1 rz-mb-1" />
                        }
                        @foreach (var role in grant.ByRoles)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Variant="Variant.Flat" Text="@role" class="rz-mr-1 rz-mb-1" />
                        }
                        @if (grant.ByOverride)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Warning" Variant="Variant.Flat" Text="Override" class="rz-mr-1 rz-mb-1" />
                        }
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

@if (ShowSystemSection)
{
    <RadzenText TextStyle="TextStyle.H6" class="rz-mt-4 rz-mb-2">System scopes</RadzenText>
    <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-2">
        Global capabilities you currently hold — granted to system API keys and via privileged roles.
    </RadzenText>
    <RadzenDataGrid Data="@_systemScopes" TItem="SystemScopeDefinition"
                    AllowSorting="@AllowGridSorting"
                    AllowFiltering="@AllowGridFiltering"
                    FilterMode="FilterMode.Simple"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
        <Columns>
            <RadzenDataGridColumn Title="Scope" Property="@nameof(SystemScopeDefinition.Name)" Width="260px" SortOrder="SortOrder.Ascending">
                <Template>
                    <code>@context.Name</code>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="Description" Property="@nameof(SystemScopeDefinition.Description)" Visible="@ShowDescription" Filterable="false" />
        </Columns>
    </RadzenDataGrid>
}

@code {
    /// <summary>Show the scope Description column. Default true.</summary>
    [Parameter] public bool ShowDescription { get; set; } = true;

    /// <summary>Show the Roles selector (auto-hidden when no tenant roles are configured). Default true.</summary>
    [Parameter] public bool ShowRoles { get; set; } = true;

    /// <summary>Show the access-level selector. Default true.</summary>
    [Parameter] public bool ShowAccessLevelSelector { get; set; } = true;

    /// <summary>Allow sorting the grid (by scope name). Default true.</summary>
    [Parameter] public bool AllowGridSorting { get; set; } = true;

    /// <summary>Allow a case-insensitive text filter on the grid. Default false.</summary>
    [Parameter] public bool AllowGridFiltering { get; set; } = false;

    /// <summary>
    /// Show a separate table listing the system scopes the current user holds (only when system scopes are
    /// registered). Default true.
    /// </summary>
    [Parameter] public bool ShowSystemScopes { get; set; } = true;

    /// <summary>
    /// The tenant roles to credit, overriding what the component would resolve for the selected team.
    /// </summary>
    /// <remarks>
    /// Mirrors <c>RoleEditor.Roles</c>. Left null — the usual case — the component resolves the team's own
    /// roles itself, merging the team's custom definitions with the code-registered ones. Supply it when the
    /// host composes that list, or to render the page for a team other than the selected one.
    /// </remarks>
    [Parameter] public IReadOnlyList<TenantRoleDefinition> Roles { get; set; }

    private static readonly ScopeGrant NotGranted = new(false, false, Array.Empty<string>(), false);

    private IReadOnlyList<ScopeRow> _rows = Array.Empty<ScopeRow>();
    private IReadOnlyList<string> _allRoleNames = Array.Empty<string>();
    private IReadOnlyList<TenantRoleDefinition> _resolvedRoles = Array.Empty<TenantRoleDefinition>();
    private Dictionary<string, ScopeGrant> _grants = new();
    private IReadOnlyList<SystemScopeDefinition> _systemScopes = Array.Empty<SystemScopeDefinition>();

    // Show the System scopes section only when the user actually holds system scopes.
    private bool ShowSystemSection => ShowSystemScopes && _systemScopes.Count > 0;

    private AccessLevel? _selectedLevel;
    private IEnumerable<string> _selectedRolesValue = Array.Empty<string>();
    private HashSet<string> _overrides = new();
    private bool _loadedFromMember;
    private TextSet _text = TextSet.Empty;

    protected override async Task OnInitializedAsync()
    {
        _text = await TextProvider.ResolveAsync(ScopeViewText.All);

        var scopeRegistry = ServiceProvider.GetService<IScopeRegistry>();
        var roleRegistry = ServiceProvider.GetService<ITenantRoleRegistry>();
        var systemRegistry = ServiceProvider.GetService<ISystemScopeRegistry>();

        // Code-registered roles only, so the grid is not empty on the first synchronous render. The team's
        // own roles need an async per-team read and arrive below, before the member's defaults are applied.
        ApplyRoles(scopeRegistry, roleRegistry?.All);

        RecomputeGrants(); // populate for the initial render before any await

        var principal = await GetCurrentPrincipalAsync();

        // The team's own roles, merged with the code-registered ones. Done here rather than inside
        // ApplyCurrentUserDefaultsAsync because that returns early under an access simulation and is skipped
        // without a principal -- and the role bar and the Roles column have to be right in both cases.
        await ApplyTeamRolesAsync(scopeRegistry);

        // System scopes the current user holds: their Scope claims that are registered system scopes.
        _systemScopes = ScopeReference.UserSystemScopes(
            systemRegistry,
            principal?.Claims.Where(c => c.Type is TeamClaimTypes.Scope or TeamClaimTypes.SystemScope).Select(c => c.Value) ?? Enumerable.Empty<string>());

        if (_rows.Count > 0 && principal != null)
            await ApplyCurrentUserDefaultsAsync(principal);

        RecomputeGrants(); // refine with the loaded defaults
    }

    /// <summary>
    /// Rebuilds the rows and the role bar from <paramref name="roles"/>, or from <see cref="Roles"/> when a
    /// host supplied it.
    /// </summary>
    private void ApplyRoles(IScopeRegistry scopeRegistry, IReadOnlyList<TenantRoleDefinition> roles)
    {
        _resolvedRoles = Roles ?? roles ?? Array.Empty<TenantRoleDefinition>();

        _rows = ScopeReference.BuildForRoles(scopeRegistry, _resolvedRoles);
        _allRoleNames = _resolvedRoles.Select(r => r.Name).ToList();
    }

    /// <summary>
    /// Rebuilds from the selected team's roles. A host-supplied <see cref="Roles"/> wins, and no selected
    /// team leaves the code-registered roles in place.
    /// </summary>
    private async Task ApplyTeamRolesAsync(IScopeRegistry scopeRegistry)
    {
        if (Roles != null) return;

        try
        {
            var team = await (ServiceProvider.GetService<ITeamStateService>()?.GetSelectedTeamAsync() ?? Task.FromResult<ITeam>(null));
            if (string.IsNullOrEmpty(team?.Key)) return;

            ApplyRoles(scopeRegistry, await ResolveTeamRolesAsync(team.Key));
        }
        catch { /* best-effort; the code-registered roles already rendered */ }
    }

    /// <summary>
    /// The roles in force for <paramref name="teamKey"/>: the team's own definitions merged with the
    /// code-registered ones, through the same resolver the member and API-key pickers use.
    /// </summary>
    /// <remarks>
    /// <b><see cref="ITenantRoleVisibilityProvider"/> is deliberately not consulted here</b>, unlike in
    /// <c>TeamComponent</c>'s picker. Its own contract says hiding a role "does not prune existing
    /// assignments and does not affect scope resolution — a member already assigned a hidden role keeps it
    /// and still receives its scopes at runtime". Filtering by it on this page would therefore tell such a
    /// member they lack scopes they hold, which is the exact defect this resolution fixes (Tharga/Team#292).
    /// On a page whose purpose is explaining access, omitting a role that is granting access is the one
    /// thing that cannot be right.
    /// </remarks>
    private async Task<IReadOnlyList<TenantRoleDefinition>> ResolveTeamRolesAsync(string teamKey)
    {
        var registry = ServiceProvider.GetService<ITenantRoleRegistry>();
        var tenantRoleService = ServiceProvider.GetService<ITenantRoleService>();

        return await ApiKeyRolePicker.ResolveAsync(tenantRoleService, registry, teamKey);
    }

    private async Task<ClaimsPrincipal> GetCurrentPrincipalAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            return authState?.User;
        }
        catch { return null; /* no auth context */ }
    }

    // Tenant roles and scope overrides are not in the claims — they live on the member record — so default
    // the selectors from the current member (best-effort; falls back to the AccessLevel claim).
    private async Task ApplyCurrentUserDefaultsAsync(ClaimsPrincipal principal)
    {
        if (principal != null && Enum.TryParse<AccessLevel>(principal.FindFirst(TeamClaimTypes.AccessLevel)?.Value, out var claimLevel))
            _selectedLevel = ScopeReference.ToSelectableLevel(claimLevel);

        // Under an access simulation the claim is the simulated truth and the member record is not: the
        // record still says Owner, because simulation narrows claims and never touches stored data. The
        // lookup below would therefore overwrite the simulated level with the real one, and this page --
        // whose whole job is showing what a given level grants -- would keep reporting Owner/Administrator
        // while everything around it had narrowed. Reported from the sample, 2026-08-03.
        if (Tharga.Team.Blazor.Features.Simulation.AccessSimulationCookie.IsActive(principal)) return;

        try
        {
            var teamState = ServiceProvider.GetService<ITeamStateService>();
            var userService = ServiceProvider.GetService<IUserService>();
            var teamService = ServiceProvider.GetService<ITeamManagementService>();
            if (teamState != null && userService != null && teamService != null && principal != null)
            {
                var team = await teamState.GetSelectedTeamAsync();
                var user = await userService.GetCurrentUserAsync(principal);
                if (!string.IsNullOrEmpty(team?.Key) && !string.IsNullOrEmpty(user?.Key))
                {
                    var member = await teamService.GetTeamMemberAsync(team.Key, user.Key);
                    if (member != null)
                    {
                        _selectedLevel = ScopeReference.ToSelectableLevel(member.AccessLevel);
                        _selectedRolesValue = ScopeReference.PreselectedRoles(member.TenantRoles, _resolvedRoles);
                        _overrides = new HashSet<string>(member.ScopeOverrides ?? Array.Empty<string>());
                        _loadedFromMember = true;
                    }
                }
            }
        }
        catch { /* best-effort; keep the claim-based defaults */ }
    }

    private void RecomputeGrants()
    {
        var roleSet = new HashSet<string>(_selectedRolesValue ?? Enumerable.Empty<string>());
        _grants = _rows.ToDictionary(r => r.Name, r => ScopeReference.Resolve(r, _selectedLevel, roleSet, _overrides));
    }

    private ScopeGrant Grant(string name) => _grants.TryGetValue(name, out var g) ? g : NotGranted;

    private void OnRowRender(RowRenderEventArgs<ScopeRow> args)
    {
        if (!Grant(args.Data.Name).Granted)
            args.Attributes["style"] = "opacity: 0.45;";
    }

    private static string LevelLabel(AccessLevel? level) => level switch
    {
        AccessLevel.Administrator => "Owner / Admin",
        null => "Custom",
        _ => level.Value.ToString(),
    };
}
