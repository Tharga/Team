<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Suppress xUnit1051: these fast in-memory unit tests don't need to thread TestContext.Current.CancellationToken. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="bunit" Version="2.10.3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tharga.Team.Blazor\Tharga.Team.Blazor.csproj" />
    <!-- For the #254 render guard: the real stored team entity, whose ToString the DOM depends on. -->
    <ProjectReference Include="..\Tharga.Team.MongoDB\Tharga.Team.MongoDB.csproj" />
    <!-- For the decorator guard, which has to see every package that ships a decorator. -->
    <ProjectReference Include="..\Tharga.Team.Support\Tharga.Team.Support.csproj" />
    <ProjectReference Include="..\Tharga.Team.Mcp\Tharga.Team.Mcp.csproj" />
    <ProjectReference Include="..\Tharga.Team.Entra\Tharga.Team.Entra.csproj" />
    <ProjectReference Include="..\Tharga.Team.Images\Tharga.Team.Images.csproj" />
  </ItemGroup>
</Project>
