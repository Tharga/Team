<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>Daniel Bohlin</Authors>
    <Company>Thargelion AB</Company>
    <Product>Tharga Team Email</Product>
    <Description>E-mail for Tharga Team — reading over IMAP, sending over SMTP and MIME handling, shared by support cases and any other mailbox a host keeps.</Description>
    <PackageIconUrl>https://thargelion.net/assets/component-team.png</PackageIconUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <DebugType>portable</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSource>true</IncludeSource>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <PropertyGroup>
    <!--
      NU5048: PackageIconUrl is deprecated in favour of an embedded PackageIcon.
      Suppressed deliberately. Tharga packages reference their icon from
      https://thargelion.net/assets/ so all package icons are maintained in one
      place and can be updated without republishing a package.
    -->
    <NoWarn>1701;1702;CS1591;NU5048</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!--
      This package exists to quarantine MailKit. It is the mail stack: IMAP for reading, SMTP for sending,
      and MIME parsing, which is needed regardless because inbound mail is multipart. The BCL has no IMAP
      client, and taking MailKit for reading makes a second SMTP stack pointless. Support cases and an
      organisation's own mailbox both use it; a consumer who wants neither never takes it.
    -->
    <PackageReference Include="MailKit" Version="4.18.1" />
    <!--
      DNS TXT lookups for the DKIM keys that verify an inbound sender; the BCL resolves addresses only. Every
      host on MongoDB already carries it, because the driver takes it for SRV records.
    -->
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <!--
      Parses mail HTML for its plain-text rendering, for where a reply's quoted history begins, and for the images
      an HTML body names. Referenced here rather than taken through the sanitizer's dependency, because the
      transport uses it on its own account and has to keep doing so if it is lifted out.
    -->
    <PackageReference Include="AngleSharp" Version="1.8.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Mail to users protects its unsubscribe links with Data Protection and answers them on an ASP.NET route.
         Private, so it does not flow to a consumer taking this package for the transport alone. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tharga.Team.Service\Tharga.Team.Service.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Tharga.Team.Support" />
    <InternalsVisibleTo Include="Tharga.Team.Support.Tests" />
    <InternalsVisibleTo Include="Tharga.Team.Email.Tests" />
  </ItemGroup>
</Project>
