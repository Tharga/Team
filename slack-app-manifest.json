{
  "display_information": {
    "name": "Tharga Support",
    "description": "Support cases and notifications from your application.",
    "background_color": "#2c3e50"
  },
  "features": {
    "bot_user": {
      "display_name": "Tharga Support",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "users:read",
        "channels:read",
        "groups:read"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": false
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
