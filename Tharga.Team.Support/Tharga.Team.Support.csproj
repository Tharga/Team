<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>Daniel Bohlin</Authors>
    <Company>Thargelion AB</Company>
    <Product>Tharga Team Support</Product>
    <Description>Support and notifications for Tharga Team — route audited events to Slack channels, with the message shaped per event.</Description>
    <PackageIconUrl>https://thargelion.net/assets/component-team.png</PackageIconUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <DebugType>portable</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSource>true</IncludeSource>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <PropertyGroup>
    <!--
      NU5048: PackageIconUrl is deprecated in favour of an embedded PackageIcon.
      Suppressed deliberately. Tharga packages reference their icon from
      https://thargelion.net/assets/ so all package icons are maintained in one
      place and can be updated without republishing a package.
    -->
    <NoWarn>1701;1702;CS1591;NU5048</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!--
      This package exists to quarantine dependencies out of Tharga.Team.Service, which every consumer
      installs. MailKit is the first one to arrive, and the reason the quarantine was set up in advance.
      It is the mail stack for the email support channel: IMAP for reading, SMTP for sending, and MIME
      parsing, which is needed regardless because inbound mail is multipart. The BCL has no IMAP client,
      and taking MailKit for reading makes a second SMTP stack pointless.

      Slack still needs no third-party package of its own — it is an HTTPS endpoint that takes JSON, so
      IHttpClientFactory covers it.
    -->
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <!-- The inbound Slack endpoint is an ASP.NET route. Private, so it does not flow to consumers that
         only reference this package for the notification sink. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- References the service; nothing references this back, so no consumer acquires it by accident. -->
    <ProjectReference Include="..\Tharga.Team.Service\Tharga.Team.Service.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Tharga.Team.Support.Tests" />
  </ItemGroup>
</Project>
